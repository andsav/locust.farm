+/// Review probe (real nodes): one node fetches the same multi-chunk object
+/// from two peers in two concurrent exchanges whose chunks interleave.
+#[test]
+fn review_concurrent_transfers_of_one_object_from_two_peers() {
+    use crate::node::requests::content::{BlobRecord, blob_write};
+    use locust_proto::limits::BLOB_CHUNK_BYTES;
+    use locust_proto::store::Commit;
+    use locust_proto::sync::SyncMessage;
+    let mut peers = [Peer::new(1), Peer::new(2), Peer::new(3)];
+    let goal = found(&mut peers);
+    let plain: Vec<u8> = (0..3 * BLOB_CHUNK_BYTES + 17).map(|n| (n % 251) as u8).collect();
+    let Response::BlobStored { hash } = peers[0].call(Request::BlobPut {
+        goal,
+        bytes: plain.clone(),
+    }) else {
+        panic!("put");
+    };
+    let want = |peer: &mut Peer| {
+        peer.store
+            .commit(&Commit {
+                local: vec![blob_write(
+                    &goal,
+                    &hash,
+                    &BlobRecord {
+                        wanted: true,
+                        withdrawn: false,
+                    },
+                )],
+                ..Commit::default()
+            })
+            .unwrap();
+        peer.restart();
+    };
+    want(&mut peers[2]);
+    peers[1].online = false;
+    reconcile(&mut peers, 40_000);
+    assert!(peers[2].store.blob_len(&hash).unwrap().is_some());
+    peers[1].online = true;
+    want(&mut peers[1]);
+    let sent = reconcile(&mut peers, 80_000);
+    let requests = sent
+        .iter()
+        .filter(|f| matches!(f, SyncMessage::BlobRequest { hash: h, .. } if *h == hash))
+        .count();
+    let chunks = sent
+        .iter()
+        .filter(|f| matches!(f, SyncMessage::BlobChunk { hash: h, .. } if *h == hash))
+        .count();
+    eprintln!(
+        "requests {requests}, chunks {chunks}, held {:?}, staged {}",
+        peers[1].store.blob_len(&hash).unwrap(),
+        peers[1].store.staged_len(&hash).unwrap()
+    );
+    let Response::Blob { bytes } = peers[1].call(Request::BlobGet { goal, hash }) else {
+        panic!("get");
+    };
+    assert_eq!(bytes, plain);
+    assert_eq!(peers[1].store.staged_len(&hash).unwrap(), 0);
+}
