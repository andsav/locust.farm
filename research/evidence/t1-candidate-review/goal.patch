+//! Review probe: seeded permutation harness over generated event sets.
+#![allow(dead_code, clippy::all)]
+
+use std::collections::BTreeMap;
+
+use super::fold;
+use super::{Goal, Halt, Next, Standing, State};
+use locust_proto::PROTOCOL_VERSION;
+use locust_proto::crypto::Keypair;
+use locust_proto::event::{AuthorPoint, Body, CancelOutcome, Doc, Event, Genesis, Header, PayloadRef};
+use locust_proto::id::{BlobHash, EndpointId, EventId, GoalId, PublicKey};
+use locust_proto::seal;
+use locust_proto::store::{Commit, MemStore, Store};
+use locust_proto::sync::AuthorFrontier;
+use locust_proto::testkit::keypair;
+
+pub struct Rng(pub u64);
+impl Rng {
+    pub fn next(&mut self) -> u64 {
+        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);
+        let mut z = self.0;
+        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+        z ^ (z >> 31)
+    }
+    pub fn below(&mut self, n: usize) -> usize {
+        (self.next() % n as u64) as usize
+    }
+    pub fn chance(&mut self, pct: u64) -> bool {
+        self.next() % 100 < pct
+    }
+    pub fn pick<T: Clone>(&mut self, items: &[T]) -> Option<T> {
+        if items.is_empty() {
+            None
+        } else {
+            Some(items[self.below(items.len())].clone())
+        }
+    }
+    pub fn shuffle<T>(&mut self, items: &mut [T]) {
+        for i in (1..items.len()).rev() {
+            let j = self.below(i + 1);
+            items.swap(i, j);
+        }
+    }
+}
+
+pub struct Writer {
+    pub key: Keypair,
+    pub seq: u64,
+    pub prev: Option<EventId>,
+    pub own: Vec<Event>,
+}
+
+impl Writer {
+    pub fn new(n: u8) -> Self {
+        Self {
+            key: keypair(n),
+            seq: 0,
+            prev: None,
+            own: Vec::new(),
+        }
+    }
+    pub fn public(&self) -> PublicKey {
+        self.key.public()
+    }
+    #[allow(clippy::too_many_arguments)]
+    pub fn sign(
+        &self,
+        goal: GoalId,
+        seq: u64,
+        prev: Option<EventId>,
+        anchor: Option<EventId>,
+        body: Body,
+        payload: Option<PayloadRef>,
+        at_ms: u64,
+    ) -> Event {
+        let header = Header {
+            version: PROTOCOL_VERSION,
+            goal,
+            author: self.key.public(),
+            seq,
+            prev,
+            anchor,
+            parents: Vec::new(),
+            at_ms,
+            payload,
+            body,
+        };
+        Event::sign(header, &self.key).expect("valid header")
+    }
+    pub fn emit(
+        &mut self,
+        goal: GoalId,
+        anchor: Option<EventId>,
+        body: Body,
+        payload: Option<PayloadRef>,
+    ) -> Event {
+        let event = self.sign(goal, self.seq, self.prev, anchor, body, payload, 1_000 + self.seq);
+        self.seq += 1;
+        self.prev = Some(event.id());
+        self.own.push(event.clone());
+        event
+    }
+    /// Re-signs one earlier event with another clock: a second event at its
+    /// position. With `switch` the author continues on the new branch.
+    pub fn fork(&mut self, rng: &mut Rng, switch: bool) -> Option<Event> {
+        let victim = rng.pick(&self.own)?;
+        let mut header = victim.header().clone();
+        header.at_ms += 10_000 + rng.below(1000) as u64;
+        let event = Event::sign(header, &self.key).expect("valid header");
+        if switch {
+            self.seq = event.header().seq + 1;
+            self.prev = Some(event.id());
+        }
+        self.own.push(event.clone());
+        Some(event)
+    }
+}
+
+pub fn payload(n: u8, epoch: u32) -> PayloadRef {
+    PayloadRef {
+        hash: BlobHash([n; 32]),
+        len: seal::OVERHEAD_BYTES as u32 + u32::from(n),
+        key_epoch: epoch,
+    }
+}
+
+#[derive(Clone, Copy, Default)]
+pub struct Flags {
+    pub coordinator_fork: bool,
+    pub broken_chain: bool,
+    pub member_fork: bool,
+    pub prev_mismatch: bool,
+    pub garbage_anchor: bool,
+    pub removals: bool,
+    pub stall: bool,
+}
+
+pub struct World {
+    pub rng: Rng,
+    pub goal: GoalId,
+    pub coordinator: Writer,
+    pub members: Vec<Writer>,
+    pub oracle: Goal,
+    pub events: Vec<Event>,
+    pub decisions: Vec<EventId>,
+    pub chain_tip: EventId,
+    pub ids: Vec<EventId>,
+    pub flags: Flags,
+    pub log: Vec<String>,
+    pub late: bool,
+}
+
+impl World {
+    pub fn new(seed: u64, flags: Flags, members: usize) -> Self {
+        let mut rng = Rng(seed);
+        let mut coordinator = Writer::new(1);
+        let genesis = Genesis {
+            owner: coordinator.public(),
+            coordinator: coordinator.public(),
+            salt: [(seed & 0xff) as u8; 16],
+        };
+        let goal = genesis.goal_id();
+        let first = coordinator.emit(goal, None, Body::Genesis(genesis), rng.chance(50).then(|| payload(1, 0)));
+        let mut world = Self {
+            rng,
+            goal,
+            coordinator,
+            members: (0..members).map(|n| Writer::new(2 + n as u8)).collect(),
+            oracle: Goal::new(goal),
+            events: Vec::new(),
+            decisions: Vec::new(),
+            chain_tip: first.id(),
+            ids: Vec::new(),
+            flags,
+            log: Vec::new(),
+            late: false,
+        };
+        world.decisions.push(first.id());
+        world.push(first);
+        // The coordinator admits itself, as the daemon does.
+        let me = world.coordinator.public();
+        world.decide(Body::MemberAdmitted {
+            member: me,
+            endpoint: EndpointId([1; 32]),
+        });
+        world
+    }
+
+    fn push(&mut self, event: Event) {
+        self.oracle.apply(std::slice::from_ref(&event));
+        self.ids.push(event.id());
+        self.log.push(format!(
+            "{:02} a{} s{} {} -> {:?}",
+            self.events.len(),
+            event.header().author.0[0],
+            event.header().seq,
+            event.header().body.kind(),
+            self.oracle.standing(&event.id())
+        ));
+        self.events.push(event);
+    }
+
+    fn epoch(&self) -> u32 {
+        self.oracle.state().epoch
+    }
+
+    fn maybe_payload(&mut self, right: u32) -> Option<PayloadRef> {
+        let roll = self.rng.below(100);
+        let n = 1 + self.rng.below(40) as u8;
+        if roll < 55 {
+            None
+        } else if roll < 97 {
+            Some(payload(n, right))
+        } else {
+            let wrong = if self.rng.chance(50) { right + 1 } else { right.saturating_sub(1) };
+            Some(payload(n, wrong))
+        }
+    }
+
+    fn decide(&mut self, body: Body) -> Event {
+        let removal = matches!(body, Body::MemberRemoved { .. });
+        let mut anchor = self.chain_tip;
+        if self.flags.broken_chain && self.late && self.rng.chance(6) {
+            anchor = self.rng.pick(&self.decisions).unwrap();
+        }
+        let right = self.epoch() + u32::from(removal);
+        let payload = self.maybe_payload(right);
+        let event = self.coordinator.emit(self.goal, Some(anchor), body, payload);
+        self.decisions.push(event.id());
+        self.chain_tip = event.id();
+        self.push(event.clone());
+        event
+    }
+
+    fn anchor(&mut self) -> EventId {
+        let roll = self.rng.below(100);
+        let head = self.oracle.state().head.unwrap_or(self.decisions[0]);
+        if roll < 80 {
+            head
+        } else if roll < 86 {
+            self.chain_tip
+        } else if roll < 97 || !self.flags.garbage_anchor {
+            let from = self.decisions.len().saturating_sub(1 + self.rng.below(6));
+            self.decisions[from]
+        } else if roll < 99 {
+            self.rng.pick(&self.ids).unwrap()
+        } else {
+            EventId([self.rng.below(250) as u8; 32])
+        }
+    }
+
+    fn any_id(&mut self) -> EventId {
+        if !self.flags.stall || self.rng.chance(85) {
+            self.rng.pick(&self.ids).unwrap()
+        } else {
+            EventId([self.rng.below(250) as u8; 32])
+        }
+    }
+
+    fn any_key(&mut self) -> PublicKey {
+        let n = self.rng.below(self.members.len() + 1);
+        if n == 0 {
+            self.coordinator.public()
+        } else {
+            self.members[n - 1].public()
+        }
+    }
+
+    fn contribute(&mut self, who: usize, anchor: EventId, body: Body) -> Event {
+        let right = self.oracle.epoch_of(&anchor).unwrap_or(self.epoch());
+        let payload = self.maybe_payload(right);
+        let goal = self.goal;
+        let writer = if who == 0 {
+            &mut self.coordinator
+        } else {
+            &mut self.members[who - 1]
+        };
+        let event = writer.emit(goal, Some(anchor), body, payload);
+        self.push(event.clone());
+        event
+    }
+
+    fn writer_key(&self, who: usize) -> PublicKey {
+        if who == 0 {
+            self.coordinator.public()
+        } else {
+            self.members[who - 1].public()
+        }
+    }
+
+    /// Takes the right next step of one open task.
+    fn drive(&mut self) -> bool {
+        use super::TaskState as T;
+        let state = self.oracle.state().clone();
+        let open: Vec<super::Task> = state
+            .tasks
+            .iter()
+            .filter(|task| task.accepted.is_none())
+            .cloned()
+            .collect();
+        let Some(task) = self.rng.pick(&open) else {
+            return false;
+        };
+        let head = self.oracle.state().head.unwrap_or(self.decisions[0]);
+        let who_of = |world: &Self, key: PublicKey| {
+            (0..=world.members.len()).find(|who| world.writer_key(*who) == key)
+        };
+        match task.state {
+            T::Proposed | T::Declined | T::Failed | T::Rejected | T::Cancelled(_) => {
+                let members: Vec<PublicKey> = state.members.keys().copied().collect();
+                let Some(assignee) = self.rng.pick(&members) else {
+                    return false;
+                };
+                self.decide(Body::TaskAssigned {
+                    task: task.id,
+                    assignee,
+                    attempt: task.attempt + 1,
+                });
+            }
+            T::Assigned => {
+                let (Some(assignment), Some(who)) =
+                    (task.assignment, task.assignee.and_then(|key| who_of(self, key)))
+                else {
+                    return false;
+                };
+                self.contribute(who, head, Body::AssignmentAccepted { assignment });
+            }
+            T::Taken => {
+                let (Some(assignment), Some(who)) =
+                    (task.assignment, task.assignee.and_then(|key| who_of(self, key)))
+                else {
+                    return false;
+                };
+                let base = state.accepted_head();
+                self.contribute(
+                    who,
+                    head,
+                    Body::ResultSubmitted {
+                        assignment,
+                        base,
+                        patch: None,
+                        artifacts: vec![],
+                    },
+                );
+            }
+            T::Submitted => {
+                let Some(result) = task.result else {
+                    return false;
+                };
+                let head = self
+                    .rng
+                    .chance(70)
+                    .then(|| BlobHash([100 + self.rng.below(50) as u8; 32]));
+                self.decide(Body::ResultAccepted { result, head });
+            }
+            T::CancelRequested => {
+                let (Some(cancel), Some(who)) =
+                    (task.cancel, task.assignee.and_then(|key| who_of(self, key)))
+                else {
+                    return false;
+                };
+                self.contribute(
+                    who,
+                    head,
+                    Body::CancelAcknowledged {
+                        cancel,
+                        outcome: CancelOutcome::Stopped,
+                    },
+                );
+            }
+            T::Accepted => return false,
+        }
+        true
+    }
+
+    pub fn step(&mut self) {
+        if self.rng.chance(30) && self.drive() {
+            return;
+        }
+        let roll = self.rng.below(100);
+        let state = self.oracle.state().clone();
+        let mut who = if self.rng.chance(15) { 0 } else { 1 + self.rng.below(self.members.len()) };
+        if self.rng.chance(85) {
+            let current: Vec<usize> = (0..=self.members.len())
+                .filter(|who| state.is_member(&self.writer_key(*who)))
+                .collect();
+            who = self.rng.pick(&current).unwrap_or(who);
+        }
+        let me = self.writer_key(who);
+        match roll {
+            // Admission.
+            0..=7 => {
+                let member = self.any_key();
+                let endpoint = EndpointId([2 + self.rng.below(4) as u8; 32]);
+                self.decide(Body::MemberAdmitted { member, endpoint });
+            }
+            // Removal.
+            8..=11 if self.flags.removals => {
+                let members: Vec<PublicKey> = state.members.keys().copied().collect();
+                let member = if self.rng.chance(85) {
+                    self.rng.pick(&members).unwrap_or(me)
+                } else {
+                    self.any_key()
+                };
+                let points = self.oracle.points(&member).to_vec();
+                let last_accepted = match self.rng.below(6) {
+                    0 => None,
+                    1 => points.last().copied(),
+                    2 => self.rng.pick(&points),
+                    3 => self.rng.pick(&points).map(|point| AuthorPoint {
+                        seq: point.seq,
+                        id: EventId([7; 32]),
+                    }),
+                    _ => points
+                        .iter()
+                        .filter(|point| {
+                            self.oracle
+                                .standing(&point.id)
+                                .is_some_and(|standing| standing.is_effective())
+                        })
+                        .max_by_key(|point| point.seq)
+                        .copied(),
+                };
+                self.decide(Body::MemberRemoved { member, last_accepted });
+            }
+            // Assignment.
+            12..=23 => {
+                let task = if self.rng.chance(88) {
+                    self.rng.pick(&state.tasks).map(|task| task.id)
+                } else {
+                    None
+                };
+                let task_id = task.unwrap_or_else(|| self.any_id());
+                let attempt = match state.task(&task_id) {
+                    Some(task) if self.rng.chance(88) => task.attempt + 1,
+                    _ => self.rng.below(4) as u32,
+                };
+                let members: Vec<PublicKey> = state.members.keys().copied().collect();
+                let assignee = if self.rng.chance(88) {
+                    self.rng.pick(&members).unwrap_or(me)
+                } else {
+                    self.any_key()
+                };
+                self.decide(Body::TaskAssigned {
+                    task: task_id,
+                    assignee,
+                    attempt,
+                });
+            }
+            // Cancellation request.
+            24..=27 => {
+                let assignment = match self.rng.pick(&state.assignments) {
+                    Some(assignment) if self.rng.chance(90) => assignment.id,
+                    _ => self.any_id(),
+                };
+                self.decide(Body::CancelRequested { assignment });
+            }
+            // Accept or reject a result.
+            28..=37 => {
+                let latest: Vec<EventId> = state.tasks.iter().filter_map(|task| task.result).collect();
+                let result = if self.rng.chance(70) {
+                    self.rng.pick(&latest)
+                } else if self.rng.chance(70) {
+                    self.rng.pick(&state.results).map(|result| result.id)
+                } else {
+                    None
+                };
+                let result = result.unwrap_or_else(|| self.any_id());
+                if self.rng.chance(75) {
+                    let head = self
+                        .rng
+                        .chance(60)
+                        .then(|| BlobHash([100 + self.rng.below(50) as u8; 32]));
+                    self.decide(Body::ResultAccepted { result, head });
+                } else {
+                    self.decide(Body::ResultRejected { result });
+                }
+            }
+            // Accept a revision.
+            38..=40 => {
+                let revisions: Vec<EventId> = state
+                    .documents
+                    .values()
+                    .flat_map(|document| document.revisions.iter().map(|revision| revision.id))
+                    .collect();
+                let revision = match self.rng.pick(&revisions) {
+                    Some(revision) if self.rng.chance(90) => revision,
+                    _ => self.any_id(),
+                };
+                self.decide(Body::RevisionAccepted { revision });
+            }
+            // Task proposal.
+            41..=50 => {
+                let anchor = self.anchor();
+                let mut depends_on = Vec::new();
+                for _ in 0..self.rng.below(3) {
+                    depends_on.push(self.any_id());
+                }
+                let max_attempts = self.rng.chance(30).then(|| 1 + self.rng.below(2) as u32);
+                self.contribute(
+                    who,
+                    anchor,
+                    Body::TaskProposed {
+                        input: None,
+                        depends_on,
+                        deadline_ms: None,
+                        max_attempts,
+                    },
+                );
+            }
+            // Reports on an assignment.
+            51..=74 => {
+                let mine: Vec<(EventId, PublicKey)> = state
+                    .assignments
+                    .iter()
+                    .map(|assignment| (assignment.id, assignment.assignee))
+                    .collect();
+                let current: Vec<(EventId, PublicKey)> = state
+                    .tasks
+                    .iter()
+                    .filter_map(|task| Some((task.assignment?, task.assignee?)))
+                    .collect();
+                let chosen = if self.rng.chance(70) {
+                    self.rng.pick(&current)
+                } else {
+                    self.rng.pick(&mine)
+                };
+                let (assignment, who) = match chosen {
+                    Some((assignment, assignee)) if self.rng.chance(92) => {
+                        let who = (0..=self.members.len())
+                            .find(|who| self.writer_key(*who) == assignee)
+                            .unwrap_or(who);
+                        (assignment, who)
+                    }
+                    Some((assignment, _)) => (assignment, who),
+                    None => (self.any_id(), who),
+                };
+                let anchor = if self.rng.chance(20) && self.decisions.contains(&assignment) {
+                    assignment
+                } else {
+                    self.anchor()
+                };
+                let task_state = state
+                    .assignment(&assignment)
+                    .and_then(|assignment| state.task(&assignment.task))
+                    .map(|task| task.state);
+                let plausible = self.rng.chance(75);
+                let body = match (task_state, plausible) {
+                    (Some(super::TaskState::Assigned), true) => {
+                        if self.rng.chance(85) {
+                            Body::AssignmentAccepted { assignment }
+                        } else {
+                            Body::AssignmentDeclined { assignment }
+                        }
+                    }
+                    (Some(super::TaskState::Taken), true) => match self.rng.below(10) {
+                        0..=1 => Body::Progress { assignment },
+                        2 => Body::AttemptFailed { assignment },
+                        _ => Body::ResultSubmitted {
+                            assignment,
+                            base: if self.rng.chance(60) {
+                                state.accepted_head()
+                            } else {
+                                self.rng.chance(50).then(|| BlobHash([100 + self.rng.below(50) as u8; 32]))
+                            },
+                            patch: None,
+                            artifacts: vec![],
+                        },
+                    },
+                    _ => match self.rng.below(5) {
+                        0 => Body::AssignmentAccepted { assignment },
+                        1 => Body::AssignmentDeclined { assignment },
+                        2 => Body::Progress { assignment },
+                        3 => Body::AttemptFailed { assignment },
+                        _ => Body::ResultSubmitted {
+                            assignment,
+                            base: state.accepted_head(),
+                            patch: None,
+                            artifacts: vec![],
+                        },
+                    },
+                };
+                self.contribute(who, anchor, body);
+            }
+            // Cancellation acknowledgement.
+            75..=78 => {
+                let cancels: Vec<(EventId, PublicKey)> = state
+                    .assignments
+                    .iter()
+                    .filter_map(|assignment| Some((assignment.cancel?.request, assignment.assignee)))
+                    .collect();
+                let (cancel, who) = match self.rng.pick(&cancels) {
+                    Some((cancel, assignee)) if self.rng.chance(90) => {
+                        let who = (0..=self.members.len())
+                            .find(|who| self.writer_key(*who) == assignee)
+                            .unwrap_or(who);
+                        (cancel, who)
+                    }
+                    _ => (self.any_id(), who),
+                };
+                let outcome = match self.rng.below(3) {
+                    0 => CancelOutcome::Stopped,
+                    1 => CancelOutcome::Completed,
+                    _ => CancelOutcome::Uncertain,
+                };
+                let anchor = self.anchor();
+                self.contribute(who, anchor, Body::CancelAcknowledged { cancel, outcome });
+            }
+            // Notes.
+            79..=84 => {
+                let notes: Vec<EventId> = state.notes.iter().map(|note| note.id).collect();
+                let about = self.rng.chance(50).then(|| self.any_id());
+                let supersedes = if self.rng.chance(50) { self.rng.pick(&notes) } else { None };
+                let anchor = self.anchor();
+                self.contribute(who, anchor, Body::Note { about, supersedes });
+            }
+            // Document revisions.
+            85..=89 => {
+                let doc = if self.rng.chance(60) { Doc::Plan } else { Doc::Summary };
+                let accepted = state.document(doc).and_then(|document| document.accepted);
+                let base = if self.rng.chance(75) {
+                    accepted
+                } else {
+                    self.rng.chance(50).then(|| self.any_id())
+                };
+                let anchor = self.anchor();
+                self.contribute(who, anchor, Body::Revision { doc, base });
+            }
+            // Leave request.
+            90..=91 => {
+                let anchor = self.anchor();
+                self.contribute(who, anchor, Body::LeaveRequested);
+            }
+            // A decision body signed by someone else.
+            92 if who != 0 || (self.flags.broken_chain && self.late) => {
+                let anchor = self.anchor();
+                let endpoint = EndpointId([9; 32]);
+                self.contribute(who, anchor, Body::MemberAdmitted { member: me, endpoint });
+            }
+            // A member forks its log.
+            93..=94 if self.flags.member_fork => {
+                let switch = self.rng.chance(50);
+                let who = 1 + self.rng.below(self.members.len());
+                let mut rng = Rng(self.rng.next());
+                if let Some(event) = self.members[who - 1].fork(&mut rng, switch) {
+                    self.push(event);
+                }
+            }
+            // The coordinator forks its log.
+            95 if self.flags.coordinator_fork && self.late && self.rng.chance(60) => {
+                let switch = self.rng.chance(50);
+                let mut rng = Rng(self.rng.next());
+                if let Some(event) = self.coordinator.fork(&mut rng, switch) {
+                    if switch && event.header().body.is_decision() {
+                        self.chain_tip = event.id();
+                        self.decisions.push(event.id());
+                    }
+                    self.push(event);
+                }
+            }
+            // An event whose `prev` names something else.
+            96 if self.flags.prev_mismatch && self.rng.chance(50) => {
+                let who = 1 + self.rng.below(self.members.len());
+                let anchor = self.anchor();
+                let goal = self.goal;
+                let writer = &mut self.members[who - 1];
+                if writer.seq > 0 {
+                    let event = writer.sign(
+                        goal,
+                        writer.seq,
+                        Some(EventId([3; 32])),
+                        Some(anchor),
+                        Body::Note {
+                            about: None,
+                            supersedes: None,
+                        },
+                        None,
+                        77,
+                    );
+                    writer.seq += 1;
+                    writer.prev = Some(event.id());
+                    writer.own.push(event.clone());
+                    self.push(event);
+                }
+            }
+            _ => {
+                let anchor = self.anchor();
+                self.contribute(
+                    who,
+                    anchor,
+                    Body::Note {
+                        about: None,
+                        supersedes: None,
+                    },
+                );
+            }
+        }
+    }
+}
