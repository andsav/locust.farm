+/// Removal with the cutoff the node computes (the member's highest effective
+/// point) leaves every earlier decision as it was; backdated work stays out
+/// across a readmission.
+#[test]
+fn probe_removal_with_node_cutoff_is_not_retroactive() {
+    use locust_proto::event::AuthorPoint;
+    let mut m = Author::new(2);
+    let mut n = Author::new(3);
+    let mut c = Author::new(1);
+    let (genesis, own) = c.found_goal(EndpointId([1; 32]));
+    let mut flow = Flow { goal: genesis.header().goal, c, head: own.id(), events: vec![genesis, own] };
+    flow.decide(Body::MemberAdmitted { member: m.key.public(), endpoint: EndpointId([2; 32]) });
+    let old_anchor = flow.decide(Body::MemberAdmitted { member: n.key.public(), endpoint: EndpointId([3; 32]) });
+    flow.task(&mut Author::new(9), &mut n, None, 100); // proposer 9 is a stranger: stays out
+    let t1 = flow.task(&mut m, &mut n, None, 100);
+    let mut m_worker = Author::new(0); // placeholder, replaced below
+    std::mem::swap(&mut m_worker, &mut m);
+    let mut m = m_worker;
+    // M proposes and does a task itself against H0.
+    let t2 = {
+        let task = flow.write(&mut m, propose());
+        let assignment = flow.decide(Body::TaskAssigned { task: task.id(), assignee: m.key.public(), attempt: 1 });
+        flow.write(&mut m, Body::AssignmentAccepted { assignment: assignment.id() });
+        let result = flow.write(&mut m, Body::ResultSubmitted { assignment: assignment.id(), base: Some(BlobHash([100; 32])), patch: None, artifacts: vec![] });
+        flow.decide(Body::ResultAccepted { result: result.id(), head: Some(BlobHash([101; 32])) });
+        task
+    };
+    let mut goal = Goal::new(flow.goal);
+    goal.apply(&flow.events);
+    let before_tasks: Vec<_> = goal.state().tasks.iter().map(|t| (t.id, t.state)).collect();
+    let before_heads = goal.state().accepted_heads.clone();
+    eprintln!("before: tasks {:?} heads {}", before_tasks.iter().map(|t| t.1).collect::<Vec<_>>(), before_heads.len());
+    assert_eq!(before_heads.len(), 2);
+
+    // The node's cutoff: the member's highest effective point.
+    let last_accepted: Option<AuthorPoint> = goal
+        .points(&m.key.public())
+        .iter()
+        .filter(|point| goal.standing(&point.id).is_some_and(|s| s.is_effective()))
+        .max_by_key(|point| point.seq)
+        .copied();
+    let removal = flow.decide(Body::MemberRemoved { member: m.key.public(), last_accepted });
+    goal.apply(&[removal.clone()]);
+    let after_tasks: Vec<_> = goal.state().tasks.iter().map(|t| (t.id, t.state)).collect();
+    assert_eq!(after_tasks, before_tasks);
+    assert_eq!(goal.state().accepted_heads, before_heads);
+    assert!(!goal.state().is_member(&m.key.public()));
+
+    // Work the member backdates to before its removal grants nothing.
+    let backdated = m.event(flow.goal, Some(old_anchor.id()), propose());
+    goal.apply(&[backdated.clone()]);
+    eprintln!("backdated after removal: {:?}", goal.standing(&backdated.id()));
+    assert!(matches!(goal.standing(&backdated.id()), Some(Standing::Excluded(super::Exclusion::PastRemoval))));
+    assert_eq!(goal.state().tasks.len(), before_tasks.len());
+
+    // Readmitted: new work counts, backdated work still does not.
+    let readmit = flow.decide(Body::MemberAdmitted { member: m.key.public(), endpoint: EndpointId([2; 32]) });
+    goal.apply(&[readmit.clone()]);
+    let fresh = m.event(flow.goal, Some(readmit.id()), propose());
+    let again = m.event(flow.goal, Some(old_anchor.id()), propose());
+    goal.apply(&[fresh.clone(), again.clone()]);
+    eprintln!("fresh {:?} backdated again {:?}", goal.standing(&fresh.id()), goal.standing(&again.id()));
+    assert_eq!(goal.standing(&fresh.id()), Some(Standing::Effective));
+    assert!(matches!(goal.standing(&again.id()), Some(Standing::Excluded(super::Exclusion::PastRemoval))));
+    assert_eq!(goal.state().accepted_heads, before_heads);
+    let _ = (t1, t2);
+}
