+//! Reviewer probes: a principal that was never admitted to a goal.
+use super::*;
+use locust_proto::PROTOCOL_VERSION;
+use locust_proto::engine::{ExchangeId, PeerEngine, PeerInput, PeerOutput};
+use locust_proto::id::{EndpointId, GoalId};
+use locust_proto::invite::{Invitation, InviteSecret};
+use locust_proto::sync::{Frontier, SyncMessage};
+
+fn forged_ticket(goal: GoalId, coordinator: PublicKey, endpoint: EndpointId) -> String {
+    Invitation {
+        version: PROTOCOL_VERSION,
+        goal,
+        coordinator,
+        endpoint,
+        hints: vec![],
+        secret: InviteSecret([0x77; 32]),
+        expires_ms: None,
+    }
+    .to_ticket()
+    .unwrap()
+    .as_str()
+    .to_owned()
+}
+
+fn setup() -> (Daemon, PublicKey, ConnId, ConnId, GoalId) {
+    let mut daemon = Daemon::new(41);
+    daemon.node.peer(
+        PeerInput::Endpoint {
+            endpoint: EndpointId([41; 32]),
+            hints: vec![],
+        },
+        0,
+        &mut Vec::new(),
+    );
+    let p1 = daemon.enroll("p1", 1, true);
+    let _p2 = daemon.enroll("p2", 2, true);
+    let c1 = daemon.connect(credential(1), None);
+    let c2 = daemon.connect(credential(2), None);
+    let Response::GoalCreated { goal } = daemon.ok(
+        c1,
+        Request::GoalCreate {
+            title: "p1 private title".into(),
+        },
+    ) else {
+        panic!()
+    };
+    daemon.ok(
+        c1,
+        Request::NoteAdd {
+            goal,
+            about: None,
+            supersedes: None,
+            text: "p1 private note".into(),
+        },
+    );
+    (daemon, p1, c1, c2, goal)
+}
+
+#[test]
+fn probe_unadmitted_principal_reads_held_goal_with_a_forged_ticket() {
+    let (mut daemon, p1, _c1, c2, goal) = setup();
+    assert_eq!(
+        code(daemon.call(c2, Request::Notes { goal, about: None })),
+        ErrorCode::NotFound
+    );
+    let ticket = forged_ticket(goal, p1, EndpointId([0xEE; 32]));
+    daemon.ok(
+        c2,
+        Request::GoalJoin {
+            ticket: locust_proto::invite::Ticket(ticket),
+        },
+    );
+    let notes = daemon.ok(c2, Request::Notes { goal, about: None });
+    let text = format!("{notes:?}");
+    println!("p2 notes after forged join: {text}");
+    assert!(text.contains("p1 private note"));
+}
