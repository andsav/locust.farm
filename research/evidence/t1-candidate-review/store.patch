+#[test]
+fn p8b_finish_after_reopen_differs_from_the_reference_store() {
+    use locust_proto::store::MemStore;
+    let root = tempfile::tempdir().unwrap();
+    let dir = root.path().join("state");
+    let held = Blob::new(b"already held object".to_vec());
+    let reference = MemStore::new();
+    {
+        let mut store = SqliteStore::open(&dir).unwrap();
+        let mut mem = reference.reopen();
+        for s in [&mut store as &mut dyn Store, &mut mem as &mut dyn Store] {
+            s.commit(&Commit {
+                blobs: vec![held.clone()],
+                ..Commit::default()
+            })
+            .unwrap();
+            assert_eq!(s.stage_blob(&held.hash(), 0, held.bytes()), Ok(held.bytes().len() as u64));
+        }
+    }
+    let mut store = SqliteStore::open(&dir).unwrap();
+    let mut mem = reference.reopen();
+    eprintln!(
+        "[probe] after reopen: sqlite staged_len {:?} finish {:?}; memstore staged_len {:?} finish {:?}",
+        store.staged_len(&held.hash()),
+        store.finish_blob(&held.hash()),
+        mem.staged_len(&held.hash()),
+        mem.finish_blob(&held.hash()),
+    );
+}
