+/// Review probe: real nodes found, invite, join and write under exchanges
+/// cut after every possible frame count, then converge once whole.
+#[test]
+fn review_real_nodes_converge_under_every_cut() {
+    for cut in 0..60usize {
+        let mut peers = [Peer::new(1), Peer::new(2), Peer::new(3)];
+        let Response::GoalCreated { goal } = peers[0].call(Request::GoalCreate {
+            title: "cut goal".into(),
+        }) else {
+            panic!("create");
+        };
+        for index in 1..3 {
+            let Response::Invited { ticket } = peers[0].call(Request::GoalInvite {
+                goal,
+                expires_ms: None,
+            }) else {
+                panic!("invite");
+            };
+            peers[index].call(Request::GoalJoin { ticket });
+        }
+        let mut now = 1000;
+        for _ in 0..4 {
+            reconcile_cut(&mut peers, now, Some(cut));
+            now += 61_000;
+        }
+        for (index, peer) in peers.iter_mut().enumerate() {
+            if peer.node.goals[&goal].is_member(&peer.principal) {
+                peer.call(Request::NoteAdd {
+                    goal,
+                    about: None,
+                    supersedes: None,
+                    text: format!("note by {index}"),
+                });
+            }
+        }
+        for _ in 0..4 {
+            reconcile_cut(&mut peers, now, Some(cut));
+            now += 61_000;
+        }
+        for _ in 0..3 {
+            reconcile_cut(&mut peers, now, None);
+            now += 61_000;
+        }
+        for (index, peer) in peers.iter_mut().enumerate() {
+            if peer.node.goals[&goal].is_member(&peer.principal)
+                && note_texts(peer, goal).len() < 3
+            {
+                peer.call(Request::NoteAdd {
+                    goal,
+                    about: None,
+                    supersedes: None,
+                    text: format!("note by {index}"),
+                });
+            }
+        }
+        for _ in 0..3 {
+            reconcile_cut(&mut peers, now, None);
+            now += 61_000;
+        }
+        let logs: Vec<_> = peers
+            .iter()
+            .map(|peer| {
+                peer.store
+                    .log(&goal, 0, usize::MAX)
+                    .unwrap()
+                    .into_iter()
+                    .map(|(_, event)| event.id())
+                    .collect::<std::collections::BTreeSet<_>>()
+            })
+            .collect();
+        let texts: Vec<_> = peers.iter_mut().map(|peer| note_texts(peer, goal)).collect();
+        let members: Vec<_> = peers
+            .iter()
+            .map(|peer| peer.node.goals[&goal].is_member(&peer.principal))
+            .collect();
+        let ok = logs.iter().all(|log| log == &logs[0])
+            && texts.iter().all(|t| t == &texts[0] && t.iter().all(Option::is_some))
+            && members.iter().all(|m| *m);
+        if cut % 10 == 0 || !ok {
+            eprintln!(
+                "cut {cut}: log sizes {:?}, members {:?}, texts {:?}",
+                logs.iter().map(|l| l.len()).collect::<Vec<_>>(),
+                members,
+                texts
+            );
+        }
+        assert!(ok, "cut {cut}");
+    }
+}
