+#[test]
+fn probe_forged_join_on_held_goal() {
+    use locust_proto::invite::{Invitation, InviteSecret};
+    use locust_proto::sync::{Frontier, Refusal, SyncMessage};
+    let mut p = Peer::new(1);
+    let Response::GoalCreated { goal } = p.call(Request::GoalCreate { title: "Private goal title".into() }) else { panic!() };
+    p.call(Request::NoteAdd { goal, about: None, supersedes: None, text: "member-only note text".into() });
+    let intruder = enroll_extra(&mut p, "intruder", 77);
+    let intruder_cred = Credential([77; 32]);
+    println!("intruder notes before: {:?}", note_texts(as_cred(&mut p.node, 2, intruder_cred, Request::Notes { goal, about: None })));
+    let evil = EndpointId([0xEE; 32]);
+    let forged = Invitation {
+        version: locust_proto::PROTOCOL_VERSION,
+        goal,
+        coordinator: p.principal,
+        endpoint: evil,
+        hints: vec![],
+        secret: InviteSecret([0x55; 32]),
+        expires_ms: None,
+    }
+    .to_ticket()
+    .unwrap();
+    println!("intruder join: {:?}", as_cred(&mut p.node, 3, intruder_cred, Request::GoalJoin { ticket: forged }));
+    println!("intruder notes after: {:?}", note_texts(as_cred(&mut p.node, 4, intruder_cred, Request::Notes { goal, about: None })));
+    let held = p.store.log(&goal, 0, usize::MAX).unwrap().len();
+    // Round 1: the evil endpoint answers Join and the frontier with empty frontiers.
+    let exchange = open_to(&mut p.node, 1000, evil).expect("the node dials the ticket's endpoint");
+    let mut join_answered = false;
+    let sent = drive_dialed(&mut p.node, exchange, 1000, |frame| match frame {
+        SyncMessage::Join(_) => {
+            join_answered = true;
+            vec![SyncMessage::Frontier(Frontier::default())]
+        }
+        SyncMessage::Frontier(_) if join_answered => vec![SyncMessage::Frontier(Frontier::default())],
+        _ => vec![],
+    });
+    let pushed: usize = sent.iter().map(|f| if let SyncMessage::Events(e) = f { e.len() } else { 0 }).sum();
+    println!("round 1 frames: {:?}", sent.iter().map(kind).collect::<Vec<_>>());
+    println!("round 1: pushed {pushed} of {held} held events to never-admitted endpoint");
+    let members: Vec<_> = sent.iter().flat_map(|f| if let SyncMessage::Events(e) = f { e.clone() } else { vec![] })
+        .map(|w| format!("{:?}", w).chars().take(0).collect::<String>()).collect();
+    let _ = members;
+    // A new note, then the next round re-dials.
+    p.call(Request::NoteAdd { goal, about: None, supersedes: None, text: "second".into() });
+    let held = p.store.log(&goal, 0, usize::MAX).unwrap().len();
+    let exchange = open_to(&mut p.node, 2000, evil).expect("re-dial after change");
+    let mut join_answered = false;
+    let sent = drive_dialed(&mut p.node, exchange, 2000, |frame| match frame {
+        SyncMessage::Join(_) => {
+            join_answered = true;
+            vec![SyncMessage::Frontier(Frontier::default())]
+        }
+        SyncMessage::Frontier(_) if join_answered => vec![SyncMessage::Frontier(Frontier::default())],
+        _ => vec![],
+    });
+    let pushed: usize = sent.iter().map(|f| if let SyncMessage::Events(e) = f { e.len() } else { 0 }).sum();
+    println!("round 2: pushed {pushed} of {held}; frames {:?}", sent.iter().map(kind).collect::<Vec<_>>());
+    // Does the node send keys or blobs? (it should not)
+    // Now the evil endpoint refuses the join: refused flag set.
+    let exchange = open_to(&mut p.node, 40000, evil).expect("anti-entropy re-dial");
+    let sent = drive_dialed(&mut p.node, exchange, 40000, |frame| match frame {
+        SyncMessage::Join(_) => vec![SyncMessage::Refused(Refusal::InvitationRefused)],
+        _ => vec![],
+    });
+    println!("round 3 (refused) frames: {:?}", sent.iter().map(kind).collect::<Vec<_>>());
+    let join = p.node.goals[&goal].local.joins.get(&intruder).cloned();
+    println!("join record after refusal: refused={:?}", join.map(|j| j.refused));
+    p.call(Request::NoteAdd { goal, about: None, supersedes: None, text: "after refusal".into() });
+    println!("intruder notes after refusal: {:?}", note_texts(as_cred(&mut p.node, 5, intruder_cred, Request::Notes { goal, about: None })));
+    println!("intruder status after refusal: {:?}", as_cred(&mut p.node, 6, intruder_cred, Request::Status).map(|r| match r { Response::Status(s) => format!("{:?}", s.goals.iter().map(|g| (g.membership, g.title.clone())).collect::<Vec<_>>()), o => format!("{o:?}") }));
+    println!("re-dial after refusal: {:?}", open_to(&mut p.node, 100000, evil));
+}
