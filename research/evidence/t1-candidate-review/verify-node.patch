+/// Finding removed-principal-reads-new-epochs.
+#[test]
+fn vn_removed_principal_reads_new_epoch_when_daemon_speaks_for_another() {
+    let mut at = 1_000;
+    let mut peers = [Peer::new(1), Peer::new(2), Peer::new(3)];
+    peers[0].enroll("alice", 11);
+    let removed = peers[1].enroll("removed", 21);
+    let _stays = peers[1].enroll("stays", 22);
+    let lone = peers[2].enroll("lone", 31);
+    let goal = create(&mut peers[0], 11, "removal goal");
+    for (index, tag) in [(1usize, 21u8), (1, 22), (2, 31)] {
+        let ticket = invite(&mut peers[0], 11, goal);
+        peers[index].agent(tag, Request::GoalJoin { ticket }).unwrap();
+        sync(&mut peers, &mut at);
+    }
+    println!(
+        "joined: removed {:?} stays {:?} lone {:?}",
+        peers[1].membership(&goal, &removed),
+        peers[1].membership(&goal, &_stays),
+        peers[2].membership(&goal, &lone)
+    );
+    peers[0]
+        .agent(11, Request::MemberRemove { goal, member: removed })
+        .unwrap();
+    peers[0]
+        .agent(11, Request::MemberRemove { goal, member: lone })
+        .unwrap();
+    note(&mut peers[0], 11, goal, "after removal, new epoch").unwrap();
+    sync(&mut peers, &mut at);
+    println!(
+        "removed membership: {:?}; note.add: {}; notes: {:?}",
+        peers[1].membership(&goal, &removed),
+        code(note(&mut peers[1], 21, goal, "y")),
+        note_texts(&mut peers[1], 21, goal)
+    );
+    println!(
+        "lone removed membership: {:?}; notes: {:?}",
+        peers[2].membership(&goal, &lone),
+        note_texts(&mut peers[2], 31, goal)
+    );
+}
