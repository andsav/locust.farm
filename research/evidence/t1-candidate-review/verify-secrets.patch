+// ---- verify-secrets probes ----
+fn as_cred(
+    node: &mut Node<MemStore, Random>,
+    conn: u64,
+    credential: Credential,
+    operation: Request,
+) -> Result<Response, locust_proto::api::ApiError> {
+    let hello = node.connect(
+        ConnId(conn),
+        &ClientHello {
+            api_version: locust_proto::API_VERSION,
+            credential,
+            session: None,
+        },
+        0,
+    );
+    assert!(matches!(hello, ServerHello::Welcome { .. }), "{hello:?}");
+    let answer = match node.request(
+        ConnId(conn),
+        RequestFrame {
+            id: 7,
+            idempotency: None,
+            on_behalf: None,
+            request: operation,
+        },
+        10,
+    ) {
+        Step::Reply(reply) => reply.result,
+        Step::Park(_) => panic!("parked"),
+    };
+    node.disconnect(ConnId(conn));
+    answer
+}
+
+fn enroll_extra(peer: &mut Peer, name: &str, tag: u8) -> PublicKey {
+    let Response::AgentEnrolled { agent } = request(
+        &mut peer.node,
+        None,
+        Request::AgentEnroll {
+            name: name.into(),
+            grants: Grants { manage_goals: true },
+            credential: Credential([tag; 32]).digest(),
+        },
+    ) else {
+        panic!("enroll");
+    };
+    agent
+}
+
+fn note_texts(r: Result<Response, locust_proto::api::ApiError>) -> Result<Vec<Option<String>>, String> {
+    match r {
+        Ok(Response::Notes(notes)) => Ok(notes.into_iter().map(|n| n.text).collect()),
+        Ok(other) => Err(format!("{other:?}")),
+        Err(e) => Err(format!("{:?} {}", e.code, e.message)),
+    }
+}
+
+/// Drives one dialed exchange by hand: the remote endpoint answers each
+/// frame through `answer`. Returns every frame the node sent.
+fn drive_dialed(
+    node: &mut Node<MemStore, Random>,
+    exchange: ExchangeId,
+    now: u64,
+    mut answer: impl FnMut(&locust_proto::sync::SyncMessage) -> Vec<locust_proto::sync::SyncMessage>,
+) -> Vec<locust_proto::sync::SyncMessage> {
+    let mut sent = Vec::new();
+    let mut queue: VecDeque<PeerInput> = VecDeque::from([PeerInput::Opened(exchange)]);
+    let mut steps = 0;
+    while let Some(input) = queue.pop_front() {
+        steps += 1;
+        assert!(steps < 10000);
+        let mut out = vec![];
+        node.peer(input, now, &mut out);
+        for output in out {
+            match output {
+                PeerOutput::Send { exchange: e, frame } if e == exchange => {
+                    for reply in answer(&frame) {
+                        queue.push_back(PeerInput::Frame { exchange, frame: reply });
+                    }
+                    sent.push(frame);
+                    queue.push_back(PeerInput::Writable(exchange));
+                }
+                PeerOutput::Finish(e) if e == exchange => queue.push_back(PeerInput::Finished(e)),
+                _ => {}
+            }
+        }
+    }
+    sent
+}
+
+fn kind(frame: &locust_proto::sync::SyncMessage) -> String {
+    use locust_proto::sync::SyncMessage as M;
+    match frame {
+        M::Hello { .. } => "Hello".into(),
+        M::Join(_) => "Join".into(),
+        M::Frontier(f) => format!("Frontier({} authors)", f.authors.len()),
+        M::Events(e) => format!("Events x{}", e.len()),
+        M::Done => "Done".into(),
+        other => format!("{other:?}").chars().take(40).collect(),
+    }
+}
+
+fn open_to(node: &mut Node<MemStore, Random>, now: u64, target: EndpointId) -> Option<ExchangeId> {
+    let mut out = vec![];
+    node.peer(PeerInput::Poll, now, &mut out);
+    let mut found = None;
+    for output in out {
+        if let PeerOutput::Open { exchange, endpoint, .. } = output {
+            if endpoint == target {
+                found = Some(exchange);
+            } else {
+                // Others fail at once.
+                node.peer(PeerInput::OpenFailed(exchange), now, &mut vec![]);
+            }
+        }
+    }
+    found
+}
