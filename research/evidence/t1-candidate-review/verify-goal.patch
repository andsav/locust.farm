+//! Independent probe (verify-goal): the coordinator removes itself.
+use super::lifecycle::{event, setup};
+use super::*;
+
+#[test]
+fn v_coordinator_self_removal() {
+    let (mut daemon, principal, owner, agent, goal) = setup();
+    let task = event(daemon.ok(
+        agent,
+        Request::TaskPropose {
+            goal,
+            text: "A task".into(),
+            input: None,
+            depends_on: vec![],
+            deadline_ms: None,
+            max_attempts: None,
+        },
+    ));
+    let removed = daemon.call(
+        agent,
+        Request::MemberRemove {
+            goal,
+            member: principal,
+        },
+    );
+    println!("self-removal: {:?}", removed.as_ref().map(|_| "Recorded"));
+    let assign = daemon.call(
+        agent,
+        Request::TaskAssign {
+            goal,
+            task,
+            assignee: principal,
+        },
+    );
+    println!("task.assign after: {:?}", assign.map_err(|e| (e.code, e.message)));
+    let invite = daemon.call(
+        agent,
+        Request::GoalInvite {
+            goal,
+            expires_ms: None,
+        },
+    );
+    println!("goal.invite after: {:?}", invite.map_err(|e| (e.code, e.message)).map(|_| "ok"));
+    let invite_owner = daemon.on_behalf(
+        owner,
+        principal,
+        Request::GoalInvite {
+            goal,
+            expires_ms: None,
+        },
+    );
+    println!(
+        "goal.invite by owner on behalf: {:?}",
+        invite_owner.map_err(|e| (e.code, e.message)).map(|_| "ok")
+    );
+    let status = daemon.call(agent, Request::GoalStatus { goal });
+    match status {
+        Ok(Response::GoalStatus(status)) => println!(
+            "goal.status: members {} halted {:?}",
+            status.members.len(),
+            status.halted
+        ),
+        other => println!("goal.status: {other:?}"),
+    }
+    let status = daemon.on_behalf(owner, principal, Request::GoalStatus { goal });
+    match status {
+        Ok(Response::GoalStatus(status)) => println!(
+            "goal.status (owner on behalf): members {} halted {:?}",
+            status.members.len(),
+            status.halted
+        ),
+        other => println!("goal.status (owner on behalf): {other:?}"),
+    }
+    daemon.restart();
+    let agent = daemon.connect(credential(1), Some(session(2)));
+    let assign = daemon.call(
+        agent,
+        Request::TaskAssign {
+            goal,
+            task,
+            assignee: principal,
+        },
+    );
+    println!("task.assign after restart: {:?}", assign.map_err(|e| (e.code, e.message)));
+}
