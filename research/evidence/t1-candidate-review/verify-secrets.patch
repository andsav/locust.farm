+#[test]
+fn probe_removed_principal_reads_new_epoch() {
+    let mut peers = [Peer::new(1), Peer::new(2)];
+    let second = enroll_extra(&mut peers[1], "second", 88);
+    let second_cred = Credential([88; 32]);
+    let goal = found(&mut peers);
+    let Response::Invited { ticket } = peers[0].call(Request::GoalInvite { goal, expires_ms: None }) else { panic!() };
+    println!("second join: {:?}", as_cred(&mut peers[1].node, 2, second_cred, Request::GoalJoin { ticket }));
+    reconcile(&mut peers, 3000);
+    reconcile(&mut peers, 4000);
+    reconcile(&mut peers, 35000);
+    reconcile(&mut peers, 36000);
+    let Response::GoalStatus(status) = peers[0].call(Request::GoalStatus { goal }) else { panic!() };
+    println!("members at coordinator: {}", status.members.len());
+    peers[0].call(Request::NoteAdd { goal, about: None, supersedes: None, text: "epoch zero note".into() });
+    peers[0].call(Request::MemberRemove { goal, member: second });
+    peers[0].call(Request::NoteAdd { goal, about: None, supersedes: None, text: "epoch one, not for the removed key".into() });
+    reconcile(&mut peers, 70000);
+    reconcile(&mut peers, 110000);
+    let keys: Vec<_> = peers[1].node.goals[&goal].keys.keys().copied().collect();
+    println!("daemon 2 key epochs: {keys:?}");
+    println!("second status: {:?}", as_cred(&mut peers[1].node, 3, second_cred, Request::Status).map(|r| match r { Response::Status(s) => format!("{:?}", s.goals.iter().map(|g| g.membership).collect::<Vec<_>>()), o => format!("{o:?}") }));
+    println!("second notes: {:?}", note_texts(as_cred(&mut peers[1].node, 4, second_cred, Request::Notes { goal, about: None })));
+    println!("peer2 notes: {:?}", note_texts(as_cred(&mut peers[1].node, 5, Credential([2; 32]), Request::Notes { goal, about: None })));
+    println!("second note.add: {:?}", as_cred(&mut peers[1].node, 6, second_cred, Request::NoteAdd { goal, about: None, supersedes: None, text: "x".into() }).map_err(|e| e.code));
+}
