+pub fn generate(seed: u64) -> World {
+    let mut pick = Rng(seed ^ 0xABCD_EF01);
+    let flags = Flags {
+        coordinator_fork: pick.chance(20),
+        broken_chain: pick.chance(15),
+        member_fork: pick.chance(50),
+        prev_mismatch: pick.chance(25),
+        garbage_anchor: pick.chance(40),
+        removals: pick.chance(70),
+        stall: pick.chance(25),
+    };
+    let members = 2 + pick.below(4);
+    let steps = 30 + pick.below(110);
+    let mut world = World::new(seed, flags, members);
+    for step in 0..steps {
+        world.late = step * 3 > steps * 2;
+        world.step();
+    }
+    world
+}
+
+pub fn check_scenario(seed: u64, permutations: usize) -> (usize, usize) {
+    let world = generate(seed);
+    let mut rng = Rng(seed.wrapping_mul(31).wrapping_add(7));
+    // Sometimes a few events never arrive.
+    let mut set = world.events.clone();
+    if rng.chance(40) {
+        for _ in 0..1 + rng.below(3) {
+            let at = rng.below(set.len());
+            set.remove(at);
+        }
+    }
+    let mut reference = Goal::new(world.goal);
+    reference.apply(&set);
+    assert_eq!(reference.folded, fold::fold(&reference.history).0, "seed {seed}: one batch");
+    let expected = view(&reference);
+    let effective = expected.standings.values().filter(|s| s.is_effective()).count();
+
+    for round in 0..permutations {
+        let mut order = set.clone();
+        match round % 4 {
+            0 => {} // generation order, batched
+            1 => order.reverse(),
+            _ => rng.shuffle(&mut order),
+        }
+        // Duplicates.
+        for _ in 0..rng.below(4) {
+            let event = order[rng.below(order.len())].clone();
+            let at = rng.below(order.len() + 1);
+            order.insert(at, event);
+        }
+        let max_batch = [1, 1, 3, 8, 40][rng.below(5)];
+        let (actual, store) = feed(world.goal, &order, &mut rng, round % 5 == 0, max_batch);
+        let got = view(&actual);
+        if got != expected {
+            eprintln!("seed {seed} round {round}: transcript\n{}", world.log.join("\n"));
+        }
+        assert_eq!(got.state, expected.state, "seed {seed} round {round}: state");
+        assert_eq!(got.halt, expected.halt, "seed {seed} round {round}: halt");
+        assert_eq!(got.standings, expected.standings, "seed {seed} round {round}: standings");
+        assert_eq!(got, expected, "seed {seed} round {round}: view");
+        let loaded = Goal::load(&store.reopen(), world.goal).unwrap();
+        assert_eq!(view(&loaded), expected, "seed {seed} round {round}: load");
+        // The reconciliation rule by lookup agrees with the rule by points.
+        for (author, (points, ..)) in &expected.authors {
+            for cut in 0..=points.len() {
+                let theirs = AuthorFrontier::from_points(*author, &points[..cut]);
+                assert_eq!(
+                    actual.extends(&theirs),
+                    theirs.is_prefix_of(points),
+                    "seed {seed}: extends by lookup"
+                );
+            }
+        }
+    }
+    (set.len(), effective)
+}
