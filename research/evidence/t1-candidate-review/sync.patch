+/// A member pipelines InventoryRequests and never grants capacity: how many
+/// bytes of answer frames does the responder hold for it?
+#[test]
+fn review2_inventory_request_amplification() {
+    let founded = Founded::new();
+    let mut writer = Author::new(2);
+    let notes = founded.notes(&mut writer, MAX_INVENTORY_POINTS + 10);
+    let author = writer.key.public();
+    let mut host = host(1, founded.replica(&notes), &[1, 2]);
+    let mut responder = Responder::new(endpoint(2));
+    let mut out = Vec::new();
+    responder.receive(&mut host, hello(founded.goal), 0, &mut out);
+    let request = SyncMessage::InventoryRequest {
+        author,
+        after: None,
+    };
+    let request_bytes = codec::encode(&request).unwrap().len();
+    let n = 200;
+    for _ in 0..n {
+        responder.receive(&mut host, request.clone(), 0, &mut out);
+    }
+    assert_eq!(out.len(), 1, "one frame sent, the rest waits for capacity");
+    // Drain to count what was owed (held in memory before any capacity).
+    loop {
+        let before = out.len();
+        responder.writable(&mut host, &mut out);
+        if out.len() == before {
+            break;
+        }
+    }
+    let owed: usize = out.iter().map(|f| codec::encode(f).unwrap().len()).sum();
+    eprintln!(
+        "{n} InventoryRequests of {request_bytes} bytes ({} bytes in) were answered by {} frames, \
+         {owed} encoded bytes, all materialized before the first Writable: amplification {}x",
+        n * request_bytes,
+        out.len(),
+        owed / (n * request_bytes)
+    );
+}
