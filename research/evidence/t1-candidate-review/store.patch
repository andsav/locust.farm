+#[test]
+fn p2_finish_promotes_a_last_chunk_whose_flush_failed() {
+    let root = tempfile::tempdir().unwrap();
+    let dir = root.path().join("state");
+    let large = object(2 * BLOB_CHUNK_BYTES);
+    let (hash, bytes) = (large.hash(), large.bytes());
+    let total = bytes.len() as u64;
+    {
+        let mut store = SqliteStore::open(&dir).unwrap();
+        assert_eq!(
+            store.stage_blob(&hash, 0, &bytes[..BLOB_CHUNK_BYTES]),
+            Ok(BLOB_CHUNK_BYTES as u64)
+        );
+        set("LRC_FAIL", ".staged");
+        let last = store.stage_blob(&hash, BLOB_CHUNK_BYTES as u64, &bytes[BLOB_CHUNK_BYTES..]);
+        unset("LRC_FAIL");
+        eprintln!("[probe] last chunk stage_blob -> {last:?}");
+    }
+    // Restart, then what the initiator does: request from the staged length,
+    // receive the empty final chunk, stage it and finish.
+    let mut store = SqliteStore::open(&dir).unwrap();
+    eprintln!("[probe] staged_len after restart {:?} of {total}", store.staged_len(&hash));
+    set("LRC_TRACE", "1");
+    mark("resume and finish");
+    let staged = store.stage_blob(&hash, total, &[]);
+    let finished = store.finish_blob(&hash);
+    mark("end");
+    set("LRC_TRACE", "0");
+    eprintln!(
+        "[probe] stage_blob(total, []) -> {staged:?}; finish_blob -> {finished:?}; blob_len {:?}; files {:?}",
+        store.blob_len(&hash),
+        files(&dir)
+    );
+}
