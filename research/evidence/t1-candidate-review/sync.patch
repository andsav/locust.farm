+/// Review probe (real nodes): cost of a peer catching up on N notes, and of
+/// pushing one more note to a peer that holds the rest.
+#[test]
+fn review_real_node_catch_up_and_push_costs() {
+    use locust_proto::sync::SyncMessage;
+    for count in [250usize, 500, 1000, 2000] {
+        let mut peers = [Peer::new(1), Peer::new(2)];
+        let goal = found(&mut peers);
+        peers[1].online = false;
+        for n in 0..count {
+            peers[0].call(Request::NoteAdd {
+                goal,
+                about: None,
+                supersedes: None,
+                text: format!("note {n}"),
+            });
+        }
+        peers[1].online = true;
+        let started = std::time::Instant::now();
+        let sent = reconcile(&mut peers, 100_000);
+        let catch_up = started.elapsed();
+        let requests = sent
+            .iter()
+            .filter(|f| matches!(f, SyncMessage::BlobRequest { .. }))
+            .count();
+        reconcile(&mut peers, 200_000);
+        assert_eq!(note_texts(&mut peers[1], goal).len(), count);
+        peers[0].call(Request::NoteAdd {
+            goal,
+            about: None,
+            supersedes: None,
+            text: "one more".into(),
+        });
+        let started = std::time::Instant::now();
+        let sent = reconcile(&mut peers, 300_000);
+        let push = started.elapsed();
+        let inventory_points: usize = sent
+            .iter()
+            .map(|f| match f {
+                SyncMessage::Inventory { points, .. } => points.len(),
+                _ => 0,
+            })
+            .sum();
+        let bytes: usize = sent
+            .iter()
+            .map(|f| locust_proto::codec::encode(f).unwrap().len())
+            .sum();
+        eprintln!(
+            "notes {count}: catch-up {catch_up:?} ({requests} blob requests); \
+             pushing one note: {} frames, {bytes} bytes, {inventory_points} inventory points, {push:?}",
+            sent.len()
+        );
+    }
+}
