+#[test]
+fn review_initiator_refuses_frames_out_of_grammar() {
+    let founded = Founded::new();
+    let notes = founded.notes(&mut Author::new(2), 5);
+    let mut host = host(1, founded.replica(&notes), &[1, 2]);
+    let author = Author::new(2).key.public();
+    let start = |host: &mut TestHost| {
+        let replica = host.replica_mut(&founded.goal);
+        let mut initiator = Initiator::new(founded.goal);
+        let mut out = Vec::new();
+        initiator.start(replica, &mut out);
+        initiator.writable(replica, &mut out);
+        initiator.writable(replica, &mut out);
+        initiator
+    };
+    let empty_inventory = |more: bool, points: Vec<AuthorPoint>| SyncMessage::Inventory {
+        author,
+        points,
+        more,
+    };
+    let point = |seq| AuthorPoint {
+        seq,
+        id: EventId([seq as u8; 32]),
+    };
+    let cases: Vec<(&str, Vec<SyncMessage>)> = vec![
+        ("done from responder", vec![SyncMessage::Done]),
+        ("hello from responder", vec![hello(founded.goal)]),
+        (
+            "same author inventoried twice",
+            vec![
+                empty_inventory(false, vec![]),
+                empty_inventory(false, vec![]),
+            ],
+        ),
+        ("more with no points", vec![empty_inventory(true, vec![])]),
+        (
+            "event request from responder",
+            vec![SyncMessage::EventRequest(vec![])],
+        ),
+        (
+            "follow-up page for another author",
+            vec![
+                empty_inventory(true, vec![point(0)]),
+                SyncMessage::Frontier(Frontier::default()),
+                SyncMessage::Inventory {
+                    author: PublicKey([9; 32]),
+                    points: vec![point(1)],
+                    more: false,
+                },
+            ],
+        ),
+        (
+            "follow-up page not after the cursor",
+            vec![
+                empty_inventory(true, vec![point(3)]),
+                SyncMessage::Frontier(Frontier::default()),
+                // Events answering the request for point(3), then the page.
+                SyncMessage::Events(vec![]),
+                empty_inventory(false, vec![point(3)]),
+            ],
+        ),
+        (
+            "unasked blob chunk",
+            vec![
+                SyncMessage::Frontier(Frontier::default()),
+                SyncMessage::BlobChunk {
+                    hash: BlobHash([1; 32]),
+                    offset: 0,
+                    total: 1,
+                    bytes: vec![1],
+                },
+            ],
+        ),
+    ];
+    for (name, frames) in cases {
+        let mut initiator = start(&mut host);
+        let mut out = Vec::new();
+        for frame in frames {
+            let replica = host.replica_mut(&founded.goal);
+            initiator.receive(replica, frame, &mut out);
+            loop {
+                let before = out.len();
+                initiator.writable(replica, &mut out);
+                if out.len() == before {
+                    break;
+                }
+            }
+        }
+        eprintln!("{name}: ended {:?}, last {:?}", initiator.ended(), out.last());
+        assert_eq!(
+            initiator.ended(),
+            Some(Ended::Refused(Refusal::ProtocolError)),
+            "{name}"
+        );
+    }
+}
