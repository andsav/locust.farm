+//! Reviewer probes (scratch copy only).
+use super::lifecycle::{event, setup};
+use super::*;
+use locust_proto::api::{Membership, PendingWork, WaitOutcome};
+use locust_proto::engine::{ExchangeId, PeerEngine, PeerInput, PeerOutput};
+use locust_proto::event::Doc;
+use locust_proto::id::{EndpointId, EventId, GoalId};
+use locust_proto::invite::{Invitation, InviteSecret};
+use locust_proto::store::{Space, Store};
+use locust_proto::sync::{Frontier, SyncMessage};
+
+fn pending(daemon: &mut Daemon, conn: ConnId, goal: GoalId) -> PendingWork {
+    let Response::Pending(work) = daemon.ok(conn, Request::Pending { goal }) else {
+        panic!()
+    };
+    work
+}
+
+fn note(goal: GoalId, text: &str) -> Request {
+    Request::NoteAdd {
+        goal,
+        about: None,
+        supersedes: None,
+        text: text.into(),
+    }
+}
+
+fn assigned(daemon: &mut Daemon, agent: ConnId, goal: GoalId, to: PublicKey) -> (EventId, EventId) {
+    let task = event(daemon.ok(
+        agent,
+        Request::TaskPropose {
+            goal,
+            text: "Secret task text\nmore".into(),
+            input: None,
+            depends_on: vec![],
+            deadline_ms: None,
+            max_attempts: None,
+        },
+    ));
+    let assignment = event(daemon.ok(
+        agent,
+        Request::TaskAssign {
+            goal,
+            task,
+            assignee: to,
+        },
+    ));
+    (task, assignment)
+}
