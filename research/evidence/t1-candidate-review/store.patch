+#[test]
+fn p7_damaged_signature_and_same_length_object_damage_are_returned() {
+    let root = tempfile::tempdir().unwrap();
+    let dir = root.path().join("state");
+    let mut owner = Author::new(1);
+    let genesis = owner.genesis();
+    let small = Blob::new(b"inline object bytes".to_vec());
+    let large = object(INLINE_MAX_BYTES + 3);
+    {
+        let mut store = SqliteStore::open(&dir).unwrap();
+        store
+            .commit(&Commit {
+                events: vec![genesis.clone()],
+                blobs: vec![small.clone(), large.clone()],
+                ..Commit::default()
+            })
+            .unwrap();
+    }
+    let raw = rusqlite::Connection::open(dir.join("locust.db")).unwrap();
+    raw.execute("UPDATE events SET signature = zeroblob(64)", []).unwrap();
+    raw.execute(
+        "UPDATE blobs SET bytes = CAST(upper(CAST(bytes AS TEXT)) AS BLOB) WHERE bytes IS NOT NULL",
+        [],
+    )
+    .unwrap();
+    drop(raw);
+    let path = dir.join("blobs").join(large.hash().to_string());
+    let mut bytes = fs::read(&path).unwrap();
+    bytes[10] ^= 0xff;
+    fs::write(&path, &bytes).unwrap();
+    let store = SqliteStore::open(&dir).unwrap();
+    let event = store.event(&genesis.id());
+    eprintln!(
+        "[probe] event ok: {}, signature changed: {}",
+        event.is_ok(),
+        matches!(&event, Ok(Some(e)) if e.signature() != genesis.signature())
+    );
+    eprintln!(
+        "[probe] inline blob -> {:?}; file blob ok and differs: {:?}",
+        store.blob(&small.hash()).map(|b| b.map(String::from_utf8)),
+        store.blob(&large.hash()).map(|b| b.map(|b| b != large.bytes()))
+    );
+}
