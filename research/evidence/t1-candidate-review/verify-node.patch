+/// Finding joining-reads-cohosted-goal, remote variants.
+#[test]
+fn vn_refused_join_reads_and_made_up_endpoint_gets_log() {
+    let mut at = 1_000;
+    let mut peers = [Peer::new(1), Peer::new(2)];
+    let _alice = peers[0].enroll("alice", 11);
+    let member = peers[1].enroll("member", 21);
+    let intruder = peers[1].enroll("intruder", 22);
+    let made_up = peers[1].enroll("madeup", 23);
+    let goal = create(&mut peers[0], 11, "remote goal title");
+    note(&mut peers[0], 11, goal, "before admission note").unwrap();
+    let ticket = invite(&mut peers[0], 11, goal);
+    peers[1]
+        .agent(21, Request::GoalJoin { ticket: ticket.clone() })
+        .unwrap();
+    sync(&mut peers, &mut at);
+    println!(
+        "member membership on B: {:?}",
+        peers[1].membership(&goal, &member)
+    );
+    // The intruder replays the ticket the member already redeemed.
+    println!(
+        "intruder before join: {}",
+        code(peers[1].agent(22, Request::Notes { goal, about: None }))
+    );
+    println!(
+        "intruder join (replayed ticket): {}",
+        code(peers[1].agent(22, Request::GoalJoin { ticket: ticket.clone() }))
+    );
+    sync(&mut peers, &mut at);
+    let refused = peers[1].node.goals[&goal].local.joins.get(&intruder).map(|j| j.refused);
+    println!("intruder join.refused on B: {refused:?}");
+    println!(
+        "intruder is member on A: {}, on B: {}",
+        peers[0].is_member(&goal, &intruder),
+        peers[1].is_member(&goal, &intruder)
+    );
+    println!(
+        "intruder repeat join: {}",
+        code(peers[1].agent(22, Request::GoalJoin { ticket: ticket.clone() }))
+    );
+    note(&mut peers[0], 11, goal, "written after the refusal").unwrap();
+    sync(&mut peers, &mut at);
+    println!(
+        "intruder membership on B: {:?}; notes: {:?}",
+        peers[1].membership(&goal, &intruder),
+        note_texts(&mut peers[1], 22, goal)
+    );
+    peers[1].restart();
+    println!(
+        "after restart intruder notes: {:?}",
+        note_texts(&mut peers[1], 22, goal)
+    );
+
+    // A ticket made up from the goal id and the coordinator key, naming an
+    // endpoint the joiner controls.
+    let invitation = Invitation {
+        version: locust_proto::PROTOCOL_VERSION,
+        goal,
+        coordinator: peers[0].node.goals[&goal].state().coordinator.unwrap(),
+        endpoint: FAKE,
+        hints: vec![],
+        secret: InviteSecret([0x42; 32]),
+        expires_ms: None,
+    };
+    let forged = invitation.to_ticket().unwrap();
+    println!(
+        "made-up join: {}",
+        code(peers[1].agent(23, Request::GoalJoin { ticket: forged }))
+    );
+    println!(
+        "made-up joiner notes: {:?}",
+        note_texts(&mut peers[1], 23, goal)
+    );
+    let mut fake_log = Vec::new();
+    at += 61_000;
+    reconcile(&mut peers, at, &mut fake_log);
+    let kinds: Vec<String> = fake_log
+        .iter()
+        .map(|frame| match frame {
+            SyncMessage::Events(events) => format!("Events x{}", events.len()),
+            other => format!("{:?}", other).chars().take(14).collect(),
+        })
+        .collect();
+    println!("frames sent to the made-up endpoint: {kinds:?}");
+    println!("goal log length on B: {}", peers[1].events(&goal));
+    let _ = made_up;
+}
