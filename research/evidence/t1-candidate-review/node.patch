+/// H6: idempotency.
+#[test]
+fn probe_h6_idempotency() {
+    let (mut daemon, principal, owner, agent, goal) = setup();
+    let (_, assignment) = assigned(&mut daemon, agent, goal, principal);
+    // A failed request leaves nothing behind.
+    let claim = Request::TaskClaim { goal, assignment };
+    assert_eq!(
+        code(daemon.keyed(agent, 7, claim.clone())),
+        ErrorCode::AuthorizationRequired
+    );
+    assert!(daemon.store.scan(Space::Idempotency, &[]).unwrap().is_empty());
+    daemon.ok(
+        owner,
+        Request::TaskAuthorize {
+            goal,
+            assignment,
+            takeover: true,
+        },
+    );
+    let first = daemon.keyed(agent, 7, claim.clone()).unwrap();
+    assert_eq!(daemon.keyed(agent, 7, claim.clone()).unwrap(), first);
+    // Same key, another request.
+    assert_eq!(
+        code(daemon.keyed(agent, 7, note(goal, "x"))),
+        ErrorCode::IdempotencyMismatch
+    );
+    // B takes over; A replays the keyed claim.
+    let b = daemon.connect(credential(1), Some(session(2)));
+    daemon.ok(b, Request::TaskTakeover { goal, assignment });
+    let replay = daemon.keyed(agent, 7, claim.clone());
+    println!("H6 replayed claim after takeover: {replay:?}");
+    let live = daemon.call(agent, claim.clone());
+    println!("H6 unkeyed claim after takeover: {live:?}");
+    // Another session of the same principal replays A's key.
+    let replay_b = daemon.keyed(b, 7, claim.clone());
+    println!("H6 session B replays session A's keyed claim: {replay_b:?}");
+    // The owner's scope is separate from the agent's.
+    let owner_keyed = {
+        let mut frame = daemon.frame(note(goal, "by owner"));
+        frame.idempotency = Some(IdempotencyKey([7; 16]));
+        frame.on_behalf = Some(principal);
+        daemon.send(owner, frame)
+    };
+    println!("H6 owner same key on behalf: {owner_keyed:?}");
+    // Invite under a key: what the cache keeps.
+    let invite = Request::GoalInvite {
+        goal,
+        expires_ms: None,
+    };
+    let Response::Invited { ticket } = daemon.keyed(agent, 8, invite.clone()).unwrap() else {
+        panic!()
+    };
+    let secret = Invitation::from_ticket(ticket.as_str()).unwrap().secret;
+    let holds = |rows: Vec<(Vec<u8>, Vec<u8>)>| {
+        rows.iter()
+            .any(|(_, value)| value.windows(32).any(|part| part == secret.0))
+    };
+    println!(
+        "H6 invite secret in Idempotency: {}, in Invite: {}",
+        holds(daemon.store.scan(Space::Idempotency, &[]).unwrap()),
+        holds(daemon.store.scan(Space::Invite, &[]).unwrap())
+    );
+    // A viewer of the principal replays the invite key.
+    daemon.ok(
+        owner,
+        Request::ViewerEnroll {
+            agent: principal,
+            credential: credential(9).digest(),
+        },
+    );
+    let viewer = daemon.connect(credential(9), None);
+    println!(
+        "H6 viewer replays invite key: {:?}",
+        daemon.keyed(viewer, 8, invite.clone())
+    );
+    // The agent loses manage_goals and replays.
+    daemon.ok(
+        owner,
+        Request::AgentGrant {
+            agent: principal,
+            grants: Grants {
+                manage_goals: false,
+            },
+        },
+    );
+    println!(
+        "H6 replay invite after grant removed: {:?}; fresh: {:?}",
+        daemon.keyed(agent, 8, invite.clone()).map(|_| "ticket"),
+        daemon.call(agent, invite).map(|_| "ticket")
+    );
+    // A keyed stop is replayed without stopping after a restart.
+    let stop = daemon.keyed(owner, 9, Request::Shutdown);
+    println!("H6 keyed stop: {stop:?} stop_requested={}", daemon.node.stop_requested());
+    daemon.restart();
+    let owner = daemon.owner();
+    let stop = daemon.keyed(owner, 9, Request::Shutdown);
+    println!(
+        "H6 keyed stop replay after restart: {stop:?} stop_requested={}",
+        daemon.node.stop_requested()
+    );
+}
