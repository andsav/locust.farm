+#[test]
+fn probe_crafted_ticket_lets_outsider_read_and_exfiltrate_held_goal() {
+    use locust_proto::invite::{Invitation, InviteSecret};
+    use locust_proto::sync::{Frontier, SyncMessage};
+    let mut peers = [Peer::new(1)];
+    let goal = found(&mut peers);
+    let coordinator = peers[0].principal;
+    peers[0].call(Request::NoteAdd {
+        goal,
+        about: None,
+        supersedes: None,
+        text: "private note for members only".into(),
+    });
+    // A second local principal that never took part in the goal.
+    let Response::AgentEnrolled { agent: outsider } = request(
+        &mut peers[0].node,
+        None,
+        Request::AgentEnroll {
+            name: "outsider".into(),
+            grants: Grants { manage_goals: true },
+            credential: Credential([5; 32]).digest(),
+        },
+    ) else {
+        panic!("enroll");
+    };
+    let welcome = peers[0].node.connect(
+        ConnId(55),
+        &ClientHello {
+            api_version: locust_proto::API_VERSION,
+            credential: Credential([5; 32]),
+            session: None,
+        },
+        0,
+    );
+    assert!(matches!(welcome, ServerHello::Welcome { .. }));
+    let before = agent_request(&mut peers[0].node, 55, Request::Notes { goal, about: None });
+    println!("outsider notes before: {before:?}");
+    assert_eq!(
+        before.unwrap_err().code,
+        locust_proto::api::ErrorCode::NotFound
+    );
+    // Forge a ticket from public facts only: goal ID and coordinator key.
+    let attacker = EndpointId([0xEE; 32]);
+    let forged = Invitation {
+        version: locust_proto::PROTOCOL_VERSION,
+        goal,
+        coordinator,
+        endpoint: attacker,
+        hints: vec![],
+        secret: InviteSecret([0x42; 32]),
+        expires_ms: None,
+    }
+    .to_ticket()
+    .unwrap();
+    let joined = agent_request(&mut peers[0].node, 55, Request::GoalJoin { ticket: forged });
+    println!("outsider join: {joined:?}");
+    let after = agent_request(&mut peers[0].node, 55, Request::Notes { goal, about: None });
+    println!("outsider notes after: {after:?}");
+    let Ok(Response::Notes(notes)) = after else {
+        panic!("outsider could not read");
+    };
+    assert_eq!(notes[0].text.as_deref(), Some("private note for members only"));
+    let _ = outsider;
+
+    // The daemon now dials the forged endpoint and reconciles the held goal with it.
+    let mut out = vec![];
+    peers[0].node.peer(PeerInput::Poll, 50_000, &mut out);
+    let opened = out.iter().find_map(|o| match o {
+        PeerOutput::Open { exchange, endpoint, .. } if *endpoint == attacker => Some(*exchange),
+        _ => None,
+    });
+    let exchange = opened.expect("daemon dials the forged endpoint");
+    let mut sent = vec![];
+    let feed = |node: &mut Node<MemStore, Random>, input: PeerInput, sent: &mut Vec<SyncMessage>| {
+        let mut queue = VecDeque::from([input]);
+        while let Some(input) = queue.pop_front() {
+            let mut out = vec![];
+            node.peer(input, 50_001, &mut out);
+            for o in out {
+                if let PeerOutput::Send { frame, exchange } = o {
+                    sent.push(frame);
+                    queue.push_back(PeerInput::Writable(exchange));
+                }
+            }
+        }
+    };
+    feed(&mut peers[0].node, PeerInput::Opened(exchange), &mut sent);
+    // The forged endpoint answers Join with an empty frontier, as an admission would.
+    feed(
+        &mut peers[0].node,
+        PeerInput::Frame { exchange, frame: SyncMessage::Frontier(Frontier::default()) },
+        &mut sent,
+    );
+    feed(
+        &mut peers[0].node,
+        PeerInput::Frame { exchange, frame: SyncMessage::Frontier(Frontier::default()) },
+        &mut sent,
+    );
+    for frame in &sent {
+        match frame {
+            SyncMessage::Events(events) => println!("SENT to forged endpoint: Events x{}", events.len()),
+            SyncMessage::Frontier(f) => println!("SENT to forged endpoint: Frontier with {} authors", f.authors.len()),
+            other => println!("SENT to forged endpoint: {}", match other { SyncMessage::Hello{..} => "Hello", SyncMessage::Join(_) => "Join", SyncMessage::KeyRequest{..} => "KeyRequest", SyncMessage::Done => "Done", _ => "other" }),
+        }
+    }
+    let pushed: usize = sent
+        .iter()
+        .map(|f| if let SyncMessage::Events(e) = f { e.len() } else { 0 })
+        .sum();
+    let held = peers[0].store.log(&goal, 0, usize::MAX).unwrap().len();
+    println!("events pushed to forged endpoint: {pushed} of {held} held");
+    assert!(pushed > 0);
+}
+
+fn drive(node: &mut Node<MemStore, Random>, input: PeerInput, now: u64, sent: &mut Vec<locust_proto::sync::SyncMessage>) -> Vec<PeerOutput> {
+    let mut queue = VecDeque::from([input]);
+    let mut other = vec![];
+    while let Some(input) = queue.pop_front() {
+        let mut out = vec![];
+        node.peer(input, now, &mut out);
+        for o in out {
+            match o {
+                PeerOutput::Send { frame, exchange } => {
+                    sent.push(frame);
+                    queue.push_back(PeerInput::Writable(exchange));
+                }
+                o => other.push(o),
+            }
+        }
+    }
+    other
+}
