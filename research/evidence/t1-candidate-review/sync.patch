+/// A peer that pipelines requests without reading answers: how much does the
+/// responder queue before the transport reports capacity?
+#[test]
+fn review_responder_queue_under_unread_pipelined_requests() {
+    let founded = Founded::new();
+    let notes = founded.notes(&mut Author::new(2), 10);
+    let ids: Vec<EventId> = notes.iter().map(Event::id).collect();
+    let mut host = host(1, founded.replica(&notes), &[1, 2]);
+    let mut responder = Responder::new(endpoint(2));
+    let mut out = Vec::new();
+    responder.receive(&mut host, hello(founded.goal), 0, &mut out);
+    let request = SyncMessage::EventRequest(vec![ids[0]; MAX_INVENTORY_POINTS]);
+    let request_bytes = codec::encode(&request).unwrap().len();
+    for _ in 0..1000 {
+        responder.receive(&mut host, request.clone(), 0, &mut out);
+    }
+    // Only one frame left; the rest is queued as work.
+    eprintln!(
+        "frames emitted: {}, request bytes received: {}, queued answers owed: {}",
+        out.len(),
+        1000 * request_bytes,
+        format!("{:?}", responder).len()
+    );
+    // Every answer is still owed: drain and count.
+    let mut frames = out.len();
+    loop {
+        let before = out.len();
+        responder.writable(&mut host, &mut out);
+        if out.len() == before {
+            break;
+        }
+        frames = out.len();
+    }
+    eprintln!("frames owed in total: {frames}");
+}
