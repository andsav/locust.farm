+#[test]
+fn verify_inflated_total_wedges_the_object() {
+    use crate::sync::{Host, Initiator};
+    use locust_proto::event::Body;
+    use locust_proto::limits::BLOB_CHUNK_BYTES;
+    use locust_proto::sync::SyncMessage;
+    let mut peers = [Peer::new(1), Peer::new(2), Peer::new(3)];
+    let goal = found(&mut peers);
+    peers[0].call(Request::NoteAdd {
+        goal,
+        about: None,
+        supersedes: None,
+        text: "wedge".into(),
+    });
+    let event = peers[0]
+        .store
+        .log(&goal, 0, usize::MAX)
+        .unwrap()
+        .into_iter()
+        .map(|(_, event)| event)
+        .filter(|event| matches!(event.header().body, Body::Note { .. }))
+        .last()
+        .unwrap();
+    let payload = event.header().payload.unwrap();
+    let hash = payload.hash;
+    // Peer 1 receives the event but not the object.
+    Host::replica(&mut peers[1].node, &goal)
+        .unwrap()
+        .receive(vec![event.to_wire()])
+        .unwrap();
+    // Peer 1's initiator against a faulty responder.
+    let mut init = Initiator::new(goal);
+    let mut out = Vec::new();
+    init.start(Host::replica(&mut peers[1].node, &goal).unwrap(), &mut out);
+    let drain = |init: &mut Initiator, peers: &mut [Peer], out: &mut Vec<SyncMessage>| loop {
+        let before = out.len();
+        init.writable(Host::replica(&mut peers[1].node, &goal).unwrap(), out);
+        if out.len() == before {
+            break;
+        }
+    };
+    drain(&mut init, &mut peers, &mut out);
+    let frontier = Host::replica(&mut peers[1].node, &goal).unwrap().frontier();
+    init.receive(
+        Host::replica(&mut peers[1].node, &goal).unwrap(),
+        SyncMessage::Frontier(frontier),
+        &mut out,
+    );
+    drain(&mut init, &mut peers, &mut out);
+    assert!(out.iter().any(|frame| matches!(frame, SyncMessage::BlobRequest { hash: asked, offset: 0 } if *asked == hash)), "{out:?}");
+    let chunk = SyncMessage::BlobChunk {
+        hash,
+        offset: 0,
+        total: 4 << 20,
+        bytes: vec![0; BLOB_CHUNK_BYTES],
+    };
+    let wire = locust_proto::codec::encode(&chunk).unwrap();
+    assert!(SyncMessage::decode(&wire).is_ok(), "the chunk passes decode");
+    init.receive(Host::replica(&mut peers[1].node, &goal).unwrap(), chunk, &mut out);
+    drop(init); // the link drops
+    let staged = peers[1].store.staged_len(&hash).unwrap();
+    eprintln!("PROBE payload len {} ; staged after faulty chunk {staged}", payload.len);
+    let mut offsets = Vec::new();
+    let mut unavailable = 0;
+    for round in 0..6u64 {
+        if round == 3 {
+            peers[1].restart();
+        }
+        let sent = reconcile(&mut peers, 100_000 + round * 40_000);
+        for frame in &sent {
+            match frame {
+                SyncMessage::BlobRequest { hash: asked, offset } if *asked == hash => offsets.push(*offset),
+                SyncMessage::BlobUnavailable(given) if *given == hash => unavailable += 1,
+                _ => {}
+            }
+        }
+    }
+    let notes = |peer: &mut Peer| {
+        let Response::Notes(notes) = peer.call(Request::Notes { goal, about: None }) else {
+            panic!("notes");
+        };
+        notes
+            .into_iter()
+            .find(|note| note.note == event.id())
+            .map(|note| note.text)
+    };
+    eprintln!(
+        "PROBE offsets requested {offsets:?}; BlobUnavailable {unavailable}; peer1 holds {:?}; peer1 staged {}; peer2 holds {:?}; peer1 note text {:?}; peer2 note text {:?}",
+        peers[1].store.blob_len(&hash).unwrap(),
+        peers[1].store.staged_len(&hash).unwrap(),
+        peers[2].store.blob_len(&hash).unwrap(),
+        notes(&mut peers[1]),
+        notes(&mut peers[2]),
+    );
+}
