+struct Flow {
+    goal: GoalId,
+    c: Author,
+    head: EventId,
+    events: Vec<Event>,
+}
+
+impl Flow {
+    fn decide(&mut self, body: Body) -> Event {
+        let event = self.c.event(self.goal, Some(self.head), body);
+        self.head = event.id();
+        self.events.push(event.clone());
+        event
+    }
+    fn write(&mut self, who: &mut Author, body: Body) -> Event {
+        let event = who.event(self.goal, Some(self.head), body);
+        self.events.push(event.clone());
+        event
+    }
+    /// Proposes, assigns to `worker`, takes, submits against `base` and
+    /// accepts with `head`. Returns the proposal.
+    fn task(&mut self, proposer: &mut Author, worker: &mut Author, base: Option<u8>, head: u8) -> Event {
+        let task = self.write(proposer, propose());
+        let assignment = self.decide(Body::TaskAssigned {
+            task: task.id(),
+            assignee: worker.key.public(),
+            attempt: 1,
+        });
+        self.write(worker, Body::AssignmentAccepted { assignment: assignment.id() });
+        let result = self.write(
+            worker,
+            Body::ResultSubmitted {
+                assignment: assignment.id(),
+                base: base.map(|n| BlobHash([n; 32])),
+                patch: None,
+                artifacts: vec![],
+            },
+        );
+        self.decide(Body::ResultAccepted {
+            result: result.id(),
+            head: Some(BlobHash([head; 32])),
+        });
+        task
+    }
+}
