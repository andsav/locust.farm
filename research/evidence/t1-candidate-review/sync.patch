+                grants: Grants { manage_goals: true },
+                credential: Credential([5; 32]).digest(),
+            },
+        ) else {
+            panic!()
+        };
+        let Response::GoalCreated { goal } =
+            call(&mut node, Some(agent), Request::GoalCreate { title: "t".into() })
+        else {
+            panic!()
+        };
+        let started = std::time::Instant::now();
+        for n in 0..count {
+            call(
+                &mut node,
+                Some(agent),
+                Request::NoteAdd {
+                    goal,
+                    about: None,
+                    supersedes: None,
+                    text: format!("note {n}"),
+                },
+            );
+        }
+        let authoring = started.elapsed();
+        let replica = Host::replica(&mut node, &goal).unwrap();
+        let started = std::time::Instant::now();
+        for _ in 0..10 {
+            assert!(replica.next_wanted_blob(None).is_none());
+        }
+        let one = started.elapsed() / 10;
+        eprintln!(
+            "sqlite, notes {count}: one next_wanted_blob {one:?} (authoring took {authoring:?}); \
+             fetching all {count} payloads makes {count} such calls: about {:?}",
+            one * count as u32
+        );
+    }
+}
