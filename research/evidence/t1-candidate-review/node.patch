+/// A refused join: what the joiner sees afterwards, and whether the same
+/// principal can redeem a fresh ticket.
+#[test]
+fn probe_r3_refused_join_and_retry() {
+    let mut peers = [Peer::new(1), Peer::new(2)];
+    let Response::GoalCreated { goal } = peers[0].call(Request::GoalCreate { title: "retry".into() }) else {
+        panic!()
+    };
+    let Response::Invited { ticket: expired } = peers[0].call(Request::GoalInvite { goal, expires_ms: Some(100) }) else {
+        panic!()
+    };
+    let principal = peers[1].principal;
+    peers[1].call(Request::GoalJoin { ticket: expired.clone() });
+    reconcile(&mut peers, 1000);
+    println!("R3 same ticket again: {:?}", try_request(&mut peers[1].node, Some(principal), Request::GoalJoin { ticket: expired }));
+    let Response::Status(status) = peers[1].call(Request::Status) else { panic!() };
+    println!("R3 status after refusal: {:?}", status.goals);
+    println!("R3 goal.status after refusal: {:?}", try_request(&mut peers[1].node, Some(principal), Request::GoalStatus { goal }));
+    let Response::Invited { ticket } = peers[0].call(Request::GoalInvite { goal, expires_ms: None }) else {
+        panic!()
+    };
+    println!("R3 fresh ticket: {:?}", try_request(&mut peers[1].node, Some(principal), Request::GoalJoin { ticket }));
+    reconcile(&mut peers, 40000);
+    reconcile(&mut peers, 80000);
+    let Response::Status(status) = peers[1].call(Request::Status) else { panic!() };
+    println!("R3 status after fresh ticket: {:?}", status.goals);
+}
