+/// N1: on a daemon that holds a goal for one principal, a second local
+/// principal that was never admitted reads the goal's text (a) with a real
+/// ticket the inviter refuses as expired, (b) by replaying the ticket the
+/// first principal already redeemed.
+#[test]
+fn probe_n1_never_admitted_cohosted_principal_reads_text() {
+    use locust_proto::api::Membership;
+    for replay in [false, true] {
+        let mut peers = [Peer::new(1), Peer::new(2)];
+        let intruder = enroll_second(&mut peers[1], "intruder", 5);
+        let Response::GoalCreated { goal } = peers[0].call(Request::GoalCreate { title: "private".into() }) else { panic!() };
+        let Response::Invited { ticket: expired } = peers[0].call(Request::GoalInvite { goal, expires_ms: Some(100) }) else { panic!() };
+        let Response::Invited { ticket: valid } = peers[0].call(Request::GoalInvite { goal, expires_ms: None }) else { panic!() };
+        // The invited principal joins and is admitted.
+        peers[1].call(Request::GoalJoin { ticket: valid.clone() });
+        reconcile(&mut peers, 1000);
+        reconcile(&mut peers, 40000);
+        peers[0].call(note_req(goal, "members only"));
+        let Response::Recorded { event: task } = peers[0].call(Request::TaskPropose {
+            goal, text: "secret task".into(), input: None, depends_on: vec![], deadline_ms: None, max_attempts: None,
+        }) else { panic!() };
+        reconcile(&mut peers, 80000);
+        reconcile(&mut peers, 120000);
+        assert!(peers[1].node.goals[&goal].is_member(&peers[1].principal));
+        // Before: the goal does not exist for the other local principal.
+        let before = as_agent(&mut peers[1].node, 20, 5, Request::Notes { goal, about: None });
+        println!("N1 replay={replay} before: {:?}", before.as_ref().map(|_| "ok"));
+        assert_eq!(before.unwrap_err().code, locust_proto::api::ErrorCode::NotFound);
+        // It redeems a ticket the inviter will refuse.
+        let ticket = if replay { valid } else { expired };
+        let joined = as_agent(&mut peers[1].node, 21, 5, Request::GoalJoin { ticket: ticket.clone() });
+        println!("N1 replay={replay} join: {joined:?}");
+        let notes = as_agent(&mut peers[1].node, 22, 5, Request::Notes { goal, about: None });
+        println!("N1 replay={replay} notes right after goal.join: {notes:?}");
+        reconcile(&mut peers, 160000);
+        reconcile(&mut peers, 200000);
+        reconcile(&mut peers, 240000);
+        let join = &peers[1].node.goals[&goal].local.joins[&intruder];
+        println!(
+            "N1 replay={replay} inviter refused: {} member on inviter: {} member here: {}",
+            join.refused,
+            peers[0].node.goals[&goal].is_member(&intruder),
+            peers[1].node.goals[&goal].is_member(&intruder)
+        );
+        assert!(join.refused);
+        assert!(!peers[0].node.goals[&goal].is_member(&intruder));
+        println!("N1 replay={replay} membership: {:?}", peers[1].node.goals[&goal].membership(&intruder));
+        assert_eq!(peers[1].node.goals[&goal].membership(&intruder), Some(Membership::Joining));
+        let again = as_agent(&mut peers[1].node, 23, 5, Request::GoalJoin { ticket });
+        println!("N1 replay={replay} goal.join again: {again:?}");
+        // New content written after the refusal.
+        peers[0].call(note_req(goal, "written after the refusal"));
+        reconcile(&mut peers, 280000);
+        reconcile(&mut peers, 320000);
+        let notes = as_agent(&mut peers[1].node, 24, 5, Request::Notes { goal, about: None });
+        println!("N1 replay={replay} notes after refusal: {notes:?}");
+        let shown = as_agent(&mut peers[1].node, 25, 5, Request::Task { goal, task });
+        println!("N1 replay={replay} task.show after refusal: {:?}", shown.map(|r| match r { Response::Task(t) => t.text, _ => None }));
+        let status = as_agent(&mut peers[1].node, 26, 5, Request::GoalStatus { goal });
+        println!("N1 replay={replay} goal.status: {:?}", status.map(|_| "ok"));
+        // Survives a restart.
+        peers[1].restart();
+        let notes = as_agent(&mut peers[1].node, 27, 5, Request::Notes { goal, about: None });
+        println!("N1 replay={replay} notes after restart: {:?}", notes.map(|r| match r { Response::Notes(n) => n.into_iter().map(|n| n.text).collect::<Vec<_>>(), _ => vec![] }));
+    }
+}
