+#[test]
+fn p5_failed_insert_after_rename_uses_up_the_staged_copy() {
+    let root = tempfile::tempdir().unwrap();
+    let dir = root.path().join("state");
+    let large = Blob::new((0..INLINE_MAX_BYTES + 5).map(|n| (n % 241) as u8).collect());
+    let (hash, bytes) = (large.hash(), large.bytes());
+    let mut store = SqliteStore::open(&dir).unwrap();
+    assert_eq!(store.stage_blob(&hash, 0, bytes), Ok(bytes.len() as u64));
+    // Any error from the row's INSERT (an I/O error reading the index, say).
+    store
+        .connection()
+        .execute_batch(
+            "CREATE TEMP TRIGGER refuse BEFORE INSERT ON blobs WHEN NEW.len > 262144 \
+             BEGIN SELECT RAISE(ABORT, 'injected insert failure'); END;",
+        )
+        .unwrap();
+    let first = store.finish_blob(&hash);
+    eprintln!(
+        "[probe] finish_blob -> {first:?}; staged_len {:?}; blob_len {:?}; files {:?}",
+        store.staged_len(&hash),
+        store.blob_len(&hash),
+        files(&dir)
+    );
+    store.connection().execute_batch("DROP TRIGGER refuse;").unwrap();
+    let retry = store.finish_blob(&hash);
+    eprintln!(
+        "[probe] retry finish_blob -> {retry:?}; staged_len {:?}; blob_len {:?}; files {:?}",
+        store.staged_len(&hash),
+        store.blob_len(&hash),
+        files(&dir)
+    );
+    drop(store);
+    let store = SqliteStore::open(&dir).unwrap();
+    eprintln!(
+        "[probe] after reopen: staged_len {:?}; blob_len {:?}; files {:?}",
+        store.staged_len(&hash),
+        store.blob_len(&hash),
+        files(&dir)
+    );
+}
