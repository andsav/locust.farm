+/// The accepted side reports completion only after the transport confirms.
+#[test]
+fn review_accepted_completion_needs_finished() {
+    let founded = Founded::new();
+    let mut host = host(1, founded.replica(&[]), &[1, 2]);
+    let mut driver = Driver::new();
+    let exchange = ExchangeId::Accepted(7);
+    let mut out = Vec::new();
+    driver.handle(
+        &mut host,
+        PeerInput::Accepted {
+            exchange,
+            remote: endpoint(2),
+        },
+        0,
+        &mut out,
+    );
+    driver.handle(
+        &mut host,
+        PeerInput::Frame {
+            exchange,
+            frame: hello(founded.goal),
+        },
+        0,
+        &mut out,
+    );
+    assert_eq!(out, [PeerOutput::Admit(exchange)]);
+    out.clear();
+    driver.handle(
+        &mut host,
+        PeerInput::Frame {
+            exchange,
+            frame: SyncMessage::Done,
+        },
+        0,
+        &mut out,
+    );
+    assert_eq!(out, [PeerOutput::Finish(exchange)]);
+    assert!(host.reports.is_empty());
+    driver.handle(&mut host, PeerInput::Closed(exchange), 0, &mut out);
+    assert_eq!(host.reports.len(), 1);
+    assert_eq!(host.reports[0].ended, Ended::Aborted);
+}
