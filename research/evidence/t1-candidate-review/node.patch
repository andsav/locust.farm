+/// Halt: fork the coordinator's log, then try every signing path.
+#[test]
+fn probe_r2_nothing_is_signed_for_a_halted_goal() {
+    use crate::sync::Host;
+    use locust_proto::event::Body;
+    use locust_proto::invite::{Invitation, JoinRequest};
+    let mut peers = [Peer::new(1), Peer::new(2), Peer::new(3)];
+    let Response::GoalCreated { goal } = peers[0].call(Request::GoalCreate { title: "halting".into() }) else {
+        panic!()
+    };
+    let Response::Invited { ticket } = peers[0].call(Request::GoalInvite { goal, expires_ms: None }) else {
+        panic!()
+    };
+    peers[1].call(Request::GoalJoin { ticket });
+    reconcile(&mut peers, 1000);
+    reconcile(&mut peers, 40000);
+    // An outstanding invitation for peer 3.
+    let Response::Invited { ticket: later } = peers[0].call(Request::GoalInvite { goal, expires_ms: None }) else {
+        panic!()
+    };
+    // A task assigned to peer 2, unclaimed.
+    let Response::Recorded { event: task } = peers[0].call(Request::TaskPropose {
+        goal, text: "t".into(), input: None, depends_on: vec![], deadline_ms: None, max_attempts: None,
+    }) else { panic!() };
+    let assignee = peers[1].principal;
+    let Response::Recorded { event: assignment } = peers[0].call(Request::TaskAssign { goal, task, assignee }) else {
+        panic!()
+    };
+    reconcile(&mut peers, 80000);
+    // The coordinator's key signs a second, different decision at its next position.
+    let fork = reference_event(&peers[0], goal, None, Body::CancelRequested { assignment });
+    let Response::Recorded { .. } = peers[0].call(Request::TaskAssign { goal, task, assignee }) else {
+        panic!()
+    };
+    for index in [0, 1] {
+        let replica = Host::replica(&mut peers[index].node, &goal).unwrap();
+        println!("R2 fork received by {index}: {:?}", replica.receive(vec![fork.to_wire()]));
+        peers[index].node.replica_goal = None;
+    }
+    reconcile(&mut peers, 120000);
+    reconcile(&mut peers, 160000);
+    for index in [0, 1] {
+        println!("R2 peer {index} halt: {:?}", peers[index].node.goals[&goal].goal.halt().is_some());
+    }
+    let count = |peer: &Peer| peer.store.log(&goal, 0, usize::MAX).unwrap().len();
+    let before = [count(&peers[0]), count(&peers[1])];
+    let coordinator = peers[0].principal;
+    let member = peers[1].principal;
+    let attempts: Vec<(usize, PublicKey, Request)> = vec![
+        (0, coordinator, Request::NoteAdd { goal, about: None, supersedes: None, text: "x".into() }),
+        (0, coordinator, Request::GoalInvite { goal, expires_ms: None }),
+        (0, coordinator, Request::TaskAssign { goal, task, assignee: member }),
+        (0, coordinator, Request::MemberRemove { goal, member }),
+        (0, coordinator, Request::GoalLeave { goal }),
+        (1, member, Request::NoteAdd { goal, about: None, supersedes: None, text: "x".into() }),
+        (1, member, Request::TaskDecline { goal, assignment }),
+        (1, member, Request::GoalLeave { goal }),
+        (1, member, Request::TaskPropose { goal, text: "t".into(), input: None, depends_on: vec![], deadline_ms: None, max_attempts: None }),
+        (1, member, Request::DocRevise { goal, doc: locust_proto::event::Doc::Plan, base: None, text: "p".into() }),
+        (1, member, Request::BlobPut { goal, bytes: b"abc".to_vec() }),
+    ];
+    for (index, principal, operation) in attempts {
+        let name = operation.name();
+        let answer = try_request(&mut peers[index].node, Some(principal), operation);
+        println!("R2 {name} on peer {index}: {:?}", answer.map(|_| "ok"));
+    }
+    // A join for the outstanding invitation.
+    let invite = Invitation::from_ticket(later.as_str()).unwrap();
+    let join = JoinRequest::sign(
+        goal,
+        peers[2].endpoint,
+        invite.secret,
+        peers[2].node.signer(&peers[2].principal).unwrap(),
+    );
+    let endpoint = peers[2].endpoint;
+    println!("R2 join while halted: {:?}", Host::join(&mut peers[0].node, &endpoint, &join, 170000));
+    println!("R2 events before {before:?} after {:?}", [count(&peers[0]), count(&peers[1])]);
+    let Response::Status(status) = peers[1].call(Request::Status) else { panic!() };
+    println!("R2 status on peer 1: {:?}", status.goals);
+}
