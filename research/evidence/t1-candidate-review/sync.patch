+/// Review probe (real node): a stranger's exchange about a held goal and
+/// about an unknown goal produce identical outputs, for every request kind.
+#[test]
+fn review_real_node_stranger_learns_nothing() {
+    use locust_proto::id::{BlobHash, EventId};
+    use locust_proto::invite::JoinRequest;
+    use locust_proto::sync::{Frontier, SyncMessage};
+    let mut peers = [Peer::new(1), Peer::new(2)];
+    let goal = found(&mut peers);
+    let stranger = EndpointId([77; 32]);
+    let member_endpoint = peers[1].endpoint;
+    let key = locust_proto::testkit::keypair(55);
+    let secret: locust_proto::invite::InviteSecret = locust_proto::codec::decode(&[9u8; 32]).unwrap();
+    let unknown = GoalId([0x42; 32]);
+    let mut number = 5_000_000u64;
+    let mut run = |peer: &mut Peer, remote: EndpointId, frames: Vec<SyncMessage>| {
+        number += 1;
+        let exchange = ExchangeId::Accepted(number);
+        let mut all = Vec::new();
+        let mut out = Vec::new();
+        peer.node.peer(PeerInput::Accepted { exchange, remote }, 50_000, &mut out);
+        all.extend(out.drain(..));
+        for frame in frames {
+            peer.node.peer(PeerInput::Frame { exchange, frame }, 50_000, &mut out);
+            all.extend(out.drain(..));
+            for _ in 0..4 {
+                peer.node.peer(PeerInput::Writable(exchange), 50_000, &mut out);
+                all.extend(out.drain(..));
+            }
+        }
+        peer.node.peer(PeerInput::Closed(exchange), 50_000, &mut out);
+        all.extend(out.drain(..));
+        all.into_iter()
+            .map(|output| match output {
+                PeerOutput::Send { frame, .. } => format!("{frame:?}"),
+                other => format!("{:?}", std::mem::discriminant(&other)),
+            })
+            .collect::<Vec<_>>()
+    };
+    let requests = |g: GoalId| {
+        vec![
+            SyncMessage::Frontier(Frontier::default()),
+            SyncMessage::InventoryRequest { author: peers_principal(), after: None },
+            SyncMessage::EventRequest(vec![EventId([1; 32])]),
+            SyncMessage::KeyRequest { epoch: 0 },
+            SyncMessage::BlobRequest { hash: BlobHash([1; 32]), offset: 0 },
+            SyncMessage::Events(vec![]),
+            SyncMessage::Join(JoinRequest::sign(g, stranger, secret, &key)),
+            SyncMessage::Join(JoinRequest::sign(g, EndpointId([78; 32]), secret, &key)),
+            SyncMessage::Hello { version: locust_proto::PROTOCOL_VERSION, goal: g },
+        ]
+    };
+    fn peers_principal() -> PublicKey {
+        locust_proto::testkit::keypair(3).public()
+    }
+    for (known, other) in requests(goal).into_iter().zip(requests(unknown)) {
+        let hello = |g| SyncMessage::Hello { version: locust_proto::PROTOCOL_VERSION, goal: g };
+        let a = run(&mut peers[0], stranger, vec![hello(goal), known.clone()]);
+        let b = run(&mut peers[0], stranger, vec![hello(unknown), other]);
+        eprintln!("{:.40}: held goal {a:?} / unknown goal {b:?}", format!("{known:?}"));
+        assert_eq!(a, b);
+    }
+    // A member's hello is admitted; a member asking about an unknown goal is not.
+    let hello = |g| SyncMessage::Hello { version: locust_proto::PROTOCOL_VERSION, goal: g };
+    let a = run(&mut peers[0], member_endpoint, vec![hello(unknown), SyncMessage::Frontier(Frontier::default())]);
+    eprintln!("member about unknown goal: {a:?}");
+}
