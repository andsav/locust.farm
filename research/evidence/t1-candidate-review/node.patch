+/// H7: waits and revisions for every local record that feeds pending work.
+#[test]
+fn probe_h7_revision_moves_for_each_pending_input() {
+    let (mut daemon, principal, owner, agent, goal) = setup();
+    let rev = |daemon: &mut Daemon| pending(daemon, agent, goal).revision;
+    let mut last = rev(&mut daemon);
+    let mut check = |daemon: &mut Daemon, what: &str, last: &mut u64| {
+        let now = pending(daemon, agent, goal).revision;
+        println!("H7 {what}: revision {last} -> {now}");
+        assert!(now > *last, "{what} did not move the revision");
+        *last = now;
+    };
+    let (_, assignment) = assigned(&mut daemon, agent, goal, principal);
+    check(&mut daemon, "propose+assign", &mut last);
+    daemon.ok(
+        owner,
+        Request::TaskAuthorize {
+            goal,
+            assignment,
+            takeover: false,
+        },
+    );
+    check(&mut daemon, "authorize", &mut last);
+    daemon.ok(agent, Request::TaskClaim { goal, assignment });
+    check(&mut daemon, "claim", &mut last);
+    daemon.ok(
+        owner,
+        Request::GoalGrant {
+            goal,
+            agent: principal,
+            grants: locust_proto::api::GoalGrants {
+                execute: true,
+                decide: true,
+                takeover: true,
+            },
+        },
+    );
+    check(&mut daemon, "goal.grant", &mut last);
+    let b = daemon.connect(credential(1), Some(session(2)));
+    daemon.ok(b, Request::TaskTakeover { goal, assignment });
+    check(&mut daemon, "takeover", &mut last);
+
+    // A wait parked with the current revision is answered by a takeover.
+    let frame = daemon.frame(Request::Wait {
+        goal,
+        seen: last,
+        timeout_ms: 1000,
+    });
+    let Step::Park(parked) = daemon.step(b, frame, 100) else {
+        panic!()
+    };
+    daemon.ok(agent, Request::TaskTakeover { goal, assignment });
+    assert!(daemon.node.take_changed().contains(&goal));
+    let Step::Reply(reply) = daemon.node.resume(b, &parked, false, 101) else {
+        panic!("still parked after a takeover")
+    };
+    let Response::Waited(WaitOutcome::Work(work)) = reply.result.unwrap() else {
+        panic!()
+    };
+    println!("H7 wait after takeover: {work:?}");
+    assert_eq!(work.held_elsewhere.len(), 1);
+    // seen: 0 answers at once.
+    let frame = daemon.frame(Request::Wait {
+        goal,
+        seen: 0,
+        timeout_ms: 1000,
+    });
+    assert!(matches!(daemon.step(b, frame, 100), Step::Reply(_)));
+    // A wait on a goal the caller is not in.
+    daemon.enroll("other", 2, true);
+    let other = daemon.connect(credential(2), None);
+    let frame = daemon.frame(Request::Wait {
+        goal,
+        seen: 0,
+        timeout_ms: 1000,
+    });
+    let Step::Reply(reply) = daemon.step(other, frame, 100) else {
+        panic!()
+    };
+    assert_eq!(code(reply.result), ErrorCode::NotFound);
+}
