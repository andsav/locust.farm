+/// G4: to a principal that never took part, and to its viewer, a goal held
+/// for another local principal does not exist, whatever the operation.
+#[test]
+fn probe_g4_other_goals_do_not_exist() {
+    use locust_proto::event::CancelOutcome;
+    let (mut daemon, principal, owner, agent, goal) = setup();
+    daemon.ok(agent, note(goal, "private"));
+    let (task, assignment) = assigned(&mut daemon, agent, goal, principal);
+    let Response::BlobStored { hash } = daemon.ok(agent, Request::BlobPut { goal, bytes: b"x".to_vec() }) else { panic!() };
+    let other = daemon.enroll("other", 2, true);
+    daemon.ok(owner, Request::ViewerEnroll { agent: other, credential: credential(8).digest() });
+    let outsider = daemon.connect(credential(2), Some(session(7)));
+    let viewer = daemon.connect(credential(8), None);
+    let reads = |goal| {
+        vec![
+            Request::GoalStatus { goal },
+            Request::Board { goal },
+            Request::Task { goal, task },
+            Request::Event { goal, event: task },
+            Request::Pending { goal },
+            Request::Events { goal, after: None, limit: 10 },
+            Request::Events { goal, after: Some(0), limit: 10 },
+            Request::Notes { goal, about: None },
+            Request::DocRead { goal, doc: Doc::Plan },
+            Request::BlobGet { goal, hash },
+            Request::BlobStat { goal, hashes: vec![hash] },
+            Request::Wait { goal, seen: 0, timeout_ms: 0 },
+        ]
+    };
+    let writes = vec![
+        Request::GoalInvite { goal, expires_ms: None },
+        Request::GoalLeave { goal },
+        Request::MemberRemove { goal, member: principal },
+        Request::WorkspaceSet { goal, binding: Default::default() },
+        Request::TaskPropose { goal, text: "x".into(), input: None, depends_on: vec![], deadline_ms: None, max_attempts: None },
+        Request::TaskAssign { goal, task, assignee: other },
+        Request::TaskCancel { goal, assignment },
+        Request::TaskClaim { goal, assignment },
+        Request::TaskTakeover { goal, assignment },
+        Request::TaskDecline { goal, assignment },
+        Request::TaskProgress { goal, assignment, generation: 1, text: "x".into() },
+        Request::TaskFail { goal, assignment, generation: 1, reason: "x".into() },
+        Request::CancelAcknowledge { goal, cancel: assignment, generation: None, outcome: CancelOutcome::Stopped },
+        Request::ResultAccept { goal, result: task, head: None },
+        Request::ResultReject { goal, result: task, reason: "x".into() },
+        note(goal, "x"),
+        Request::DocRevise { goal, doc: Doc::Plan, base: None, text: "x".into() },
+        Request::DocAccept { goal, revision: task },
+        Request::BlobPut { goal, bytes: b"y".to_vec() },
+        Request::BlobWithdraw { goal, hash },
+    ];
+    let events_before = daemon.store.log(&goal, 0, 1000).unwrap().len();
+    let cursors_before = daemon.store.scan(Space::Cursor, &[]).unwrap().len();
+    let blobs_before = daemon.store.scan(Space::Blob, &[]).unwrap().len();
+    for request in reads(goal) {
+        let name = request.name();
+        for conn in [outsider, viewer] {
+            let frame = daemon.frame(request.clone());
+            let Step::Reply(reply) = daemon.step(conn, frame, 10) else { panic!("{name} parked") };
+            assert_eq!(code(reply.result), ErrorCode::NotFound, "{name}");
+        }
+    }
+    for request in writes {
+        let name = request.name();
+        assert_eq!(code(daemon.call(outsider, request.clone())), ErrorCode::NotFound, "{name}");
+        assert_eq!(code(daemon.call(viewer, request)), ErrorCode::Denied, "{name}");
+    }
+    assert_eq!(daemon.store.log(&goal, 0, 1000).unwrap().len(), events_before);
+    assert_eq!(daemon.store.scan(Space::Cursor, &[]).unwrap().len(), cursors_before);
+    assert_eq!(daemon.store.scan(Space::Blob, &[]).unwrap().len(), blobs_before);
+    // status lists nothing of it, sessions of the other principal are invisible.
+    let Response::Status(status) = daemon.ok(outsider, Request::Status) else { panic!() };
+    assert!(status.goals.is_empty() && status.agents.len() == 1);
+    let Response::Sessions(sessions) = daemon.ok(outsider, Request::Sessions) else { panic!() };
+    assert!(sessions.is_empty());
+    assert_eq!(
+        code(daemon.call(outsider, Request::Session { instance: Some(session(1).instance()) })),
+        ErrorCode::NotFound
+    );
+    assert_eq!(
+        code(daemon.call(outsider, Request::SessionDrop { instance: session(1).instance() })),
+        ErrorCode::Denied
+    );
+    // The owner, directly, reads it; a viewer of the member reads it and stores nothing.
+    for request in reads(goal) {
+        let name = request.name();
+        let frame = daemon.frame(request);
+        let Step::Reply(reply) = daemon.step(owner, frame, 10) else { panic!("{name} parked") };
+        assert!(reply.result.is_ok(), "{name}: {:?}", reply.result);
+    }
+    println!("G4 ok");
+}
