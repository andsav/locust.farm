+        let t = m.emit(goal, Some(admit.id()), propose(), None);
+        let broken = c.emit(goal, Some(own.id()), Body::TaskAssigned { task: t.id(), assignee: m.public(), attempt: 1 }, None);
+        let after = c.emit(goal, Some(broken.id()), Body::CancelRequested { assignment: broken.id() }, None);
+        let n = m.emit(goal, Some(broken.id()), note(), None);
+        let n2 = m.emit(goal, Some(admit.id()), note(), None);
+        exhaust("broken chain", goal, &[g, own, admit, t, broken, after, n, n2]);
