+fn as_agent(node: &mut Node<MemStore, Random>, conn: u64, seed: u8, operation: Request) -> Result<Response, locust_proto::api::ApiError> {
+    let hello = ClientHello {
+        api_version: locust_proto::API_VERSION,
+        credential: Credential([seed; 32]),
+        session: None,
+    };
+    assert!(matches!(node.connect(ConnId(conn), &hello, 0), ServerHello::Welcome { .. }));
+    match node.request(
+        ConnId(conn),
+        RequestFrame { id: 1, idempotency: None, on_behalf: None, request: operation },
+        10,
+    ) {
+        Step::Reply(reply) => reply.result,
+        Step::Park(_) => panic!("unexpected wait"),
+    }
+}
+
+fn try_request(
+    node: &mut Node<MemStore, Random>,
+    principal: Option<PublicKey>,
+    operation: Request,
+) -> Result<Response, locust_proto::api::ApiError> {
+    match node.request(
+        ConnId(1),
+        RequestFrame { id: 1, idempotency: None, on_behalf: principal, request: operation },
+        10,
+    ) {
+        Step::Reply(reply) => reply.result,
+        Step::Park(_) => panic!("unexpected wait"),
+    }
+}
