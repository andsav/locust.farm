+/// G1: goal grants and authorizations are per goal and per assignment.
+#[test]
+fn probe_g1_grants_are_per_goal_and_per_assignment() {
+    use locust_proto::api::GoalGrants;
+    let (mut daemon, principal, owner, agent, g1) = setup();
+    let Response::GoalCreated { goal: g2 } = daemon.ok(agent, Request::GoalCreate { title: "second".into() }) else { panic!() };
+    daemon.ok(owner, Request::GoalGrant { goal: g1, agent: principal, grants: GoalGrants { execute: true, decide: true, takeover: true } });
+    let (task2, x) = assigned(&mut daemon, agent, g2, principal);
+    // execute in g1 does not cover g2.
+    assert_eq!(code(daemon.call(agent, Request::TaskClaim { goal: g2, assignment: x })), ErrorCode::AuthorizationRequired);
+    let work = pending(&mut daemon, agent, g2);
+    assert_eq!((work.to_authorize.len(), work.to_claim.len()), (1, 0));
+    // The owner sees it too, directly.
+    assert_eq!(pending(&mut daemon, owner, g2).to_authorize.len(), 1);
+    // An authorization names one assignment of one goal.
+    assert_eq!(code(daemon.call(owner, Request::TaskAuthorize { goal: g1, assignment: x, takeover: false })), ErrorCode::NotFound);
+    daemon.ok(owner, Request::TaskAuthorize { goal: g2, assignment: x, takeover: false });
+    let Response::Claimed(claim) = daemon.ok(agent, Request::TaskClaim { goal: g2, assignment: x }) else { panic!() };
+    assert_eq!(claim.generation, 1);
+    // takeover in g1 does not cover g2, and the authorization had no takeover.
+    let b = daemon.connect(credential(1), Some(session(2)));
+    assert_eq!(code(daemon.call(b, Request::TaskTakeover { goal: g2, assignment: x })), ErrorCode::AuthorizationRequired);
+    // A reassignment is a new assignment: the authorization does not follow.
+    let y = event(daemon.ok(agent, Request::TaskAssign { goal: g2, task: task2, assignee: principal }));
+    assert_eq!(code(daemon.call(agent, Request::TaskClaim { goal: g2, assignment: y })), ErrorCode::AuthorizationRequired);
+    // The old one is superseded, for its holder too.
+    assert_eq!(code(daemon.call(agent, Request::TaskClaim { goal: g2, assignment: x })), ErrorCode::Superseded);
+    assert_eq!(
+        code(daemon.call(agent, Request::TaskProgress { goal: g2, assignment: x, generation: 1, text: "late".into() })),
+        ErrorCode::Superseded
+    );
+    // decide removed in g2 only.
+    daemon.ok(owner, Request::GoalGrant { goal: g2, agent: principal, grants: GoalGrants::default() });
+    assert_eq!(
+        code(daemon.call(agent, Request::TaskAssign { goal: g2, task: task2, assignee: principal })),
+        ErrorCode::AuthorizationRequired
+    );
+    let (_, z) = assigned(&mut daemon, agent, g1, principal);
+    daemon.ok(agent, Request::TaskClaim { goal: g1, assignment: z });
+    // The owner's act stands in for decide in g2.
+    daemon.on_behalf(owner, principal, Request::TaskAssign { goal: g2, task: task2, assignee: principal }).unwrap();
+    // One owner key, two principals: a different request.
+    let other = daemon.enroll("other", 2, true);
+    let mut first = daemon.frame(Request::GoalCreate { title: "k".into() });
+    first.idempotency = Some(IdempotencyKey([3; 16]));
+    first.on_behalf = Some(principal);
+    let mut second = first.clone();
+    second.on_behalf = Some(other);
+    let created = daemon.send(owner, first.clone()).unwrap();
+    assert_eq!(daemon.send(owner, first).unwrap(), created);
+    assert_eq!(code(daemon.send(owner, second)), ErrorCode::IdempotencyMismatch);
+    println!("G1 ok");
+}
