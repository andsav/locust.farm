+/// Feeds `events` in the order given, split into random batches, checking
+/// every property after every batch.
+pub fn feed(goal: GoalId, events: &[Event], rng: &mut Rng, deep: bool, max_batch: usize) -> (Goal, MemStore) {
+    let mut actual = Goal::new(goal);
+    let mut store = MemStore::new();
+    let mut at = 0;
+    while at < events.len() {
+        let size = 1 + rng.below(max_batch);
+        let batch = &events[at..(at + size).min(events.len())];
+        at += batch.len();
+        store
+            .commit(&Commit {
+                events: batch.to_vec(),
+                ..Commit::default()
+            })
+            .unwrap();
+        let before: BTreeMap<EventId, Standing> = actual
+            .history
+            .events
+            .iter()
+            .map(|event| (event.id(), actual.standing(&event.id()).unwrap()))
+            .collect();
+        let changes = actual.apply(batch);
+        let (scratch, _) = fold::fold(&actual.history);
+        assert_eq!(actual.folded, scratch, "incremental fold differs from a fold from scratch");
+        // `judged` is exactly the events that were absent or pending and are judged now.
+        let mut expected: Vec<EventId> = actual
+            .history
+            .events
+            .iter()
+            .map(|event| event.id())
+            .filter(|id| {
+                before.get(id).is_none_or(Standing::is_pending)
+                    && !actual.standing(id).unwrap().is_pending()
+            })
+            .collect();
+        expected.sort();
+        let mut judged = changes.judged.clone();
+        judged.sort();
+        assert_eq!(judged, expected, "judged list is not exactly the newly judged events");
+        if deep {
+            assert_eq!(
+                view(&actual),
+                view(&fresh(goal, &actual.history.events)),
+                "state after a prefix differs from a fresh goal over the same set"
+            );
+        }
+    }
+    (actual, store)
+}
