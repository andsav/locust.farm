+#[test]
+fn verify_empty_event_request_frame_count() {
+    let founded = Founded::new();
+    let notes = founded.notes(&mut Author::new(2), 3);
+    let mut host = host(1, founded.replica(&notes), &[1, 2]);
+    for count in [0usize, 1, 256, 257] {
+        let ids: Vec<EventId> = (0..count).map(|_| notes[0].id()).collect();
+        let mut responder = Responder::new(endpoint(2));
+        let mut out = Vec::new();
+        responder.receive(&mut host, hello(founded.goal), 0, &mut out);
+        responder.receive(&mut host, SyncMessage::EventRequest(ids), 0, &mut out);
+        loop {
+            let before = out.len();
+            responder.writable(&mut host, &mut out);
+            if out.len() == before {
+                break;
+            }
+        }
+        eprintln!("PROBE event request of {count} ids answered with {} frames: {:?}", out.len(),
+            out.iter().map(|f| match f { SyncMessage::Events(e) => e.len(), _ => usize::MAX }).collect::<Vec<_>>());
+    }
+}
