+/// Review probe: one member answers a BlobRequest with chunks claiming a
+/// larger total than the object has. The receiver stages them; afterwards
+/// every honest member is asked at the staged length, which is past the
+/// object's end, and answers BlobUnavailable forever.
+#[test]
+fn review_staged_prefix_longer_than_the_object_wedges_the_transfer() {
+    use crate::sync::{Host, Initiator};
+    use locust_proto::limits::BLOB_CHUNK_BYTES;
+    use locust_proto::sync::SyncMessage;
+    let mut peers = [Peer::new(1), Peer::new(2), Peer::new(3)];
+    let goal = found(&mut peers);
+    peers[0].call(Request::NoteAdd {
+        goal,
+        about: None,
+        supersedes: None,
+        text: "short note whose payload is a small sealed object".into(),
+    });
+    let note = peers[0]
+        .store
+        .log(&goal, 0, usize::MAX)
+        .unwrap()
+        .into_iter()
+        .map(|(_, event)| event)
+        .rfind(|event| event.header().payload.is_some())
+        .unwrap();
+    let payload = note.header().payload.unwrap();
+    let hash = payload.hash;
+    eprintln!("payload len {}", payload.len);
+    // Peer 1 learns the event (as from any member) but not the object yet.
+    let replica = Host::replica(&mut peers[1].node, &goal).unwrap();
+    assert_eq!(replica.receive(vec![note.to_wire()]), Ok(1));
+    // An exchange with a faulty member (peer 2's endpoint): drive the real
+    // initiator over peer 1's replica with that member's frames.
+    let replica = Host::replica(&mut peers[1].node, &goal).unwrap();
+    let mut initiator = Initiator::new(goal);
+    let mut out = Vec::new();
+    initiator.start(replica, &mut out);
+    initiator.writable(replica, &mut out);
+    initiator.writable(replica, &mut out);
+    let frontier = replica.frontier();
+    out.clear();
+    initiator.receive(replica, SyncMessage::Frontier(frontier), &mut out);
+    for _ in 0..4 {
+        initiator.writable(replica, &mut out);
+    }
+    let asked = out
+        .iter()
+        .find_map(|frame| match frame {
+            SyncMessage::BlobRequest { hash: h, offset } if *h == hash => Some(*offset),
+            _ => None,
+        })
+        .expect("the initiator asks for the payload");
+    assert_eq!(asked, 0);
+    let claimed = 4 * BLOB_CHUNK_BYTES as u64;
+    initiator.receive(
+        replica,
+        SyncMessage::BlobChunk {
+            hash,
+            offset: 0,
+            total: claimed,
+            bytes: vec![0; BLOB_CHUNK_BYTES],
+        },
+        &mut out,
+    );
+    // The faulty member's link drops here.
+    drop(initiator);
+    let staged = peers[1].store.staged_len(&hash).unwrap();
+    eprintln!("staged after faulty chunk: {staged}");
+    assert!(staged > u64::from(payload.len));
+    // Honest members serve it from now on, across restarts and hours.
+    let mut sent = Vec::new();
+    for round in 0..6u64 {
+        if round == 3 {
+            peers[1].restart();
+        }
+        sent.extend(reconcile(&mut peers, 100_000 + round * 40_000));
+    }
+    let requests: Vec<_> = sent
+        .iter()
+        .filter_map(|frame| match frame {
+            SyncMessage::BlobRequest { hash: h, offset } if *h == hash => Some(*offset),
+            _ => None,
+        })
+        .collect();
+    let unavailable = sent
+        .iter()
+        .filter(|frame| matches!(frame, SyncMessage::BlobUnavailable(h) if *h == hash))
+        .count();
+    eprintln!("requests for the object at offsets {requests:?}, BlobUnavailable answers {unavailable}");
+    let held = peers[1].store.blob_len(&hash).unwrap();
+    eprintln!("peer 1 holds the object: {:?}; staged {}", held, peers[1].store.staged_len(&hash).unwrap());
+    let Response::Notes(notes) = peers[1].call(Request::Notes { goal, about: None }) else {
+        panic!("notes");
+    };
+    eprintln!("peer 1 note text: {:?}", notes.iter().map(|n| n.text.clone()).collect::<Vec<_>>());
+    assert!(held.is_some(), "the object never arrives from honest members");
+}
