+#[test]
+fn v_coordinator_fork_below_an_admission() {
+    let mut c = Author::new(1);
+    let m2 = Author::new(2);
+    let m3 = Author::new(3);
+    let (genesis, own) = c.found_goal(EndpointId([1; 32]));
+    let id = genesis.header().goal;
+    let admit2 = c.event(
+        id,
+        Some(own.id()),
+        Body::MemberAdmitted {
+            member: m2.key.public(),
+            endpoint: EndpointId([2; 32]),
+        },
+    );
+    let n = c.event(id, Some(admit2.id()), note());
+    let admit3 = c.event(
+        id,
+        Some(admit2.id()),
+        Body::MemberAdmitted {
+            member: m3.key.public(),
+            endpoint: EndpointId([3; 32]),
+        },
+    );
+    let fork = variant(&c, &n, 0);
+    let mut goal = Goal::new(id);
+    goal.apply(&[genesis, own, admit2, n, admit3.clone()]);
+    println!(
+        "before: endpoints {:?} m3 member {}",
+        goal.state().endpoints.keys().map(|e| e.0[0]).collect::<Vec<_>>(),
+        goal.state().is_member(&m3.key.public())
+    );
+    let kept = goal.screen(vec![fork]);
+    goal.apply(&kept);
+    println!(
+        "after: halt {} endpoints {:?} m3 member {} admit3 {:?}",
+        goal.halt().is_some(),
+        goal.state().endpoints.keys().map(|e| e.0[0]).collect::<Vec<_>>(),
+        goal.state().is_member(&m3.key.public()),
+        goal.standing(&admit3.id())
+    );
+}
