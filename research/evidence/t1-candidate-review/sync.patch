+fn note_texts(peer: &mut Peer, goal: GoalId) -> Vec<Option<String>> {
+    let Response::Notes(notes) = peer.call(Request::Notes { goal, about: None }) else {
+        panic!("notes");
+    };
+    let mut texts: Vec<_> = notes.into_iter().map(|note| note.text).collect();
+    texts.sort();
+    texts
+}
