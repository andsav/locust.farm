+#[test]
+fn verify_next_wanted_blob_cost() {
+    use crate::sync::Host;
+    use locust_proto::event::Body;
+    for n in [250usize, 500, 1000, 2000] {
+        let mut peers = [Peer::new(1), Peer::new(2)];
+        let goal = found(&mut peers);
+        for k in 0..n {
+            peers[0].call(Request::NoteAdd {
+                goal,
+                about: None,
+                supersedes: None,
+                text: format!("note {k}"),
+            });
+        }
+        let events: Vec<_> = peers[0]
+            .store
+            .log(&goal, 0, usize::MAX)
+            .unwrap()
+            .into_iter()
+            .map(|(_, event)| event)
+            .filter(|event| matches!(event.header().body, Body::Note { .. }))
+            .collect();
+        for batch in events.chunks(200) {
+            Host::replica(&mut peers[1].node, &goal)
+                .unwrap()
+                .receive(batch.iter().map(|e| e.to_wire()).collect())
+                .unwrap();
+        }
+        let replica = Host::replica(&mut peers[1].node, &goal).unwrap();
+        let start = std::time::Instant::now();
+        let first = replica.next_wanted_blob(None);
+        let one = start.elapsed();
+        let start = std::time::Instant::now();
+        let mut cursor = None;
+        let mut calls = 0;
+        while let Some((hash, _)) = replica.next_wanted_blob(cursor) {
+            cursor = Some(hash);
+            calls += 1;
+        }
+        let all = start.elapsed();
+        assert!(first.is_some());
+        eprintln!("PROBE next_wanted_blob n={n}: one call {one:?}; {calls} successive calls {all:?}");
+    }
+}
