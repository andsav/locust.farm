+fn respond(
+    host: &mut TestHost,
+    remote: u8,
+    frames: Vec<SyncMessage>,
+) -> (Responder, Vec<SyncMessage>) {
+    let mut responder = Responder::new(endpoint(remote));
+    let mut out = Vec::new();
+    for frame in frames {
+        responder.receive(host, frame, 0, &mut out);
+        loop {
+            let before = out.len();
+            responder.writable(host, &mut out);
+            if out.len() == before {
+                break;
+            }
+        }
+    }
+    (responder, out)
+}
