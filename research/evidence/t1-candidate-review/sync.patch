+        assert!(matches!(
+            node.connect(
+                ConnId(1),
+                &ClientHello {
+                    api_version: locust_proto::API_VERSION,
+                    credential: OWNER,
+                    session: None
+                },
+                0
+            ),
+            ServerHello::Welcome { .. }
+        ));
+        node.peer(
+            PeerInput::Endpoint {
+                endpoint: EndpointId([5; 32]),
+                hints: vec![],
+            },
+            0,
+            &mut vec![],
+        );
+        let mut call = |node: &mut Node<SqliteStore, Random>, on_behalf, request| match node
+            .request(
+                ConnId(1),
+                RequestFrame {
+                    id: 1,
+                    idempotency: None,
+                    on_behalf,
