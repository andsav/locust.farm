+        peers[0].store.log(&goal, 0, usize::MAX).unwrap().len()
+    );
+    peers[0].restart();
+    println!("N4 task.assign after restart: {:?}", try_request(&mut peers[0].node, Some(coordinator), Request::TaskAssign { goal, task, assignee: member }).map(|_| "ok"));
