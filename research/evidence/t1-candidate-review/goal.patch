+/// Everything observable about a goal, in a form that does not depend on
+/// the order its events arrived in.
+#[derive(Debug, PartialEq)]
+pub struct View {
+    state: State,
+    halt: Option<Halt>,
+    standings: BTreeMap<EventId, Standing>,
+    authors: BTreeMap<PublicKey, (Vec<AuthorPoint>, u64, Option<u64>, AuthorFrontier, Option<Next>)>,
+    epochs: BTreeMap<EventId, Option<u32>>,
+    tasks: BTreeMap<EventId, Option<EventId>>,
+    applied: u32,
+    awaited: Option<EventId>,
+}
+
+pub fn view(goal: &Goal) -> View {
+    let mut standings = BTreeMap::new();
+    let mut epochs = BTreeMap::new();
+    let mut tasks = BTreeMap::new();
+    for event in &goal.history.events {
+        let id = event.id();
+        standings.insert(id, goal.standing(&id).unwrap());
+        epochs.insert(id, goal.epoch_of(&id));
+        tasks.insert(id, goal.task_of(&id));
+    }
+    let mut authors = BTreeMap::new();
+    let keys: Vec<PublicKey> = goal.authors().copied().collect();
+    for author in keys {
+        let points = goal.points(&author).to_vec();
+        let frontier = goal.frontier_of(&author);
+        assert_eq!(frontier, AuthorFrontier::from_points(author, &points), "frontier by lookup");
+        authors.insert(
+            author,
+            (
+                points,
+                goal.usable(&author),
+                goal.fork_point(&author),
+                frontier,
+                goal.next(&author),
+            ),
+        );
+    }
+    View {
+        state: goal.state().clone(),
+        halt: goal.halt().cloned(),
+        standings,
+        authors,
+        epochs,
+        tasks,
+        applied: goal.folded.applied,
+        awaited: goal.folded.awaited,
+    }
+}
+
+fn fresh(goal: GoalId, events: &[Event]) -> Goal {
+    let mut sorted = events.to_vec();
+    sorted.sort_by_key(|event| event.id());
+    let mut fresh = Goal::new(goal);
+    fresh.apply(&sorted);
+    fresh
+}
