+#[test]
+fn probe_removed_local_principal_reads_content_of_the_epoch_that_excludes_it() {
+    use crate::sync::Host;
+    let mut peers = [Peer::new(1), Peer::new(2)];
+    let goal = found(&mut peers);
+    let Response::AgentEnrolled { agent: second } = request(&mut peers[1].node, None, Request::AgentEnroll { name: "second".into(), grants: Grants { manage_goals: true }, credential: Credential([5; 32]).digest() }) else { panic!() };
+    let Response::Invited { ticket } = peers[0].call(Request::GoalInvite { goal, expires_ms: None }) else { panic!() };
+    request(&mut peers[1].node, Some(second), Request::GoalJoin { ticket });
+    reconcile(&mut peers, 40_000);
+    reconcile(&mut peers, 80_000);
+    assert!(peers[1].node.goals[&goal].is_member(&second));
+    peers[0].call(Request::MemberRemove { goal, member: second });
+    peers[0].call(Request::NoteAdd { goal, about: None, supersedes: None, text: "epoch one, not for the removed key".into() });
+    reconcile(&mut peers, 120_000);
+    reconcile(&mut peers, 160_000);
+    assert!(Host::replica(&mut peers[1].node, &goal).unwrap().key(1).is_some());
+    peers[1].node.connect(ConnId(55), &ClientHello { api_version: locust_proto::API_VERSION, credential: Credential([5; 32]), session: None }, 0);
+    let status = agent_request(&mut peers[1].node, 55, Request::Status).unwrap();
+    if let Response::Status(s) = status { println!("removed principal status: {:?}", s.goals.iter().map(|g| g.membership).collect::<Vec<_>>()); }
+    let notes = agent_request(&mut peers[1].node, 55, Request::Notes { goal, about: None });
+    println!("removed principal reads: {:?}", notes.map(|r| match r { Response::Notes(n) => n.iter().map(|n| n.text.clone()).collect::<Vec<_>>(), _ => vec![] }));
+}
