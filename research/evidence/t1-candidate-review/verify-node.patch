+//! verify-node probes: production Nodes driven through their public seams.
+#![allow(clippy::all)]
+use crate::node::Node;
+use locust_proto::api::{
+    ApiError, ClientHello, Credential, ErrorCode, GoalGrants, Grants, Membership, Request,
+    RequestFrame, Response, ServerHello,
+};
+use locust_proto::engine::{
+    ConnId, Engine, Entropy, ExchangeId, PeerEngine, PeerInput, PeerOutput, Step,
+};
+use locust_proto::id::{EndpointId, GoalId, PublicKey};
+use locust_proto::invite::{Invitation, InviteSecret};
+use locust_proto::store::{MemStore, Store};
+use locust_proto::sync::{Frontier, SyncMessage};
+use std::collections::{HashMap, HashSet, VecDeque};
+
+struct Random(u64);
+impl Entropy for Random {
+    fn fill(&mut self, bytes: &mut [u8]) {
+        self.0 += 1;
+        let hash = locust_proto::crypto::content_hash(&self.0.to_le_bytes());
+        for (i, byte) in bytes.iter_mut().enumerate() {
+            *byte = hash.0[i % 32] ^ (i / 32) as u8;
+        }
+    }
+}
+
+const OWNER: Credential = Credential([99; 32]);
+const FAKE: EndpointId = EndpointId([77; 32]);
+
+struct Peer {
+    node: Node<MemStore, Random>,
+    store: MemStore,
+    endpoint: EndpointId,
+    online: bool,
+    conn: u64,
+    restarts: u64,
+}
+
+impl Peer {
+    fn new(seed: u8) -> Self {
+        let store = MemStore::new();
+        let mut node = Node::open(
+            store.reopen(),
+            Random(u64::from(seed) * 10000),
+            OWNER.digest(),
+            "test".into(),
+            0,
+        )
+        .unwrap();
+        let endpoint = EndpointId([seed; 32]);
+        node.peer(
+            PeerInput::Endpoint {
+                endpoint,
+                hints: vec![],
+            },
+            0,
+            &mut vec![],
+        );
+        Self {
+            node,
+            store,
+            endpoint,
+            online: true,
+            conn: 0,
+            restarts: 0,
+        }
+    }
+    fn send(
+        &mut self,
+        cred: Credential,
+        on_behalf: Option<PublicKey>,
+        request: Request,
+    ) -> Result<Response, ApiError> {
+        self.conn += 1;
+        let conn = ConnId(self.conn);
+        let hello = self.node.connect(
+            conn,
+            &ClientHello {
+                api_version: locust_proto::API_VERSION,
+                credential: cred,
+                session: None,
+            },
+            10,
+        );
+        if let ServerHello::Refused { error, .. } = hello {
+            return Err(error);
+        }
+        let step = self.node.request(
+            conn,
+            RequestFrame {
+                id: 1,
+                idempotency: None,
+                on_behalf,
+                request,
+            },
+            10,
+        );
+        self.node.disconnect(conn);
+        match step {
+            Step::Reply(reply) => reply.result,
+            Step::Park(_) => panic!("parked"),
+        }
+    }
+    fn owner(&mut self, on_behalf: Option<PublicKey>, request: Request) -> Result<Response, ApiError> {
+        self.send(OWNER, on_behalf, request)
+    }
+    fn agent(&mut self, tag: u8, request: Request) -> Result<Response, ApiError> {
+        self.send(Credential([tag; 32]), None, request)
+    }
+    fn enroll(&mut self, name: &str, tag: u8) -> PublicKey {
+        match self
+            .owner(
+                None,
+                Request::AgentEnroll {
+                    name: name.into(),
+                    grants: Grants { manage_goals: true },
+                    credential: Credential([tag; 32]).digest(),
+                },
+            )
+            .unwrap()
+        {
+            Response::AgentEnrolled { agent } => agent,
+            other => panic!("{other:?}"),
+        }
+    }
+    fn restart(&mut self) {
+        self.restarts += 1;
+        self.node = Node::open(
+            self.store.reopen(),
+            Random(5_000_000 + self.restarts * 100_000 + u64::from(self.endpoint.0[0]) * 1000),
+            OWNER.digest(),
+            "test".into(),
+            0,
+        )
+        .unwrap();
+    }
+    fn membership(&self, goal: &GoalId, who: &PublicKey) -> Option<Membership> {
+        self.node.goals.get(goal).and_then(|entry| entry.membership(who))
+    }
+    fn is_member(&self, goal: &GoalId, who: &PublicKey) -> bool {
+        self.node
+            .goals
+            .get(goal)
+            .is_some_and(|entry| entry.is_member(who))
+    }
+    fn events(&self, goal: &GoalId) -> usize {
+        self.store.log(goal, 0, usize::MAX).unwrap().len()
+    }
+}
+
+/// Runs every peer's driver to quiescence. Exchanges opened to `FAKE` are
+/// answered by a stand-in that answers `Join` and the initiator's frontier
+/// with an empty frontier, and records what it is sent.
+fn reconcile(peers: &mut [Peer], now: u64, fake_log: &mut Vec<SyncMessage>) {
+    let mut queue: VecDeque<_> = (0..peers.len()).map(|i| (i, PeerInput::Poll)).collect();
+    let mut routes = HashMap::new();
+    let mut fake = HashSet::new();
+    let mut accepted = 0;
+    let mut steps = 0;
+    while let Some((i, input)) = queue.pop_front() {
+        steps += 1;
+        assert!(steps < 200000, "network does not quiesce");
+        if !peers[i].online {
+            continue;
+        }
+        let mut outputs = vec![];
+        peers[i].node.peer(input, now, &mut outputs);
+        for output in outputs {
+            match output {
+                PeerOutput::Open {
+                    exchange, endpoint, ..
+                } => {
+                    if endpoint == FAKE {
+                        fake.insert((i, exchange));
+                        queue.push_back((i, PeerInput::Opened(exchange)));
+                    } else if let Some(j) = peers
+                        .iter()
+                        .position(|peer| peer.online && peer.endpoint == endpoint)
+                    {
+                        let incoming = ExchangeId::Accepted(accepted);
+                        accepted += 1;
+                        routes.insert((i, exchange), (j, incoming));
+                        routes.insert((j, incoming), (i, exchange));
+                        queue.push_back((
+                            j,
+                            PeerInput::Accepted {
+                                exchange: incoming,
+                                remote: peers[i].endpoint,
+                            },
+                        ));
+                        queue.push_back((i, PeerInput::Opened(exchange)));
+                    } else {
+                        queue.push_back((i, PeerInput::OpenFailed(exchange)));
+                    }
+                }
+                PeerOutput::Send { exchange, frame } => {
+                    if fake.contains(&(i, exchange)) {
+                        fake_log.push(frame.clone());
+                        queue.push_back((i, PeerInput::Writable(exchange)));
+                        if matches!(frame, SyncMessage::Join(_) | SyncMessage::Frontier(_)) {
+                            queue.push_back((
+                                i,
+                                PeerInput::Frame {
+                                    exchange,
+                                    frame: SyncMessage::Frontier(Frontier::default()),
+                                },
+                            ));
+                        }
+                        continue;
+                    }
+                    let (j, incoming) = routes[&(i, exchange)];
+                    queue.push_back((
+                        j,
+                        PeerInput::Frame {
+                            exchange: incoming,
+                            frame,
+                        },
+                    ));
+                    queue.push_back((i, PeerInput::Writable(exchange)));
+                }
+                PeerOutput::Admit(_) => {}
+                PeerOutput::Finish(exchange) => queue.push_back((i, PeerInput::Finished(exchange))),
+            }
+        }
+    }
+}
+
+fn sync(peers: &mut [Peer], at: &mut u64) {
+    let mut sink = Vec::new();
+    for _ in 0..3 {
+        *at += 61_000;
+        reconcile(peers, *at, &mut sink);
+    }
+}
+
+fn create(peer: &mut Peer, tag: u8, title: &str) -> GoalId {
+    match peer.agent(tag, Request::GoalCreate { title: title.into() }).unwrap() {
+        Response::GoalCreated { goal } => goal,
+        other => panic!("{other:?}"),
+    }
+}
+
+fn invite(peer: &mut Peer, tag: u8, goal: GoalId) -> locust_proto::invite::Ticket {
+    match peer
+        .agent(
+            tag,
+            Request::GoalInvite {
+                goal,
+                expires_ms: None,
+            },
+        )
+        .unwrap()
+    {
+        Response::Invited { ticket } => ticket,
+        other => panic!("{other:?}"),
+    }
+}
+
+fn note(peer: &mut Peer, tag: u8, goal: GoalId, text: &str) -> Result<Response, ApiError> {
+    peer.agent(
+        tag,
+        Request::NoteAdd {
+            goal,
+            about: None,
+            supersedes: None,
+            text: text.into(),
+        },
+    )
+}
+
+fn note_texts(peer: &mut Peer, tag: u8, goal: GoalId) -> Result<Vec<Option<String>>, ApiError> {
+    match peer.agent(tag, Request::Notes { goal, about: None })? {
+        Response::Notes(notes) => Ok(notes.into_iter().map(|n| n.text).collect()),
+        other => panic!("{other:?}"),
+    }
+}
+
+fn code(result: Result<Response, ApiError>) -> String {
+    match result {
+        Ok(response) => format!("Ok({})", format!("{response:?}").chars().take(60).collect::<String>()),
+        Err(error) => format!("{:?}: {}", error.code, error.message),
+    }
+}
