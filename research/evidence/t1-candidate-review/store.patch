+#[test]
+fn p4_stage_and_discard_acknowledge_an_unflushed_directory_entry() {
+    let root = tempfile::tempdir().unwrap();
+    let dir = root.path().join("state");
+    let large = object(2 * BLOB_CHUNK_BYTES);
+    let (hash, bytes) = (large.hash(), large.bytes());
+    let chunk = BLOB_CHUNK_BYTES;
+    let mut store = SqliteStore::open(&dir).unwrap();
+    set("LRC_FAIL", "/blobs");
+    let first = store.stage_blob(&hash, 0, &bytes[..chunk]);
+    unset("LRC_FAIL");
+    eprintln!("[probe] creating stage_blob with a failed directory flush -> {first:?}");
+    set("LRC_TRACE", "1");
+    mark("retry and continue");
+    let again = store.stage_blob(&hash, 0, &bytes[..chunk]);
+    let next = store.stage_blob(&hash, chunk as u64, &bytes[chunk..]);
+    mark("end");
+    set("LRC_TRACE", "0");
+    eprintln!("[probe] repeat -> {again:?}; next chunk -> {next:?}");
+
+    // A killed creating call: the file exists, empty, and was never synced
+    // into the directory.
+    let other = object(INLINE_MAX_BYTES + 9);
+    fs::File::create(dir.join("blobs").join(format!("{}.staged", other.hash()))).unwrap();
+    set("LRC_TRACE", "1");
+    mark("stage into a file left by a killed creating call");
+    let staged = store.stage_blob(&other.hash(), 0, other.bytes());
+    mark("end");
+    set("LRC_TRACE", "0");
+    eprintln!("[probe] -> {staged:?}");
+
+    // Discard whose directory flush fails, then a repeat.
+    set("LRC_FAIL", "/blobs");
+    let discard = store.discard_staged_blob(&other.hash());
+    unset("LRC_FAIL");
+    eprintln!("[probe] discard with a failed directory flush -> {discard:?}");
+    set("LRC_TRACE", "1");
+    mark("repeat discard");
+    let again = store.discard_staged_blob(&other.hash());
+    mark("end");
+    set("LRC_TRACE", "0");
+    eprintln!("[probe] repeat discard -> {again:?}");
+}
