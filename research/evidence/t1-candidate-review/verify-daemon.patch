+#[cfg(test)]
+mod vd_strangers {
+    use super::*;
+    use std::time::Instant;
+
+    #[tokio::test]
+    #[ignore]
+    async fn idle_strangers() {
+        let peer: EndpointId = std::env::var("VD_PEER").unwrap().parse().unwrap();
+        let hint = std::env::var("VD_ADDR").unwrap();
+        let n: usize = std::env::var("VD_N").unwrap().parse().unwrap();
+        let hold: u64 = std::env::var("VD_HOLD").unwrap().parse().unwrap();
+        let mut held = Vec::new();
+        let mut eps = Vec::new();
+        let start = Instant::now();
+        for i in 0..n {
+            let mut secret = [0u8; 32];
+            secret[..8].copy_from_slice(&(i as u64 + 1000).to_le_bytes());
+            secret[8..16].copy_from_slice(&(start.elapsed().as_nanos() as u64).to_le_bytes());
+            secret[31] = 0x5a;
+            let ep = Endpoint::bind(EndpointConfig {
+                secret_key: secret,
+                relays: RelayConfig::Disabled,
+                lookup: Lookup::DISABLED,
+                ip_transport: IpTransport::Bind("127.0.0.1:0".parse().unwrap()),
+                port_mapping: false,
+                budget: TransportBudget::default(),
+            })
+            .await
+            .unwrap();
+            match ep.connect(peer, std::slice::from_ref(&hint)).await {
+                Ok(c) => held.push(c),
+                Err(e) => eprintln!("connect {i} failed {e}"),
+            }
+            eps.push(ep);
+        }
+        eprintln!("VD connected {} of {n} in {:?}", held.len(), start.elapsed());
+        let mut t = 0;
+        while t < hold {
+            tokio::time::sleep(Duration::from_secs(10)).await;
+            t += 10;
+            let open = held.iter().filter(|c| !c.is_closed()).count();
+            eprintln!("VD t+{t}s still open {open} of {}", held.len());
+        }
+        for c in &held { c.close(); }
+        for ep in &eps { ep.close().await; }
+    }
+}
