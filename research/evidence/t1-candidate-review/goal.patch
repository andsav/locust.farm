+/// A member who only proposed one task forks its log afterwards.
+#[test]
+fn probe_member_fork_voids_other_members_accepted_results() {
+    let mut c = Author::new(1);
+    let mut m = Author::new(2);
+    let mut n = Author::new(3);
+    let (genesis, own) = c.found_goal(EndpointId([1; 32]));
+    let mut flow = Flow {
+        goal: genesis.header().goal,
+        c,
+        head: own.id(),
+        events: vec![genesis.clone(), own.clone()],
+    };
+    flow.decide(Body::MemberAdmitted { member: m.key.public(), endpoint: EndpointId([2; 32]) });
+    flow.decide(Body::MemberAdmitted { member: n.key.public(), endpoint: EndpointId([3; 32]) });
+    let mut n2 = Author::new(3);
+    std::mem::swap(&mut n, &mut n2); // n is used as both proposer and worker below
+    let mut worker = n;
+    let mut proposer_n = Author::new(4); // unused key, never admitted
+    let _ = &mut proposer_n;
+
+    // T0: proposed by the coordinator, done by the worker, accepted as H0.
+    let mut c2 = Author::new(9);
+    std::mem::swap(&mut flow.c, &mut c2);
+    let t0 = {
+        let task = flow.write(&mut c2, propose());
+        std::mem::swap(&mut flow.c, &mut c2);
+        let assignment = flow.decide(Body::TaskAssigned { task: task.id(), assignee: worker.key.public(), attempt: 1 });
+        flow.write(&mut worker, Body::AssignmentAccepted { assignment: assignment.id() });
+        let result = flow.write(&mut worker, Body::ResultSubmitted { assignment: assignment.id(), base: None, patch: None, artifacts: vec![] });
+        flow.decide(Body::ResultAccepted { result: result.id(), head: Some(BlobHash([100; 32])) });
+        task
+    };
+    // T1: proposed by M, done by the worker against H0, accepted as H1.
+    let t1 = flow.task(&mut m, &mut worker, Some(100), 101);
+    // T2: proposed by the coordinator, done by the worker against H1, accepted as H2.
+    std::mem::swap(&mut flow.c, &mut c2);
+    let t2 = {
+        let task = flow.write(&mut c2, propose());
+        std::mem::swap(&mut flow.c, &mut c2);
+        let assignment = flow.decide(Body::TaskAssigned { task: task.id(), assignee: worker.key.public(), attempt: 1 });
+        flow.write(&mut worker, Body::AssignmentAccepted { assignment: assignment.id() });
+        let result = flow.write(&mut worker, Body::ResultSubmitted { assignment: assignment.id(), base: Some(BlobHash([101; 32])), patch: None, artifacts: vec![] });
+        flow.decide(Body::ResultAccepted { result: result.id(), head: Some(BlobHash([102; 32])) });
+        task
+    };
+
+    let mut goal = Goal::new(flow.goal);
+    goal.apply(&flow.events);
+    let show = |goal: &Goal, label: &str| {
+        eprintln!(
+            "{label}: tasks {:?} heads {:?} halt {:?}",
+            goal.state().tasks.iter().map(|t| t.state).collect::<Vec<_>>(),
+            goal.state().accepted_heads.iter().map(|h| h.head.0[0]).collect::<Vec<_>>(),
+            goal.halt().is_some(),
+        );
+    };
+    show(&goal, "before M forks");
+    assert_eq!(goal.state().accepted_heads.len(), 3);
+    assert!(goal.state().tasks.iter().all(|task| task.state == TaskState::Accepted));
+
+    // M signs a second event at its position 0.
+    let mut header = t1.header().clone();
+    header.at_ms += 1;
+    let fork = Event::sign(header, &m.key).unwrap();
+    goal.apply(&[fork]);
+    show(&goal, "after M forks ");
+    for event in &flow.events {
+        let standing = goal.standing(&event.id()).unwrap();
+        if !standing.is_effective() {
+            eprintln!("  a{} s{} {} -> {:?}", event.header().author.0[0], event.header().seq, event.header().body.kind(), standing);
+        }
+    }
+    let _ = (t0, t2);
+    assert_eq!(goal.state().accepted_heads.len(), 3, "a member's fork removed accepted heads of others");
+}
