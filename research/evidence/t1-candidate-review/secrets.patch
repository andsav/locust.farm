+#[test]
+fn probe_forged_join_keeps_exfiltrating_and_refusal_keeps_read_access() {
+    use locust_proto::invite::{Invitation, InviteSecret};
+    use locust_proto::sync::{Frontier, Refusal, SyncMessage};
+    let mut peers = [Peer::new(1), Peer::new(2)];
+    let goal = found(&mut peers);
+    let coordinator = peers[0].principal;
+    // Outsider on the member daemon (peer 2), not the coordinator's.
+    let Response::AgentEnrolled { .. } = request(
+        &mut peers[1].node,
+        None,
+        Request::AgentEnroll {
+            name: "outsider".into(),
+            grants: Grants { manage_goals: true },
+            credential: Credential([5; 32]).digest(),
+        },
+    ) else {
+        panic!("enroll");
+    };
+    assert!(matches!(
+        peers[1].node.connect(
+            ConnId(55),
+            &ClientHello { api_version: locust_proto::API_VERSION, credential: Credential([5; 32]), session: None },
+            0,
+        ),
+        ServerHello::Welcome { .. }
+    ));
+    // Forged ticket naming the REAL coordinator endpoint: the coordinator will refuse it.
+    let real = peers[0].endpoint;
+    let forged = Invitation {
+        version: locust_proto::PROTOCOL_VERSION,
+        goal,
+        coordinator,
+        endpoint: real,
+        hints: vec![],
+        secret: InviteSecret([0x43; 32]),
+        expires_ms: None,
+    }
+    .to_ticket()
+    .unwrap();
+    println!("join: {:?}", agent_request(&mut peers[1].node, 55, Request::GoalJoin { ticket: forged }));
+    peers[0].call(Request::NoteAdd { goal, about: None, supersedes: None, text: "after forged join".into() });
+    reconcile(&mut peers, 100_000);
+    reconcile(&mut peers, 140_000);
+    let joins = &peers[1].node.goals[&goal].local.joins;
+    println!("join records on member daemon: {:?}", joins.values().map(|j| j.refused).collect::<Vec<_>>());
+    let after = agent_request(&mut peers[1].node, 55, Request::Notes { goal, about: None });
+    println!("outsider notes after refusal: {:?}", after.as_ref().map(|r| match r { Response::Notes(n) => n.iter().map(|n| n.text.clone()).collect::<Vec<_>>(), _ => vec![] }));
+    let status = agent_request(&mut peers[1].node, 55, Request::Status);
+    println!("outsider status: {:?}", status.map(|r| match r { Response::Status(s) => s.goals.iter().map(|g| (g.membership, g.title.clone())).collect::<Vec<_>>(), _ => vec![] }));
+
+    // A second forged ticket to an endpoint that answers like an inviter: repeated pushes.
+    let mut peers1 = [Peer::new(3)];
+    let goal = found(&mut peers1);
+    let coordinator = peers1[0].principal;
+    request(&mut peers1[0].node, None, Request::AgentEnroll { name: "outsider".into(), grants: Grants { manage_goals: true }, credential: Credential([5; 32]).digest() });
+    peers1[0].node.connect(ConnId(55), &ClientHello { api_version: locust_proto::API_VERSION, credential: Credential([5; 32]), session: None }, 0);
+    let attacker = EndpointId([0xEE; 32]);
+    let forged = Invitation { version: locust_proto::PROTOCOL_VERSION, goal, coordinator, endpoint: attacker, hints: vec![], secret: InviteSecret([0x44; 32]), expires_ms: None }.to_ticket().unwrap();
+    agent_request(&mut peers1[0].node, 55, Request::GoalJoin { ticket: forged }).unwrap();
+    for (round, now) in [(1, 50_000u64), (2, 90_000u64)] {
+        if round == 2 {
+            peers1[0].call(Request::NoteAdd { goal, about: None, supersedes: None, text: "written later".into() });
+        }
+        let mut sent = vec![];
+        let outs = drive(&mut peers1[0].node, PeerInput::Poll, now, &mut sent);
+        let exchange = outs.iter().find_map(|o| match o { PeerOutput::Open { exchange, endpoint, .. } if *endpoint == attacker => Some(*exchange), _ => None }).expect("dials forged endpoint");
+        drive(&mut peers1[0].node, PeerInput::Opened(exchange), now, &mut sent);
+        drive(&mut peers1[0].node, PeerInput::Frame { exchange, frame: SyncMessage::Frontier(Frontier::default()) }, now, &mut sent);
+        drive(&mut peers1[0].node, PeerInput::Frame { exchange, frame: SyncMessage::Frontier(Frontier::default()) }, now, &mut sent);
+        drive(&mut peers1[0].node, PeerInput::Finished(exchange), now, &mut sent);
+        let pushed: usize = sent.iter().map(|f| if let SyncMessage::Events(e) = f { e.len() } else { 0 }).sum();
+        let held = peers1[0].store.log(&goal, 0, usize::MAX).unwrap().len();
+        println!("round {round}: pushed {pushed} of {held} held events to never-admitted endpoint");
+    }
+    let _ = Refusal::NotAMember;
+}
