+#[test]
+fn p3_finish_whose_commit_fails_leaves_the_object_neither_held_nor_staged() {
+    let root = tempfile::tempdir().unwrap();
+    let dir = root.path().join("state");
+    let large = object(INLINE_MAX_BYTES + 7);
+    let (hash, bytes) = (large.hash(), large.bytes());
+    {
+        let mut store = SqliteStore::open(&dir).unwrap();
+        assert_eq!(store.stage_blob(&hash, 0, bytes), Ok(bytes.len() as u64));
+        set("LRC_FAIL", "-wal");
+        let finished = store.finish_blob(&hash);
+        unset("LRC_FAIL");
+        eprintln!(
+            "[probe] finish_blob with a failed WAL flush -> {finished:?}; files {:?}",
+            files(&dir)
+        );
+    }
+    let store = SqliteStore::open(&dir).unwrap();
+    eprintln!(
+        "[probe] after reopen: blob_len {:?}, staged_len {:?}, files {:?}",
+        store.blob_len(&hash),
+        store.staged_len(&hash),
+        files(&dir)
+    );
+}
