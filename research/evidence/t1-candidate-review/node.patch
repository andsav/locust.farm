+/// H2: two principals on daemon B are members; the coordinator on A removes
+/// one. B still speaks for the other, so B gets the new epoch's key. What
+/// does the removed principal read on B?
+#[test]
+fn probe_r1_removed_cohosted_principal_reads_new_epoch() {
+    let mut peers = [Peer::new(1), Peer::new(2)];
+    let Response::AgentEnrolled { agent: second } = request(
+        &mut peers[1].node,
+        None,
+        Request::AgentEnroll {
+            name: "second".into(),
+            grants: Grants { manage_goals: true },
+            credential: Credential([5; 32]).digest(),
+        },
+    ) else {
+        panic!("enroll");
+    };
+    let first = peers[1].principal;
+    let Response::GoalCreated { goal } = peers[0].call(Request::GoalCreate { title: "epochs".into() }) else {
+        panic!()
+    };
+    for member in [first, second] {
+        let Response::Invited { ticket } = peers[0].call(Request::GoalInvite { goal, expires_ms: None }) else {
+            panic!()
+        };
+        request(&mut peers[1].node, Some(member), Request::GoalJoin { ticket });
+        reconcile(&mut peers, 1000);
+        reconcile(&mut peers, 40000);
+    }
+    reconcile(&mut peers, 80000);
+    assert!(peers[1].node.goals[&goal].is_member(&first));
+    assert!(peers[1].node.goals[&goal].is_member(&second));
+    peers[0].call(Request::NoteAdd { goal, about: None, supersedes: None, text: "before removal".into() });
+    peers[0].call(Request::MemberRemove { goal, member: first });
+    peers[0].call(Request::NoteAdd { goal, about: None, supersedes: None, text: "after removal, new epoch".into() });
+    reconcile(&mut peers, 120000);
+    reconcile(&mut peers, 160000);
+    reconcile(&mut peers, 200000);
+    let status = as_agent(&mut peers[1].node, 7, 2, Request::Status);
+    println!("R1 removed principal status: {status:?}");
+    let notes = as_agent(&mut peers[1].node, 8, 2, Request::Notes { goal, about: None });
+    println!("R1 removed principal notes: {notes:?}");
+    let write = as_agent(
+        &mut peers[1].node,
+        9,
+        2,
+        Request::NoteAdd { goal, about: None, supersedes: None, text: "x".into() },
+    );
+    println!("R1 removed principal note.add: {write:?}");
+    let pending = as_agent(&mut peers[1].node, 10, 2, Request::Pending { goal });
+    println!("R1 removed principal pending: {pending:?}");
+}
