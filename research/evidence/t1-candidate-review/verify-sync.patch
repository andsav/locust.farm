+//! verify-sync probes.
+
+use locust_proto::PROTOCOL_VERSION;
+use locust_proto::codec;
+use locust_proto::id::{EventId, GoalId};
+use locust_proto::sync::{AuthorFrontier, Frontier, SyncMessage};
+use locust_proto::testkit::Author;
+
+use super::net::Net;
+use super::{Founded, endpoint, host};
+use crate::sync::Responder;
+
+fn hello(goal: GoalId) -> SyncMessage {
+    SyncMessage::Hello {
+        version: PROTOCOL_VERSION,
+        goal,
+    }
+}
+
+#[test]
+fn verify_pipelined_inventory_requests_are_materialized() {
+    let founded = Founded::new();
+    let mut author = Author::new(2);
+    let notes = founded.notes(&mut author, 4106);
+    let mut host = host(1, founded.replica(&notes), &[1, 2]);
+    let mut responder = Responder::new(endpoint(2));
+    let mut out = Vec::new();
+    responder.receive(&mut host, hello(founded.goal), 0, &mut out);
+    let request = SyncMessage::InventoryRequest {
+        author: author.key.public(),
+        after: None,
+    };
+    let request_len = codec::encode(&request).unwrap().len();
+    for _ in 0..200 {
+        responder.receive(&mut host, request.clone(), 0, &mut out);
+    }
+    let (frames, bytes, lazy) = responder.built_frames();
+    eprintln!(
+        "PROBE inventory: request {request_len} bytes x200 = {}; emitted {}; built frames held {frames}, {bytes} bytes; lazy cursors {lazy}; amplification {:.0}x",
+        request_len * 200,
+        out.len(),
+        bytes as f64 / (request_len * 200) as f64
+    );
+    assert_eq!(out.len(), 1);
+    assert_eq!(frames, 199);
+}
+
+#[test]
+fn verify_frontier_answers_materialize_inventories() {
+    let founded = Founded::new();
+    let mut authors: Vec<Author> = (2..6).map(Author::new).collect();
+    let mut all = Vec::new();
+    for author in &mut authors {
+        all.extend(founded.notes(author, 2000));
+    }
+    let mut host = host(1, founded.replica(&all), &[1, 2]);
+    let mut theirs = Frontier::default();
+    let mut keys: Vec<_> = authors.iter().map(|a| a.key.public()).collect();
+    keys.sort();
+    for key in keys {
+        theirs.authors.push(AuthorFrontier {
+            author: key,
+            next_seq: 1,
+            digest: [7; 32],
+        });
+    }
+    let frame = SyncMessage::Frontier(theirs);
+    let frame_len = codec::encode(&frame).unwrap().len();
+    let mut responder = Responder::new(endpoint(2));
+    let mut out = Vec::new();
+    responder.receive(&mut host, hello(founded.goal), 0, &mut out);
+    for _ in 0..50 {
+        responder.receive(&mut host, frame.clone(), 0, &mut out);
+    }
+    let (frames, bytes, lazy) = responder.built_frames();
+    eprintln!(
+        "PROBE frontier: {frame_len} bytes x50; emitted {}; built frames held {frames}, {bytes} bytes; lazy {lazy}",
+        out.len()
+    );
+}
