+#[test]
+fn v_result_after_acceptance_replaces_the_tasks_result() {
+    let mut c = Author::new(1);
+    let mut w = Author::new(2);
+    let (genesis, own) = c.found_goal(EndpointId([1; 32]));
+    let id = genesis.header().goal;
+    let admit = c.event(
+        id,
+        Some(own.id()),
+        Body::MemberAdmitted {
+            member: w.key.public(),
+            endpoint: EndpointId([2; 32]),
+        },
+    );
+    let task = c.event(id, Some(admit.id()), propose());
+    let assign = c.event(
+        id,
+        Some(admit.id()),
+        Body::TaskAssigned {
+            task: task.id(),
+            assignee: w.key.public(),
+            attempt: 1,
+        },
+    );
+    let take = w.event(
+        id,
+        Some(assign.id()),
+        Body::AssignmentAccepted {
+            assignment: assign.id(),
+        },
+    );
+    let result = w.event(
+        id,
+        Some(assign.id()),
+        Body::ResultSubmitted {
+            assignment: assign.id(),
+            base: None,
+            patch: None,
+            artifacts: vec![],
+        },
+    );
+    let accept = c.event(
+        id,
+        Some(assign.id()),
+        Body::ResultAccepted {
+            result: result.id(),
+            head: None,
+        },
+    );
+    let late = w.event(
+        id,
+        Some(accept.id()),
+        Body::ResultSubmitted {
+            assignment: assign.id(),
+            base: None,
+            patch: None,
+            artifacts: vec![],
+        },
+    );
+    let mut goal = Goal::new(id);
+    goal.apply(&[genesis, own, admit, task, assign, take, result.clone(), accept]);
+    goal.apply(&[late.clone()]);
+    let t = &goal.state().tasks[0];
+    println!(
+        "late standing {:?}; task state {:?}; result is accepted one {}; result is late one {}; accepted is original {}",
+        goal.standing(&late.id()),
+        t.state,
+        t.result == Some(result.id()),
+        t.result == Some(late.id()),
+        t.accepted == Some(result.id())
+    );
+}
