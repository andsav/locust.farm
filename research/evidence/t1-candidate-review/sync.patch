+/// Driver backoff doubles per endpoint, and every exchange opened is one
+/// per (goal, endpoint).
+#[test]
+fn review_backoff_sequence_for_unreachable_endpoint() {
+    let founded = Founded::new();
+    let mut host = host(1, founded.replica(&[]), &[1, 2]);
+    let mut driver = Driver::new();
+    let mut opens = Vec::new();
+    for second in 0..400u64 {
+        let now = second * 1000;
+        let mut out = Vec::new();
+        driver.handle(&mut host, PeerInput::Poll, now, &mut out);
+        for output in out {
+            if let PeerOutput::Open { exchange, .. } = output {
+                opens.push(second);
+                let mut more = Vec::new();
+                driver.handle(&mut host, PeerInput::OpenFailed(exchange), now, &mut more);
+                assert!(more.is_empty());
+            }
+        }
+    }
+    let gaps: Vec<u64> = opens.windows(2).map(|w| w[1] - w[0]).collect();
+    eprintln!("open gaps (s): {gaps:?}");
+    assert!(gaps.iter().all(|gap| *gap <= 60));
+}
