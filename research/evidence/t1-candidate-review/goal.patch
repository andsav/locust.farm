+        let r = m.emit(goal, Some(a.id()), Body::ResultSubmitted { assignment: a.id(), base: None, patch: None, artifacts: vec![] }, None);
+        let cancel = c.emit(goal, Some(a.id()), Body::CancelRequested { assignment: a.id() }, None);
+        let accept = c.emit(goal, Some(cancel.id()), Body::ResultAccepted { result: r.id(), head: None }, None);
+        let ack = m.emit(goal, Some(cancel.id()), Body::CancelAcknowledged { cancel: cancel.id(), outcome: CancelOutcome::Completed }, None);
+        exhaust("cancel races result", goal, &[g.clone(), own.clone(), admit.clone(), t.clone(), a.clone(), take.clone(), r.clone(), cancel.clone(), accept.clone()]);
+        let mut header = r.header().clone();
