+//! Review probes (not part of locust): one exchange whose traffic flows in
+//! only one direction for longer than IO_IDLE.
+use std::time::Instant;
+
+use locust_proto::id::GoalId;
+
+use super::super::durable_tests::local_endpoint;
+use super::*;
+
+fn hello() -> SyncMessage {
+    SyncMessage::Hello {
+        version: 0,
+        goal: GoalId([9; 32]),
+    }
+}
+
+async fn linked() -> (Endpoint, Endpoint, PeerConnection, PeerConnection) {
+    let a = local_endpoint([1; 32]).await.unwrap();
+    let b = local_endpoint([2; 32]).await.unwrap();
+    let accept = tokio::spawn({
+        let a = a.clone();
+        async move { a.accept().await.unwrap().accept().await.unwrap() }
+    });
+    let b_conn = b.connect(a.id(), &a.hints()).await.unwrap();
+    let a_conn = accept.await.unwrap();
+    (a, b, a_conn, b_conn)
+}
+
+/// The fake engine acknowledges every frame and records how the exchange ended.
+fn fake_engine(
+    jobs: std::sync::mpsc::Receiver<Job>,
+    start: Instant,
+) -> std::thread::JoinHandle<(usize, Option<(&'static str, Duration)>)> {
+    std::thread::spawn(move || {
+        let mut frames = 0;
+        while let Ok(job) = jobs.recv() {
+            match job {
+                Job::PeerFrame { processed, .. } => {
+                    frames += 1;
+                    let _ = processed.send(());
+                }
+                Job::Peer(PeerInput::Closed(_)) => return (frames, Some(("closed", start.elapsed()))),
+                Job::Peer(PeerInput::Finished(_)) => {
+                    return (frames, Some(("finished", start.elapsed())));
+                }
+                _ => {}
+            }
+        }
+        (frames, None)
+    })
+}
+
+/// The peer streams one frame every 2 s for 50 s; this side has nothing to
+/// send (as an initiator receiving BlobChunk frames after its BlobRequest).
+#[tokio::test(flavor = "multi_thread")]
+async fn probe_inbound_stream_with_quiet_writer() {
+    let (_a, _b, a_conn, b_conn) = linked().await;
+    let mut b_link = b_conn.open_link(FrameLimits::peer()).await.unwrap();
+    b_link.send(&hello()).await.unwrap();
+    let a_link = a_conn.accept_link(FrameLimits::peer()).await.unwrap();
+    let start = Instant::now();
+    let (jobs, inbox) = std::sync::mpsc::channel();
+    let engine = fake_engine(inbox, start);
+    let (commands, receiver) = mpsc::unbounded_channel();
+    let (_admitted, admission) = watch::channel(true);
+    let (events, _events) = mpsc::unbounded_channel();
+    let (_stop, stop) = watch::channel(false);
+    let task = tokio::spawn(exchange_task(
+        a_link,
+        a_conn.clone(),
+        ExchangeId::Accepted(1),
+        receiver,
+        admission,
+        jobs,
+        events,
+        stop,
+    ));
+    let mut sent = 1;
+    let mut failure = None;
+    for _ in 0..25 {
+        tokio::time::sleep(Duration::from_secs(2)).await;
+        match b_link.send(&hello()).await {
+            Ok(()) => sent += 1,
+            Err(error) => {
+                failure = Some((format!("{error}"), start.elapsed()));
+                break;
+            }
+        }
+    }
+    task.await.unwrap();
+    let (frames, ended) = engine.join().unwrap();
+    println!(
+        "PROBE inbound: peer sent {sent} frames, engine got {frames}, exchange ended {ended:?}, peer send failure {failure:?}"
+    );
+    drop(commands);
+}
+
+/// This side streams one frame every 2 s for 50 s; the peer reads and sends
+/// nothing (as a responder serving BlobChunk frames).
+#[tokio::test(flavor = "multi_thread")]
+async fn probe_outbound_stream_with_quiet_reader() {
+    let (_a, _b, a_conn, b_conn) = linked().await;
+    let mut b_link = b_conn.open_link(FrameLimits::peer()).await.unwrap();
+    b_link.send(&hello()).await.unwrap();
+    let a_link = a_conn.accept_link(FrameLimits::peer()).await.unwrap();
+    let start = Instant::now();
+    let (jobs, inbox) = std::sync::mpsc::channel();
+    let engine = fake_engine(inbox, start);
+    let (commands, receiver) = mpsc::unbounded_channel();
+    let (_admitted, admission) = watch::channel(true);
+    let (events, _events) = mpsc::unbounded_channel();
+    let (_stop, stop) = watch::channel(false);
+    let task = tokio::spawn(exchange_task(
+        a_link,
+        a_conn.clone(),
+        ExchangeId::Accepted(1),
+        receiver,
+        admission,
+        jobs,
+        events,
+        stop,
+    ));
+    let reader = tokio::spawn(async move {
+        let mut got = 0;
+        loop {
+            match b_link.recv().await {
+                Ok(Some(_)) => got += 1,
+                other => return (got, format!("{other:?}"), start.elapsed()),
+            }
+        }
+    });
+    let mut queued = 0;
+    for _ in 0..25 {
+        tokio::time::sleep(Duration::from_secs(2)).await;
+        if commands.send(Command::Send(hello())).is_err() {
+            break;
+        }
+        queued += 1;
+        if task.is_finished() {
+            break;
+        }
+    }
+    task.await.unwrap();
+    let (frames, ended) = engine.join().unwrap();
+    let read = reader.await.unwrap();
+    println!(
+        "PROBE outbound: queued {queued} sends, engine got {frames} inbound frames, exchange ended {ended:?}, peer read {read:?}"
+    );
+}
