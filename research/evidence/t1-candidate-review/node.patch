+/// N3: revocation and what the daemon still signs for the revoked principal.
+#[test]
+fn probe_n3_revoked_principal_join_and_invites() {
+    // (a) A pending join of a principal revoked before the inviter was reached.
+    let mut peers = [Peer::new(1), Peer::new(2)];
+    let Response::GoalCreated { goal } = peers[0].call(Request::GoalCreate { title: "revocation".into() }) else { panic!() };
+    let Response::Invited { ticket } = peers[0].call(Request::GoalInvite { goal, expires_ms: None }) else { panic!() };
+    peers[1].call(Request::GoalJoin { ticket });
+    let joiner = peers[1].principal;
+    request(&mut peers[1].node, None, Request::AgentRevoke { agent: joiner });
+    reconcile(&mut peers, 1000);
+    reconcile(&mut peers, 40000);
+    println!(
+        "N3a revoked joiner admitted on inviter: {} here: {}",
+        peers[0].node.goals[&goal].is_member(&joiner),
+        peers[1].node.goals.get(&goal).is_some_and(|entry| entry.is_member(&joiner))
+    );
+    // (b) Tickets issued before the coordinator lost every authorization.
+    let mut peers = [Peer::new(1), Peer::new(2), Peer::new(3)];
+    let Response::GoalCreated { goal } = peers[0].call(Request::GoalCreate { title: "grants".into() }) else { panic!() };
+    let Response::Invited { ticket: one } = peers[0].call(Request::GoalInvite { goal, expires_ms: None }) else { panic!() };
+    let Response::Invited { ticket: two } = peers[0].call(Request::GoalInvite { goal, expires_ms: None }) else { panic!() };
+    let coordinator = peers[0].principal;
+    // The owner takes away decide and manage_goals.
+    request(&mut peers[0].node, None, Request::GoalGrant { goal, agent: coordinator, grants: Default::default() });
+    request(&mut peers[0].node, None, Request::AgentGrant { agent: coordinator, grants: Grants { manage_goals: false } });
+    let fresh = as_agent(&mut peers[0].node, 30, 1, Request::GoalInvite { goal, expires_ms: None });
+    println!("N3b invite without grants: {:?}", fresh.map(|_| "ticket"));
+    peers[1].call(Request::GoalJoin { ticket: one });
+    reconcile(&mut peers, 1000);
+    reconcile(&mut peers, 40000);
+    println!("N3b join after grants were removed admitted: {}", peers[0].node.goals[&goal].is_member(&peers[1].principal));
+    // Then the owner revokes the coordinator.
+    request(&mut peers[0].node, None, Request::AgentRevoke { agent: coordinator });
+    let events = peers[0].store.log(&goal, 0, usize::MAX).unwrap().len();
+    peers[2].call(Request::GoalJoin { ticket: two });
+    reconcile(&mut peers, 80000);
+    reconcile(&mut peers, 120000);
+    reconcile(&mut peers, 160000);
+    println!(
+        "N3b join after revocation admitted: {} (events {} -> {}), key 0 on the new member: {}",
+        peers[0].node.goals[&goal].is_member(&peers[2].principal),
+        events,
+        peers[0].store.log(&goal, 0, usize::MAX).unwrap().len(),
+        peers[2].node.goals[&goal].keys.contains_key(&0)
+    );
+    let Response::GoalStatus(status) = peers[2].call(Request::GoalStatus { goal }) else { panic!() };
+    println!("N3b new member reads title: {:?}", status.title);
+    // What the owner can do about it on the coordinator's daemon.
+    let remove = try_request(&mut peers[0].node, Some(coordinator), Request::MemberRemove { goal, member: peers[2].principal });
+    println!("N3b owner on behalf of the revoked coordinator: {:?}", remove.map(|_| "ok"));
+}
