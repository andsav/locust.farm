+/// Finding invites-outlive-revocation: grants removed, then coordinator revoked.
+#[test]
+fn vn_invites_outlive_grants_and_revocation() {
+    let mut at = 1_000;
+    let mut peers = [Peer::new(1), Peer::new(2), Peer::new(3)];
+    let alice = peers[0].enroll("alice", 11);
+    let m1 = peers[1].enroll("m1", 21);
+    let m2 = peers[2].enroll("m2", 31);
+    let goal = create(&mut peers[0], 11, "revocation goal");
+    let t1 = invite(&mut peers[0], 11, goal);
+    let t2 = invite(&mut peers[0], 11, goal);
+    peers[0]
+        .owner(
+            None,
+            Request::GoalGrant {
+                goal,
+                agent: alice,
+                grants: GoalGrants::default(),
+            },
+        )
+        .unwrap();
+    peers[0]
+        .owner(
+            None,
+            Request::AgentGrant {
+                agent: alice,
+                grants: Grants {
+                    manage_goals: false,
+                },
+            },
+        )
+        .unwrap();
+    println!(
+        "alice invite after grants removed: {}",
+        code(peers[0].agent(
+            11,
+            Request::GoalInvite {
+                goal,
+                expires_ms: None
+            }
+        ))
+    );
+    println!(
+        "alice note after grants removed: {}",
+        code(note(&mut peers[0], 11, goal, "x"))
+    );
+    peers[1].agent(21, Request::GoalJoin { ticket: t1 }).unwrap();
+    let before = peers[0].events(&goal);
+    sync(&mut peers, &mut at);
+    println!(
+        "join after grants removed admitted on A: {} (events {} -> {}), m1 on B: {:?}",
+        peers[0].is_member(&goal, &m1),
+        before,
+        peers[0].events(&goal),
+        peers[1].membership(&goal, &m1)
+    );
+    peers[0]
+        .owner(None, Request::AgentRevoke { agent: alice })
+        .unwrap();
+    println!(
+        "alice status after revoke: {}",
+        code(peers[0].agent(11, Request::Status))
+    );
+    peers[2].agent(31, Request::GoalJoin { ticket: t2 }).unwrap();
+    let before = peers[0].events(&goal);
+    sync(&mut peers, &mut at);
+    println!(
+        "join after revocation admitted on A: {} (events {} -> {}); m2 on C: {:?}; key 0 on C: {}",
+        peers[0].is_member(&goal, &m2),
+        before,
+        peers[0].events(&goal),
+        peers[2].membership(&goal, &m2),
+        peers[2].node.goals[&goal].keys.contains_key(&0)
+    );
+    let title = match peers[2].agent(31, Request::GoalStatus { goal }) {
+        Ok(Response::GoalStatus(status)) => status.title,
+        other => panic!("{other:?}"),
+    };
+    println!("m2 reads title: {title:?}");
+    println!(
+        "owner on behalf of revoked alice removes m2: {}",
+        code(peers[0].owner(
+            Some(alice),
+            Request::MemberRemove { goal, member: m2 }
+        ))
+    );
+}
