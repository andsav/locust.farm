+/// Two replicas that receive the same events through `screen` in different
+/// orders and then reconcile until nothing more is kept hold the same set
+/// and the same state.
+#[test]
+fn screened_replicas_converge() {
+    let from: u64 = std::env::var("PERM_FROM").ok().and_then(|v| v.parse().ok()).unwrap_or(0);
+    let count: u64 = std::env::var("PERM_COUNT").ok().and_then(|v| v.parse().ok()).unwrap_or(300);
+    let mut dropped_total = 0;
+    let mut max_passes = 0;
+    for seed in from..from + count {
+        let world = generate(seed);
+        let mut rng = Rng(seed.wrapping_mul(77).wrapping_add(3));
+        let mut views = Vec::new();
+        for round in 0..6 {
+            let mut order = world.events.clone();
+            match round {
+                0 => {}
+                1 => order.reverse(),
+                _ => rng.shuffle(&mut order),
+            }
+            let mut goal = Goal::new(world.goal);
+            let mut at = 0;
+            while at < order.len() {
+                let cap = [1, 3, 8, 40][rng.below(4)];
+                let size = 1 + rng.below(cap);
+                let batch = order[at..(at + size).min(order.len())].to_vec();
+                at += batch.len();
+                let screened = goal.screen(batch);
+                goal.apply(&screened);
+                assert_eq!(goal.folded, fold::fold(&goal.history).0, "seed {seed}: screened incremental");
+            }
+            max_passes = max_passes.max(settle(&mut goal, &world.events, &mut rng));
+            dropped_total += world.events.len() - goal.len();
+            views.push((goal.len(), view(&goal)));
+        }
+        for (len, other) in &views[1..] {
+            assert_eq!(*len, views[0].0, "seed {seed}: held sets differ in size");
+            if *other != views[0].1 {
+                eprintln!("seed {seed}: transcript\n{}", world.log.join("\n"));
+            }
+            assert_eq!(other.state, views[0].1.state, "seed {seed}: state");
+            assert_eq!(other.standings, views[0].1.standings, "seed {seed}: standings");
+            assert_eq!(*other, views[0].1, "seed {seed}: view");
+        }
+    }
+    eprintln!("screened scenarios {count}, never retained {dropped_total}, most passes {max_passes}");
+}
