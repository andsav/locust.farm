+/// After its result is accepted, the assignee signs another result on the
+/// same assignment.
+#[test]
+fn probe_result_after_acceptance_replaces_the_tasks_result() {
+    let mut c = Author::new(1);
+    let mut m = Author::new(2);
+    let (genesis, own) = c.found_goal(EndpointId([1; 32]));
+    let mut flow = Flow { goal: genesis.header().goal, c, head: own.id(), events: vec![genesis, own] };
+    flow.decide(Body::MemberAdmitted { member: m.key.public(), endpoint: EndpointId([2; 32]) });
+    let task = flow.write(&mut m, propose());
+    let assignment = flow.decide(Body::TaskAssigned { task: task.id(), assignee: m.key.public(), attempt: 1 });
+    flow.write(&mut m, Body::AssignmentAccepted { assignment: assignment.id() });
+    let result = flow.write(&mut m, Body::ResultSubmitted { assignment: assignment.id(), base: None, patch: None, artifacts: vec![] });
+    flow.decide(Body::ResultAccepted { result: result.id(), head: Some(BlobHash([100; 32])) });
+    let mut goal = Goal::new(flow.goal);
+    goal.apply(&flow.events);
+    let view = goal.state().task(&task.id()).unwrap().clone();
+    assert_eq!((view.state, view.result, view.accepted), (TaskState::Accepted, Some(result.id()), Some(result.id())));
+
+    let late = flow.write(&mut m, Body::ResultSubmitted { assignment: assignment.id(), base: None, patch: Some(BlobHash([66; 32])), artifacts: vec![] });
+    goal.apply(&[late.clone()]);
+    let view = goal.state().task(&task.id()).unwrap().clone();
+    eprintln!(
+        "late result standing {:?}; task state {:?}; result is accepted one {}; result is late one {}; accepted is original {}",
+        goal.standing(&late.id()),
+        view.state,
+        view.result == Some(result.id()),
+        view.result == Some(late.id()),
+        view.accepted == Some(result.id()),
+    );
+    assert_eq!(view.result, Some(result.id()), "the accepted task now shows a result nobody accepted");
+}
