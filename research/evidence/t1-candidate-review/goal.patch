+/// Every arrival order of a small set, one event per call, against the set
+/// applied at once; the incremental fold against a fold from scratch after
+/// every event.
+fn exhaust(label: &str, goal: GoalId, events: &[Event]) {
+    let mut reference = Goal::new(goal);
+    reference.apply(events);
+    let expected = view(&reference);
+    let mut orders = 0u64;
+    permutations(events.len(), &mut |order| {
+        orders += 1;
+        let mut actual = Goal::new(goal);
+        for &index in order {
+            actual.apply(std::slice::from_ref(&events[index]));
+            assert_eq!(actual.folded, fold::fold(&actual.history).0, "{label}: order {order:?}");
+        }
+        assert_eq!(view(&actual), expected, "{label}: order {order:?}");
+    });
+    eprintln!(
+        "{label}: {} events, {orders} orders, halt {:?}, head set {}, effective {}",
+        events.len(),
+        expected.halt.is_some(),
+        expected.state.head.is_some(),
+        expected.standings.values().filter(|s| s.is_effective()).count()
+    );
+}
