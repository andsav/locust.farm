+#[test]
+fn review_inventory_pages_respect_limit_and_resume_after() {
+    let founded = Founded::new();
+    // A forked author with 9000 variants at position 0: inventory pages.
+    let fork: Vec<Event> = (0..9000u32)
+        .map(|n| {
+            let mut a = Author::new(2);
+            a.event(
+                founded.goal,
+                founded.anchor(),
+                Body::Note {
+                    about: Some(EventId([(n % 251) as u8; 32])),
+                    supersedes: Some(EventId([(n / 251) as u8; 32])),
+                },
+            )
+        })
+        .collect();
+    let author = Author::new(2).key.public();
+    let mut host = host(1, founded.replica(&fork), &[1, 2]);
+    let mut after = None;
+    let mut seen = Vec::new();
+    loop {
+        let (_, out) = respond(
+            &mut host,
+            2,
+            vec![
+                hello(founded.goal),
+                SyncMessage::InventoryRequest { author, after },
+            ],
+        );
+        assert_eq!(out.len(), 1);
+        let SyncMessage::Inventory {
+            author: a,
+            points,
+            more,
+        } = &out[0]
+        else {
+            panic!()
+        };
+        assert_eq!(*a, author);
+        assert!(points.len() <= MAX_INVENTORY_POINTS);
+        assert!(codec::encode(&out[0]).unwrap().len() <= MAX_PEER_FRAME_BYTES);
+        seen.extend_from_slice(points);
+        if !more {
+            break;
+        }
+        after = points.last().copied();
+    }
+    assert_eq!(seen.len(), 9000);
+    assert!(seen.is_sorted());
+}
