+/// A member forks its log low; a decision made earlier names one of its
+/// events more than MAX_WAITING_PER_AUTHOR past the fork point.
+#[test]
+fn probe_fork_then_waiting_bound_stalls_a_late_replica() {
+    let mut c = Author::new(1);
+    let mut m = Author::new(2);
+    let j = Author::new(3);
+    let (genesis, own) = c.found_goal(EndpointId([1; 32]));
+    let goal = genesis.header().goal;
+    let admit_m = c.event(
+        goal,
+        Some(own.id()),
+        Body::MemberAdmitted {
+            member: m.key.public(),
+            endpoint: EndpointId([2; 32]),
+        },
+    );
+    let mut all = vec![genesis.clone(), own.clone(), admit_m.clone()];
+    let mut m_events = Vec::new();
+    for _ in 0..1400 {
+        m_events.push(m.event(goal, Some(admit_m.id()), note()));
+    }
+    let task = m.event(goal, Some(admit_m.id()), propose());
+    m_events.push(task.clone());
+    let assign = c.event(
+        goal,
+        Some(admit_m.id()),
+        Body::TaskAssigned {
+            task: task.id(),
+            assignee: c.key.public(),
+            attempt: 1,
+        },
+    );
+    let admit_j = c.event(
+        goal,
+        Some(assign.id()),
+        Body::MemberAdmitted {
+            member: j.key.public(),
+            endpoint: EndpointId([3; 32]),
+        },
+    );
+    all.extend(m_events.iter().cloned());
+    all.push(assign.clone());
+    all.push(admit_j.clone());
+
+    // Replica A (the coordinator's daemon) saw everything as it was written.
+    let mut a = Goal::new(goal);
+    for event in &all {
+        assert_eq!(receive(&mut a, vec![event.clone()]), 1);
+    }
+    assert_eq!(a.state().head, Some(admit_j.id()));
+    assert_eq!(a.standing(&assign.id()), Some(Standing::Effective));
+    assert!(a.state().is_member(&j.key.public()));
+
+    // The member now signs a second event at position 5.
+    let mut header = m_events[5].header().clone();
+    header.at_ms += 1;
+    let fork = Event::sign(header, &m.key).unwrap();
+    all.push(fork.clone());
+    assert_eq!(receive(&mut a, vec![fork.clone()]), 1);
+    assert_eq!(a.fork_point(&m.key.public()), Some(5));
+    eprintln!(
+        "A: holds {} head_is_last {} assign {:?} joiner member {}",
+        a.len(),
+        a.state().head == Some(admit_j.id()),
+        a.standing(&assign.id()),
+        a.state().is_member(&j.key.public())
+    );
+    assert_eq!(a.len(), all.len());
+    assert_eq!(a.state().head, Some(admit_j.id()));
+    assert!(a.state().is_member(&j.key.public()));
+
+    // Replica B (the joiner's daemon) starts empty and reconciles until
+    // nothing more is kept.
+    let mut b = Goal::new(goal);
+    let passes = reconcile(&mut b, &all);
+    eprintln!(
+        "B: passes {} holds {} of {} head_is_last {} head_is_admit_m {} assign {:?} joiner member {} holds task {} m points {} usable {}",
+        passes,
+        b.len(),
+        all.len(),
+        b.state().head == Some(admit_j.id()),
+        b.state().head == Some(admit_m.id()),
+        b.standing(&assign.id()),
+        b.state().is_member(&j.key.public()),
+        b.holds(&task.id()),
+        b.points(&m.key.public()).len(),
+        b.usable(&m.key.public()),
+    );
+    // One more full offer changes nothing.
+    assert_eq!(b.screen(all.clone()).len(), 0);
+    assert_eq!(a.state(), b.state(), "replicas that reconciled to quiescence differ");
+}
