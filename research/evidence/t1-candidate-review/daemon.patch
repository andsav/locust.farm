+//! Peer-side probes against a running locust daemon. Not part of locust.
+use std::net::SocketAddr;
+use std::time::{Duration, Instant};
+
+use iroh::endpoint::{presets, Connection};
+use iroh::{EndpointAddr, EndpointId, SecretKey};
+use locust_proto::codec;
+use locust_proto::id::GoalId;
+use locust_proto::sync::SyncMessage;
+
+const ALPN: &[u8] = b"locust/sync/0";
+
+async fn endpoint() -> iroh::Endpoint {
+    let mut key = [0u8; 32];
+    getrandom::fill(&mut key).unwrap();
+    iroh::Endpoint::builder(presets::Minimal)
+        .secret_key(SecretKey::from_bytes(&key))
+        .relay_mode(iroh::RelayMode::Disabled)
+        .clear_address_lookup()
+        .clear_ip_transports()
+        .bind_addr("127.0.0.1:0".parse::<SocketAddr>().unwrap())
+        .unwrap()
+        .bind()
+        .await
+        .unwrap()
+}
+
+async fn dial(ep: &iroh::Endpoint, target: &str, addr: &str) -> Connection {
+    let id: EndpointId = target.parse().unwrap();
+    let addr = EndpointAddr::new(id).with_ip_addr(addr.parse().unwrap());
+    ep.connect(addr, ALPN).await.unwrap()
+}
+
+fn frame(message: &SyncMessage) -> Vec<u8> {
+    let mut out = Vec::new();
+    codec::encode_frame(message, &mut out).unwrap();
+    out
+}
+
+/// Reads until the stream ends or errors; returns what happened and when.
+async fn drain(recv: &mut iroh::endpoint::RecvStream, start: Instant) -> String {
+    let mut got = Vec::new();
+    let mut buf = [0u8; 4096];
+    loop {
+        match recv.read(&mut buf).await {
+            Ok(Some(n)) => got.extend_from_slice(&buf[..n]),
+            Ok(None) => return format!("fin after {:?}, {} bytes {:?}", start.elapsed(), got.len(), decode_all(&got)),
+            Err(e) => return format!("error {e} after {:?}, {} bytes {:?}", start.elapsed(), got.len(), decode_all(&got)),
+        }
+    }
+}
+
+fn decode_all(mut bytes: &[u8]) -> Vec<String> {
+    let mut out = Vec::new();
+    while bytes.len() >= 4 {
+        let len = u32::from_le_bytes(bytes[..4].try_into().unwrap()) as usize;
+        if bytes.len() < 4 + len {
+            out.push(format!("partial({len})"));
+            break;
+        }
+        match SyncMessage::decode(&bytes[4..4 + len]) {
+            Ok(m) => out.push(format!("{m:?}")),
+            Err(e) => out.push(format!("undecodable {e:?}")),
+        }
+        bytes = &bytes[4 + len..];
+    }
+    out
+}
+
+#[tokio::main]
+async fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let target = args[2].clone();
+    let addr = args[3].clone();
+    match args[1].as_str() {
+        // N fresh identities connect and hold the connection, opening nothing.
+        "strangers" => {
+            let count: usize = args[4].parse().unwrap();
+            let hold: u64 = args[5].parse().unwrap();
+            let mut held = Vec::new();
+            for i in 0..count {
+                let ep = endpoint().await;
+                match tokio::time::timeout(Duration::from_secs(10), async {
+                    let id: EndpointId = target.parse().unwrap();
+                    ep.connect(EndpointAddr::new(id).with_ip_addr(addr.parse().unwrap()), ALPN).await
+                })
+                .await
+                {
+                    Ok(Ok(c)) => held.push((ep, c)),
+                    other => eprintln!("connect {i} failed: {:?}", other.map(|r| r.map(|_| ()))),
+                }
+            }
+            println!("connected {}", held.len());
+            tokio::time::sleep(Duration::from_secs(hold)).await;
+            let open = held.iter().filter(|(_, c)| c.close_reason().is_none()).count();
+            println!("after {hold}s still open {open} of {}", held.len());
+            if let Some((_, c)) = held.iter().find(|(_, c)| c.close_reason().is_some()) {
+                println!("example close reason {:?}", c.close_reason());
+            }
+        }
+        // Opens one exchange, sends part of a frame, then stalls.
+        "partial" => {
+            let ep = endpoint().await;
+            let conn = dial(&ep, &target, &addr).await;
+            let (mut send, mut recv) = conn.open_bi().await.unwrap();
+            let mut bytes = 100u32.to_le_bytes().to_vec();
+            bytes.extend_from_slice(&[0u8; 10]);
+            send.write_all(&bytes).await.unwrap();
+            let start = Instant::now();
+            println!("partial frame sent; {}", drain(&mut recv, start).await);
+            println!("connection close reason {:?}", conn.close_reason());
+        }
+        // Sends only one byte of a prefix.
+        "prefix1" => {
+            let ep = endpoint().await;
+            let conn = dial(&ep, &target, &addr).await;
+            let (mut send, mut recv) = conn.open_bi().await.unwrap();
+            send.write_all(&[5u8]).await.unwrap();
+            let start = Instant::now();
+            println!("one prefix byte sent; {}", drain(&mut recv, start).await);
+        }
+        // A non-member Hello for a random goal, then never finishes or reads.
+        "hello" => {
+            let ep = endpoint().await;
+            let conn = dial(&ep, &target, &addr).await;
+            let (mut send, mut recv) = conn.open_bi().await.unwrap();
+            let goal = if args.len() > 4 { args[4].parse().unwrap() } else { GoalId([9; 32]) };
+            send.write_all(&frame(&SyncMessage::Hello { version: 0, goal })).await.unwrap();
+            let start = Instant::now();
+            println!("hello sent; {}", drain(&mut recv, start).await);
+        }
+        // Oversized prefix on a hello-limited exchange.
+        "bigprefix" => {
+            let ep = endpoint().await;
+            let conn = dial(&ep, &target, &addr).await;
+            let (mut send, mut recv) = conn.open_bi().await.unwrap();
+            send.write_all(&(1_000_000u32).to_le_bytes()).await.unwrap();
+            let start = Instant::now();
+            println!("big prefix sent; {}", drain(&mut recv, start).await);
+        }
+        // Undecodable frame within the hello limit.
+        "garbage" => {
+            let ep = endpoint().await;
+            let conn = dial(&ep, &target, &addr).await;
+            let (mut send, mut recv) = conn.open_bi().await.unwrap();
+            let mut bytes = 8u32.to_le_bytes().to_vec();
+            bytes.extend_from_slice(&[0xff; 8]);
+            send.write_all(&bytes).await.unwrap();
+            let start = Instant::now();
+            println!("garbage sent; {}", drain(&mut recv, start).await);
+        }
+        // Many partial exchanges on one connection: how many are served at once.
+        "streams" => {
+            let n: usize = args[4].parse().unwrap();
+            let ep = endpoint().await;
+            let conn = dial(&ep, &target, &addr).await;
+            let start = Instant::now();
+            let mut tasks = Vec::new();
+            for i in 0..n {
+                let conn = conn.clone();
+                tasks.push(tokio::spawn(async move {
+                    let opened = tokio::time::timeout(Duration::from_secs(5), conn.open_bi()).await;
+                    match opened {
+                        Ok(Ok((mut send, mut recv))) => {
+                            send.write_all(&[1u8]).await.ok();
+                            let r = drain(&mut recv, start).await;
+                            format!("stream {i} opened at {:?}: {r}", start.elapsed())
+                        }
+                        _ => format!("stream {i} not opened within 5s"),
+                    }
+                }));
+            }
+            for t in tasks {
+                println!("{}", t.await.unwrap());
+            }
+        }
+        other => panic!("unknown probe {other}"),
+    }
+}
