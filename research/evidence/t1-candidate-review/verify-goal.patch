+#[test]
+fn v_member_fork_voids_other_members_accepted_results() {
+    let mut c = Author::new(1);
+    let mut n = Author::new(2);
+    let mut m = Author::new(3);
+    let (genesis, own) = c.found_goal(EndpointId([1; 32]));
+    let id = genesis.header().goal;
+    let admit_n = c.event(
+        id,
+        Some(own.id()),
+        Body::MemberAdmitted {
+            member: n.key.public(),
+            endpoint: EndpointId([2; 32]),
+        },
+    );
+    let admit_m = c.event(
+        id,
+        Some(admit_n.id()),
+        Body::MemberAdmitted {
+            member: m.key.public(),
+            endpoint: EndpointId([3; 32]),
+        },
+    );
+    let mut events = vec![genesis, own, admit_n, admit_m.clone()];
+    let mut anchor = admit_m.id();
+    let mut base = None;
+    let mut t1 = None;
+    for (index, head) in [100u8, 101, 102].into_iter().enumerate() {
+        let task = if index == 1 {
+            let task = m.event(id, Some(anchor), propose());
+            t1 = Some(task.clone());
+            task
+        } else {
+            c.event(id, Some(anchor), propose())
+        };
+        let assign = c.event(
+            id,
+            Some(anchor),
+            Body::TaskAssigned {
+                task: task.id(),
+                assignee: n.key.public(),
+                attempt: 1,
+            },
+        );
+        let take = n.event(
+            id,
+            Some(assign.id()),
+            Body::AssignmentAccepted {
+                assignment: assign.id(),
+            },
+        );
+        let result = n.event(
+            id,
+            Some(assign.id()),
+            Body::ResultSubmitted {
+                assignment: assign.id(),
+                base,
+                patch: None,
+                artifacts: vec![],
+            },
+        );
+        let accept = c.event(
+            id,
+            Some(assign.id()),
+            Body::ResultAccepted {
+                result: result.id(),
+                head: Some(BlobHash([head; 32])),
+            },
+        );
+        anchor = accept.id();
+        base = Some(BlobHash([head; 32]));
+        events.extend([task, assign, take, result, accept]);
+    }
+    let mut goal = Goal::new(id);
+    goal.apply(&events);
+    let states = |goal: &Goal| -> Vec<TaskState> { goal.state().tasks.iter().map(|t| t.state).collect() };
+    let heads = |goal: &Goal| -> Vec<u8> {
+        goal.state().accepted_heads.iter().map(|h| h.head.0[0]).collect()
+    };
+    println!("before fork: tasks {:?} heads {:?}", states(&goal), heads(&goal));
+    assert_eq!(heads(&goal), vec![100, 101, 102]);
+    let t1 = t1.unwrap();
+    let fork = variant(&m, &t1, 0);
+    let screened = goal.screen(vec![fork]);
+    assert_eq!(screened.len(), 1);
+    goal.apply(&screened);
+    println!("after M forks: tasks {:?} heads {:?} halt {:?}", states(&goal), heads(&goal), goal.halt());
+    for event in &events[4..] {
+        println!(
+            "  {:>20} by {} -> {:?}",
+            event.header().body.kind(),
+            if event.header().author == c.key.public() { "C" } else if event.header().author == n.key.public() { "N" } else { "M" },
+            goal.standing(&event.id())
+        );
+    }
+}
