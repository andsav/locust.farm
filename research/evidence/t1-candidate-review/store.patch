+#[test]
+fn p6_a_high_last_position_leaves_a_gap_and_a_low_one_fails_every_commit() {
+    let root = tempfile::tempdir().unwrap();
+    let dir = root.path().join("state");
+    let mut owner = Author::new(1);
+    let genesis = owner.genesis();
+    let goal = genesis.header().goal;
+    let a = owner.event(goal, Some(genesis.id()), note());
+    {
+        let mut store = SqliteStore::open(&dir).unwrap();
+        store
+            .commit(&Commit {
+                events: vec![genesis.clone(), a],
+                ..Commit::default()
+            })
+            .unwrap();
+    }
+    let raw = rusqlite::Connection::open(dir.join("locust.db")).unwrap();
+    raw.execute("UPDATE goals SET last_position = 6", []).unwrap();
+    drop(raw);
+    {
+        let mut store = SqliteStore::open(&dir).unwrap();
+        let b = owner.event(goal, Some(genesis.id()), note());
+        let result = store.commit(&Commit {
+            events: vec![b],
+            ..Commit::default()
+        });
+        let log = store.log(&goal, 0, 10).unwrap();
+        eprintln!(
+            "[probe] high: commit {result:?}; positions {:?}",
+            log.iter().map(|(p, _)| *p).collect::<Vec<_>>()
+        );
+    }
+    let raw = rusqlite::Connection::open(dir.join("locust.db")).unwrap();
+    raw.execute("UPDATE goals SET last_position = 1", []).unwrap();
+    drop(raw);
+    let mut store = SqliteStore::open(&dir).unwrap();
+    for _ in 0..2 {
+        let c = owner.event(goal, Some(genesis.id()), note());
+        let result = store.commit(&Commit {
+            events: vec![c],
+            ..Commit::default()
+        });
+        eprintln!("[probe] low: commit {result:?}");
+    }
+}
