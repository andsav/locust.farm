+/// A member signs sixteen more events at the position of one that a decision
+/// already names, each with a lower identifier.
+#[test]
+fn probe_variant_bound_stalls_a_late_replica() {
+    let mut c = Author::new(1);
+    let mut m = Author::new(2);
+    let j = Author::new(3);
+    let (genesis, own) = c.found_goal(EndpointId([1; 32]));
+    let goal = genesis.header().goal;
+    let admit_m = c.event(
+        goal,
+        Some(own.id()),
+        Body::MemberAdmitted { member: m.key.public(), endpoint: EndpointId([2; 32]) },
+    );
+    let task = m.event(goal, Some(admit_m.id()), propose());
+    let assign = c.event(
+        goal,
+        Some(admit_m.id()),
+        Body::TaskAssigned { task: task.id(), assignee: c.key.public(), attempt: 1 },
+    );
+    let admit_j = c.event(
+        goal,
+        Some(assign.id()),
+        Body::MemberAdmitted { member: j.key.public(), endpoint: EndpointId([3; 32]) },
+    );
+    let mut all = vec![genesis, own, admit_m.clone(), task.clone(), assign.clone(), admit_j.clone()];
+
+    let mut a = Goal::new(goal);
+    for event in &all {
+        assert_eq!(receive(&mut a, vec![event.clone()]), 1);
+    }
+    assert_eq!(a.standing(&assign.id()), Some(Standing::Effective));
+
+    // Sixteen conflicting events at the task's position, identifiers below it.
+    let mut variants = Vec::new();
+    let mut tries = 0u64;
+    while variants.len() < 16 {
+        tries += 1;
+        let mut header = task.header().clone();
+        header.at_ms += tries;
+        let variant = Event::sign(header, &m.key).unwrap();
+        if variant.id() < task.id() {
+            variants.push(variant);
+        }
+    }
+    eprintln!("signed {tries} variants to get 16 below the task's identifier");
+    all.extend(variants.iter().cloned());
+    for variant in &variants {
+        receive(&mut a, vec![variant.clone()]);
+    }
+    eprintln!(
+        "A: holds task {} head_is_last {} assign {:?} joiner member {}",
+        a.holds(&task.id()),
+        a.state().head == Some(admit_j.id()),
+        a.standing(&assign.id()),
+        a.state().is_member(&j.key.public())
+    );
+
+    let mut b = Goal::new(goal);
+    let passes = reconcile(&mut b, &all);
+    eprintln!(
+        "B: passes {} holds {} of {} holds task {} head_is_admit_m {} assign {:?} joiner member {} coordinator next {:?}",
+        passes,
+        b.len(),
+        all.len(),
+        b.holds(&task.id()),
+        b.state().head == Some(admit_m.id()),
+        b.standing(&assign.id()),
+        b.state().is_member(&j.key.public()),
+        b.next(&c.key.public()).is_some(),
+    );
+    assert_eq!(b.screen(all.clone()).len(), 0);
+    assert_eq!(a.state(), b.state(), "replicas that reconciled to quiescence differ");
+}
