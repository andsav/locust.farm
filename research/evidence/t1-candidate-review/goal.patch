+//! Review probes: concrete scenarios.
+#![allow(dead_code, clippy::all)]
+
+use super::{Goal, Standing, TaskState};
+use locust_proto::event::{Body, Event};
+use locust_proto::id::{BlobHash, EndpointId, EventId, GoalId};
+use locust_proto::testkit::Author;
+
+fn note() -> Body {
+    Body::Note {
+        about: None,
+        supersedes: None,
+    }
+}
+
+fn propose() -> Body {
+    Body::TaskProposed {
+        input: None,
+        depends_on: vec![],
+        deadline_ms: None,
+        max_attempts: None,
+    }
+}
+
+/// Feeds `events` the way the node does: screen, then apply what was kept.
+fn receive(goal: &mut Goal, events: Vec<Event>) -> usize {
+    let kept = goal.screen(events);
+    let count = kept.len();
+    goal.apply(&kept);
+    count
+}
+
+/// Offers everything `goal` lacks the way an exchange does: one author at a
+/// time in ascending key order, each author's events ascending by (position,
+/// identifier) in frames of 256, until a whole pass keeps nothing. Returns
+/// the number of passes.
+fn reconcile(goal: &mut Goal, all: &[Event]) -> usize {
+    let mut passes = 0;
+    loop {
+        passes += 1;
+        let mut missing: Vec<Event> = all
+            .iter()
+            .filter(|event| !goal.holds(&event.id()))
+            .cloned()
+            .collect();
+        missing.sort_by_key(|event| (event.header().author, event.header().seq, event.id()));
+        let mut kept = 0;
+        let mut at = 0;
+        while at < missing.len() {
+            let author = missing[at].header().author;
+            let mut end = at;
+            while end < missing.len() && end - at < 256 && missing[end].header().author == author {
+                end += 1;
+            }
+            kept += receive(goal, missing[at..end].to_vec());
+            at = end;
+        }
+        if kept == 0 || passes > 50 {
+            return passes;
+        }
+    }
+}
