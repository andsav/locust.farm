+/// A goal that changes while its exchange is in flight is synchronized
+/// again once it ends, without waiting for anti-entropy.
+#[test]
+fn review_change_during_flight_resyncs_promptly() {
+    let founded = Founded::new();
+    let mut net = Net::new(vec![
+        host(1, founded.replica(&[]), &[1, 2]),
+        host(2, founded.replica(&[]), &[1, 2]),
+    ]);
+    net.poll(&[0, 1]);
+    net.tick(31_000);
+    // Open an exchange from node 0 and add an event before any frame moves.
+    net.tick(31_000);
+    net.poll_without_settling(&[0]);
+    let late = founded.notes(&mut Author::new(5), 1);
+    net.host(0).replica_mut(&founded.goal).insert(&late);
+    net.settle();
+    // One poll a second later must carry it.
+    net.tick(1_000);
+    net.tick(1_000);
+    assert!(net.host(1).ids(&founded.goal).contains(&late[0].id()));
+}
