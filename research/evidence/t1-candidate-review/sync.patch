+/// Duplicated, overlapping exchanges over many frames, with cuts, converge
+/// for two replicas holding interleaved gaps in a long log.
+#[test]
+fn review_cut_and_overlap_convergence_with_paged_inventories() {
+    let founded = Founded::new();
+    let mut writer = Author::new(2);
+    let log = founded.notes(&mut writer, 9000);
+    let left: Vec<Event> = log
+        .iter()
+        .enumerate()
+        .filter(|(i, _)| i % 7 != 3)
+        .map(|(_, e)| e.clone())
+        .collect();
+    let right: Vec<Event> = log
+        .iter()
+        .enumerate()
+        .filter(|(i, _)| i % 11 != 5)
+        .map(|(_, e)| e.clone())
+        .collect();
+    let all: BTreeSet<EventId> = left
+        .iter()
+        .chain(&right)
+        .map(Event::id)
+        .chain([founded.genesis.id()])
+        .collect();
+    let log: Vec<Event> = log
+        .into_iter()
+        .filter(|e| all.contains(&e.id()))
+        .collect();
+    for cut in [0usize, 1, 2, 3, 4, 5, 7, 9, 13, 20, 40, 41, 42, 43, 60] {
+        let mut net = Net::new(vec![
+            host(1, founded.replica(&left), &[1, 2]),
+            host(2, founded.replica(&right), &[1, 2]),
+        ]);
+        net.cut = Some(cut);
+        net.poll_without_settling(&[0, 1]);
+        net.poll_without_settling(&[1, 0]);
+        net.settle();
+        for _ in 0..3 {
+            net.tick(61_000);
+        }
+        for node in &net.nodes {
+            assert!(node.host.ids(&founded.goal).is_subset(&all));
+        }
+        net.cut = None;
+        net.tick(61_000);
+        net.quiesce();
+        let mut bad = false;
+        for (i, node) in net.nodes.iter().enumerate() {
+            let held = node.host.ids(&founded.goal);
+            let missing: Vec<usize> = log
+                .iter()
+                .enumerate()
+                .filter(|(_, e)| !held.contains(&e.id()))
+                .map(|(i, _)| i)
+                .collect();
+            if !missing.is_empty() {
+                bad = true;
+                eprintln!(
+                    "cut {cut}: node {i} holds {} of {}, missing seqs (first 10) {:?} count {}",
+                    held.len(),
+                    all.len(),
+                    &missing[..missing.len().min(10)],
+                    missing.len()
+                );
+            }
+        }
+        assert_eq!(net.oversized, 0);
+        assert!(!bad, "cut {cut}");
+    }
+}
