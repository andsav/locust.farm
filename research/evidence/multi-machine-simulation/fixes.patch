+                    for open in opens.take().into_iter().flatten() {
+                        let _ = out.send(NetworkOutput::Action(open));
+                    }
+                }
+                let _ = inputs.send(input);
+            }
+        });
+        let (stop, stopped) = watch::channel(false);
+        tokio::spawn(serve(endpoint, jobs, output, stopped));
+        (seen, stop)
+    }
