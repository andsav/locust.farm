+/// H4/H5: sessions, claims, cancellation ownership.
+#[test]
+fn probe_h5_sessions_claims_and_cancel() {
+    use locust_proto::event::CancelOutcome;
+    let (mut daemon, principal, owner, a, goal) = setup();
+    let worker = daemon.enroll("worker", 2, true);
+    // Without a session.
+    let (_, assignment) = assigned(&mut daemon, a, goal, principal);
+    let bare = daemon.connect(credential(1), None);
+    assert_eq!(
+        code(daemon.call(bare, Request::TaskClaim { goal, assignment })),
+        ErrorCode::Invalid
+    );
+    // Owner on behalf with no session is Invalid, grants not consulted with one.
+    assert_eq!(
+        code(daemon.on_behalf(owner, principal, Request::TaskClaim { goal, assignment })),
+        ErrorCode::Invalid
+    );
+    let owner_s = daemon.connect(OWNER, Some(session(5)));
+    let Response::Claimed(claim) = daemon
+        .on_behalf(owner_s, principal, Request::TaskClaim { goal, assignment })
+        .unwrap()
+    else {
+        panic!()
+    };
+    assert_eq!(claim.generation, 1);
+    // The owner's session is now bound to `principal`: using it as another is Denied.
+    let record = locust_proto::api::SessionRecord {
+        client: "x".into(),
+        state: locust_proto::api::SessionState::Ready,
+        client_session: None,
+        capabilities: Default::default(),
+        detail: vec![],
+    };
+    assert_eq!(
+        code(daemon.on_behalf(
+            owner_s,
+            worker,
+            Request::SessionReport {
+                record: record.clone()
+            }
+        )),
+        ErrorCode::Denied
+    );
+    // The agent's own session cannot write under the claim, nor claim it.
+    assert_eq!(
+        code(daemon.call(a, Request::TaskClaim { goal, assignment })),
+        ErrorCode::ClaimHeld
+    );
+    assert_eq!(
+        code(daemon.call(
+            a,
+            Request::TaskProgress {
+                goal,
+                assignment,
+                generation: 1,
+                text: "x".into()
+            }
+        )),
+        ErrorCode::Superseded
+    );
+    // Takeover without a grant.
+    assert_eq!(
+        code(daemon.call(a, Request::TaskTakeover { goal, assignment })),
+        ErrorCode::AuthorizationRequired
+    );
+    // execute is not enough.
+    daemon.ok(
+        owner,
+        Request::GoalGrant {
+            goal,
+            agent: principal,
+            grants: locust_proto::api::GoalGrants {
+                execute: true,
+                decide: true,
+                takeover: false,
+            },
+        },
+    );
+    assert_eq!(
+        code(daemon.call(a, Request::TaskTakeover { goal, assignment })),
+        ErrorCode::AuthorizationRequired
+    );
+    // Cancel: only the holder answers.
+    let cancel = event(daemon.ok(a, Request::TaskCancel { goal, assignment }));
+    for generation in [None, Some(1), Some(2)] {
+        assert_eq!(
+            code(daemon.call(
+                a,
+                Request::CancelAcknowledge {
+                    goal,
+                    cancel,
+                    generation,
+                    outcome: CancelOutcome::Stopped
+                }
+            )),
+            ErrorCode::Superseded
+        );
+    }
+    assert!(pending(&mut daemon, a, goal).to_acknowledge.is_empty());
+    // The holder at a wrong generation.
+    assert_eq!(
+        code(daemon.on_behalf(
+            owner_s,
+            principal,
+            Request::CancelAcknowledge {
+                goal,
+                cancel,
+                generation: None,
+                outcome: CancelOutcome::Stopped
+            }
+        )),
+        ErrorCode::Superseded
+    );
+    // Another principal's session cannot answer either.
+    let w = daemon.connect(credential(2), Some(session(5)));
+    println!(
+        "H5 other principal with the holder's secret acks: {:?}",
+        daemon.call(
+            w,
+            Request::CancelAcknowledge {
+                goal,
+                cancel,
+                generation: Some(1),
+                outcome: CancelOutcome::Stopped
+            }
+        )
+    );
+    println!(
+        "H5 other principal with the holder's secret session.show: {:?}",
+        daemon.call(w, Request::Session { instance: None })
+    );
+    println!(
+        "H5 other principal with the holder's secret sessions: {:?}",
+        daemon.call(w, Request::Sessions)
+    );
+    daemon
+        .on_behalf(
+            owner_s,
+            principal,
+            Request::CancelAcknowledge {
+                goal,
+                cancel,
+                generation: Some(1),
+                outcome: CancelOutcome::Stopped,
+            },
+        )
+        .unwrap();
+    // After the answer, a second answer conflicts.
+    assert_eq!(
+        code(daemon.on_behalf(
+            owner_s,
+            principal,
+            Request::CancelAcknowledge {
+                goal,
+                cancel,
+                generation: Some(1),
+                outcome: CancelOutcome::Stopped
+            }
+        )),
+        ErrorCode::Conflict
+    );
+}
