+            }
+        ))
+    );
+    peers[2].agent(31, Request::GoalJoin { ticket: t2 }).unwrap();
+    let before = peers[0].events(&goal);
+    sync(&mut peers, &mut at);
+    println!(
+        "join after coordinator left admitted: {} (events {} -> {})",
+        peers[0].is_member(&goal, &m2),
+        before,
+        peers[0].events(&goal)
+    );
+    peers[0].restart();
+    println!(
+        "after restart assign by owner for alice: {}",
+        code(peers[0].owner(
