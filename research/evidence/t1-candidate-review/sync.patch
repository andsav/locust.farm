+/// The common live case: an author writes one event and dials a peer that
+/// holds every earlier event of that author. What does the exchange carry?
+#[test]
+fn review2_cost_of_pushing_one_event_to_a_peer_one_behind() {
+    for count in [10usize, 1_000, 10_000] {
+        let founded = Founded::new();
+        let mut writer = Author::new(2);
+        let notes: Vec<Event> = founded.notes(&mut writer, count);
+        let behind = &notes[..count - 1];
+        let mut net = Net::new(vec![
+            host(1, founded.replica(&notes), &[1, 2]),
+            host(2, founded.replica(behind), &[1, 2]),
+        ]);
+        // Only node 0 dials.
+        net.poll(&[0]);
+        let inventory_points: usize = net
+            .log
+            .iter()
+            .map(|(_, f)| match f {
+                SyncMessage::Inventory { points, .. } => points.len(),
+                _ => 0,
+            })
+            .sum();
+        let inventory_frames = net
+            .log
+            .iter()
+            .filter(|(_, f)| matches!(f, SyncMessage::Inventory { .. }))
+            .count();
+        let inventory_requests = net
+            .log
+            .iter()
+            .filter(|(_, f)| matches!(f, SyncMessage::InventoryRequest { .. }))
+            .count();
+        let bytes: usize = net
+            .log
+            .iter()
+            .map(|(_, f)| codec::encode(f).unwrap().len())
+            .sum();
+        let events: usize = net
+            .log
+            .iter()
+            .map(|(_, f)| match f {
+                SyncMessage::Events(e) => e.len(),
+                _ => 0,
+            })
+            .sum();
+        eprintln!(
+            "author log {count}, peer one behind: {} frames, {bytes} bytes, {events} events carried, \
+             {inventory_frames} inventory frames with {inventory_points} points, \
+             {inventory_requests} inventory requests (extra round trips)",
+            net.log.len()
+        );
+        let last: EventId = notes[count - 1].id();
+        assert!(net.host(1).ids(&founded.goal).contains(&last));
+        let _ = AuthorPoint {
+            seq: 0,
+            id: last,
+        };
+    }
+}
