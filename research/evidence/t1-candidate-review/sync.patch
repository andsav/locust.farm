+/// Same, with a single frontier listing diverging entries for the authors
+/// the responder holds: one frame in, materialized inventories out.
+#[test]
+fn review2_frontier_answer_materializes_inventories() {
+    let founded = Founded::new();
+    let mut events = Vec::new();
+    let mut authors = Vec::new();
+    for seed in 2..10u8 {
+        let mut writer = Author::new(seed);
+        events.extend(founded.notes(&mut writer, 3000));
+        authors.push(writer.key.public());
+    }
+    authors.sort();
+    let mut host = host(1, founded.replica(&events), &[1, 2]);
+    let mut responder = Responder::new(endpoint(2));
+    let mut out = Vec::new();
+    responder.receive(&mut host, hello(founded.goal), 0, &mut out);
+    let frontier = SyncMessage::Frontier(Frontier {
+        authors: authors
+            .iter()
+            .map(|author| locust_proto::sync::AuthorFrontier {
+                author: *author,
+                next_seq: 1,
+                digest: [7; 32],
+            })
+            .collect(),
+    });
+    let in_bytes = codec::encode(&frontier).unwrap().len();
+    let mut total_in = 0;
+    for _ in 0..50 {
+        responder.receive(&mut host, frontier.clone(), 0, &mut out);
+        total_in += in_bytes;
+    }
+    loop {
+        let before = out.len();
+        responder.writable(&mut host, &mut out);
+        if out.len() == before {
+            break;
+        }
+    }
+    let inv: usize = out
+        .iter()
+        .filter(|f| matches!(f, SyncMessage::Inventory { .. }))
+        .map(|f| codec::encode(f).unwrap().len())
+        .sum();
+    eprintln!(
+        "50 frontiers ({total_in} bytes in) owed {} frames; inventory bytes materialized eagerly {inv}",
+        out.len()
+    );
+}
