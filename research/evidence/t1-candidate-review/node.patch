+/// G3: keys and roles across daemons.
+#[test]
+fn probe_g3_keys_and_roles() {
+    use crate::sync::{Host, Replica};
+    use locust_proto::api::ErrorCode;
+    use locust_proto::crypto::ContentKey;
+    let mut peers = [Peer::new(1), Peer::new(2), Peer::new(3)];
+    let Response::GoalCreated { goal } = peers[0].call(Request::GoalCreate { title: "keys".into() }) else { panic!() };
+    let Response::Invited { ticket } = peers[0].call(Request::GoalInvite { goal, expires_ms: None }) else { panic!() };
+    // A joiner writes nothing before admission.
+    peers[1].call(Request::GoalJoin { ticket });
+    let member = peers[1].principal;
+    let early = try_request(&mut peers[1].node, Some(member), note_req(goal, "too early"));
+    assert_eq!(early.unwrap_err().code, ErrorCode::Unavailable);
+    reconcile(&mut peers, 1000);
+    reconcile(&mut peers, 40000);
+    // A member that does not coordinate: Denied, not AuthorizationRequired, also with decide granted locally.
+    let Response::Recorded { event: task } = peers[1].call(Request::TaskPropose { goal, text: "t".into(), input: None, depends_on: vec![], deadline_ms: None, max_attempts: None }) else { panic!() };
+    request(&mut peers[1].node, None, Request::GoalGrant { goal, agent: member, grants: locust_proto::api::GoalGrants { execute: true, decide: true, takeover: true } });
+    for operation in [
+        Request::TaskAssign { goal, task, assignee: member },
+        Request::MemberRemove { goal, member: peers[0].principal },
+        Request::GoalInvite { goal, expires_ms: None },
+    ] {
+        let name = operation.name();
+        let answer = as_agent(&mut peers[1].node, 40, 2, operation);
+        println!("G3 member's {name}: {:?}", answer.as_ref().map(|_| "ok"));
+        assert_eq!(answer.unwrap_err().code, ErrorCode::Denied);
+    }
+    // The third daemon is not a member: the coordinator's daemon does not speak to it.
+    let stranger = peers[2].endpoint;
+    assert!(!Host::speaks_for_member(&peers[0].node, &goal, &stranger));
+    assert!(Host::speaks_for_member(&peers[0].node, &goal, &peers[1].endpoint));
+    // Removal starts epoch 1; the remaining member accepts only the key that opens the removal's payload.
+    let Response::Invited { ticket } = peers[0].call(Request::GoalInvite { goal, expires_ms: None }) else { panic!() };
+    peers[2].call(Request::GoalJoin { ticket });
+    reconcile(&mut peers, 80000);
+    reconcile(&mut peers, 120000);
+    peers[0].call(Request::MemberRemove { goal, member: peers[2].principal });
+    // Events travel first; stop before the key is fetched by dropping it afterwards.
+    reconcile(&mut peers, 160000);
+    reconcile(&mut peers, 200000);
+    let right = Host::replica(&mut peers[0].node, &goal).unwrap().key(1).unwrap();
+    peers[1].node.replica_goal = None;
+    peers[0].node.replica_goal = None;
+    // A fresh member daemon state without key 1: use peer 1 after forgetting is not possible, so check the rule directly.
+    let replica = Host::replica(&mut peers[1].node, &goal).unwrap();
+    println!("G3 member holds key 1 after exchanges: {}", replica.key(1).is_some());
+    assert!(!replica.offer_key(1, ContentKey([7; 32])), "a wrong key was accepted");
+    assert!(!replica.offer_key(2, right), "a key for an epoch with no proof was accepted");
+    assert!(!replica.offer_key(0, right), "the epoch-1 key was accepted for epoch 0");
+    assert_eq!(replica.key(1).map(|key| key.0), Some(right.0));
+    peers[1].node.replica_goal = None;
+    // The removed daemon is no longer spoken to and holds no key 1.
+    assert!(!Host::speaks_for_member(&peers[0].node, &goal, &stranger));
+    assert!(!Host::speaks_for_member(&peers[1].node, &goal, &stranger));
+    assert!(!peers[2].node.goals[&goal].keys.contains_key(&1));
+    println!("G3 ok");
+}
