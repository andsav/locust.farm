+/// N2: a daemon whose only principal is removed: what it knows and does.
+#[test]
+fn probe_n2_sole_removed_member() {
+    let mut peers = [Peer::new(1), Peer::new(2), Peer::new(3)];
+    let goal = found(&mut peers);
+    reconcile(&mut peers, 40000);
+    let removed = peers[2].principal;
+    peers[0].call(Request::MemberRemove { goal, member: removed });
+    peers[0].call(note_req(goal, "after removal"));
+    for round in 0..6 {
+        reconcile(&mut peers, 80000 + round * 40000);
+    }
+    let Response::Status(status) = peers[2].call(Request::Status) else { panic!() };
+    println!("N2 removed daemon status: {:?}", status.goals);
+    let write = try_request(&mut peers[2].node, Some(removed), note_req(goal, "from the removed member"));
+    println!("N2 removed daemon note.add: {write:?}");
+    for round in 0..6 {
+        reconcile(&mut peers, 400000 + round * 40000);
+    }
+    let Response::Notes(notes) = peers[2].call(Request::Notes { goal, about: None }) else { panic!() };
+    println!("N2 removed daemon notes: {:?}", notes.iter().map(|n| n.text.clone()).collect::<Vec<_>>());
+    let Response::Notes(notes) = peers[1].call(Request::Notes { goal, about: None }) else { panic!() };
+    println!("N2 remaining member notes: {:?}", notes.iter().map(|n| n.text.clone()).collect::<Vec<_>>());
+    println!(
+        "N2 events: coordinator {} member {} removed {}",
+        peers[0].store.log(&goal, 0, usize::MAX).unwrap().len(),
+        peers[1].store.log(&goal, 0, usize::MAX).unwrap().len(),
+        peers[2].store.log(&goal, 0, usize::MAX).unwrap().len()
+    );
+}
