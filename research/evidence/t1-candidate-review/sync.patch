+/// Object staging with a total larger than the object, then an honest peer.
+#[test]
+fn review_test_replica_blob_resume_after_cut() {
+    let founded = Founded::new();
+    let blob = Blob::new((0..3 * 1024 * 1024 + 11).map(|n| n as u8).collect());
+    let hash = blob.hash();
+    let len = blob.bytes().len() as u64;
+    let mut left = founded.replica(&[]);
+    left.wants.insert(hash, len);
+    let mut right = founded.replica(&[]);
+    right.add_blob(blob);
+    for cut in 0..12 {
+        let mut net = Net::new(vec![
+            host(1, founded.replica(&[]), &[1, 2]),
+            host(2, founded.replica(&[]), &[1, 2]),
+        ]);
+        let mut l = founded.replica(&[]);
+        l.wants.insert(hash, len);
+        net.host(0).replicas.insert(founded.goal, l);
+        let mut r = founded.replica(&[]);
+        r.add_blob(Blob::new((0..3 * 1024 * 1024 + 11).map(|n| n as u8).collect()));
+        net.host(1).replicas.insert(founded.goal, r);
+        net.cut = Some(cut);
+        net.poll(&[0]);
+        let staged = net
+            .host(0)
+            .replica_mut(&founded.goal)
+            .store
+            .staged_len(&hash)
+            .unwrap();
+        net.cut = None;
+        net.tick(61_000);
+        assert!(
+            net.host(0).replica_mut(&founded.goal).holds_blob(&hash),
+            "cut {cut} staged {staged}"
+        );
+    }
+    let _ = (left, right);
+}
