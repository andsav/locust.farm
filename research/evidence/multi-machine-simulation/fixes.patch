+            // joiner holds the goal, and is refused.
+            let mut link = connection.open_link(FrameLimits::peer()).await.unwrap();
+            link.send(&hello).await.unwrap();
+            link.send(&SyncMessage::Frontier(Frontier {
+                authors: Vec::new(),
