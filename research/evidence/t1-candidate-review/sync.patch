+#[test]
+fn review_event_request_frame_counts() {
+    let founded = Founded::new();
+    let notes = founded.notes(&mut Author::new(2), 4096);
+    let ids: Vec<EventId> = notes.iter().map(Event::id).collect();
+    let mut host = host(1, founded.replica(&notes), &[1, 2]);
+    let mut report = Vec::new();
+    for n in [0usize, 1, 255, 256, 257, 512, 513, 4096] {
+        let (responder, out) = respond(
+            &mut host,
+            2,
+            vec![
+                hello(founded.goal),
+                SyncMessage::EventRequest(ids[..n].to_vec()),
+            ],
+        );
+        assert!(!responder.is_finished());
+        for frame in &out {
+            let SyncMessage::Events(events) = frame else {
+                panic!("{frame:?}")
+            };
+            assert!(events.len() <= MAX_EVENTS_PER_BATCH);
+            assert!(codec::encode(frame).unwrap().len() <= MAX_PEER_FRAME_BYTES);
+        }
+        report.push((n, out.len(), n.div_ceil(MAX_EVENTS_PER_BATCH)));
+    }
+    eprintln!("(requested, frames sent, frames the grammar implies): {report:?}");
+    for (n, sent, implied) in report {
+        assert_eq!(sent, implied, "EventRequest of {n} ids");
+    }
+}
