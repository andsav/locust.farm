+#[test]
+fn verify_push_one_event_cost() {
+    for n in [10usize, 1000, 10000] {
+        let founded = Founded::new();
+        let mut author = Author::new(2);
+        let notes = founded.notes(&mut author, n + 1);
+        let mut net = Net::new(vec![
+            host(1, founded.replica(&notes), &[1, 2]),
+            host(2, founded.replica(&notes[..n]), &[1, 2]),
+        ]);
+        net.poll(&[0]);
+        let mut inv_frames = 0;
+        let mut inv_points = 0;
+        let mut inv_bytes = 0;
+        let mut inv_requests = 0;
+        let mut pushed = 0;
+        for (to, frame) in &net.log {
+            match frame {
+                SyncMessage::Inventory { points, .. } if *to == 0 => {
+                    inv_frames += 1;
+                    inv_points += points.len();
+                    inv_bytes += codec::encode(frame).unwrap().len();
+                }
+                SyncMessage::InventoryRequest { .. } if *to == 1 => inv_requests += 1,
+                SyncMessage::Events(events) if *to == 1 => pushed += events.len(),
+                _ => {}
+            }
+        }
+        assert_eq!(net.host(1).ids(&founded.goal).len(), n + 2);
+        eprintln!(
+            "PROBE push n={n}: events pushed {pushed}; inventory frames {inv_frames}, points {inv_points}, bytes {inv_bytes}; inventory requests {inv_requests}"
+        );
+    }
+}
