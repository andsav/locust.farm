+/// N7: a parked wait is answered by a change that arrives from a peer, and
+/// by a key or text arriving later.
+#[test]
+fn probe_n7_wait_sees_peer_changes() {
+    use locust_proto::api::WaitOutcome;
+    let mut peers = [Peer::new(1), Peer::new(2)];
+    let goal = found(&mut peers);
+    reconcile(&mut peers, 40000);
+    let member = peers[1].principal;
+    let Response::Pending(work) = peers[1].call(Request::Pending { goal }) else { panic!() };
+    let _ = peers[1].node.take_changed();
+    let frame = RequestFrame { id: 77, idempotency: None, on_behalf: Some(member), request: Request::Wait { goal, seen: work.revision, timeout_ms: 5000 } };
+    let Step::Park(parked) = peers[1].node.request(ConnId(1), frame, 50000) else { panic!("not parked") };
+    peers[0].call(note_req(goal, "wake up"));
+    reconcile(&mut peers, 80000);
+    let changed = Engine::take_changed(&mut peers[1].node);
+    println!("N7 changed after peer event: {}", changed.contains(&goal));
+    assert!(changed.contains(&goal));
+    let Step::Reply(reply) = peers[1].node.resume(ConnId(1), &parked, false, 80001) else { panic!("still parked") };
+    let Response::Waited(WaitOutcome::Work(work2)) = reply.result.unwrap() else { panic!() };
+    println!("N7 revision {} -> {}", work.revision, work2.revision);
+    assert!(work2.revision > work.revision);
+    // Nothing changed: a resume without timeout parks again, with timeout answers.
+    let frame = RequestFrame { id: 78, idempotency: None, on_behalf: Some(member), request: Request::Wait { goal, seen: work2.revision, timeout_ms: 5000 } };
+    let step = peers[1].node.request(ConnId(1), frame, 90000);
+    let Step::Park(parked) = step else {
+        // later exchanges may have moved the revision (keys, content)
+        println!("N7 second wait answered at once: {step:?}");
+        return;
+    };
+    assert!(matches!(peers[1].node.resume(ConnId(1), &parked, false, 90001), Step::Park(_)));
+    let Step::Reply(reply) = peers[1].node.resume(ConnId(1), &parked, true, 95001) else { panic!() };
+    println!("N7 timed out: {:?}", reply.result);
+}
