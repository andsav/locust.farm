+#[cfg(test)]
+mod vd_probe {
+    use super::*;
+    use locust_net::{EndpointConfig, IpTransport, Lookup, RelayConfig, TransportBudget};
+    use locust_proto::id::BlobHash;
+    use std::time::Instant;
+
+    async fn endpoint(seed: u8) -> Endpoint {
+        Endpoint::bind(EndpointConfig {
+            secret_key: [seed; 32],
+            relays: RelayConfig::Disabled,
+            lookup: Lookup::DISABLED,
+            ip_transport: IpTransport::Bind("127.0.0.1:0".parse().unwrap()),
+            port_mapping: false,
+            budget: TransportBudget::default(),
+        })
+        .await
+        .unwrap()
+    }
+
+    fn chunk(i: u64) -> SyncMessage {
+        SyncMessage::BlobChunk { hash: BlobHash([7; 32]), offset: i * 1024, total: 1 << 26, bytes: vec![1; 1024] }
+    }
+
+    /// Returns (local connection, remote connection)
+    async fn pair() -> (Endpoint, Endpoint, PeerConnection, PeerConnection) {
+        let a = endpoint(11).await;
+        let b = endpoint(22).await;
+        let b2 = b.clone();
+        let accept = tokio::spawn(async move { b2.accept().await.unwrap().accept().await.unwrap() });
+        let ca = a.connect(b.id(), &b.hints()).await.unwrap();
+        let cb = accept.await.unwrap();
+        (a, b, ca, cb)
+    }
+
+    /// Fake engine thread: acks every frame, counts frames, forwards Finished/Closed.
+    fn fake_engine() -> (Sender<Job>, std::sync::mpsc::Receiver<String>, Arc<std::sync::atomic::AtomicUsize>) {
+        let (jobs, rx) = std::sync::mpsc::channel::<Job>();
+        let (ends, ends_rx) = std::sync::mpsc::channel();
+        let count = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+        let c = count.clone();
+        std::thread::spawn(move || {
+            while let Ok(job) = rx.recv() {
+                match job {
+                    Job::PeerFrame { processed, .. } => { c.fetch_add(1, Ordering::SeqCst); let _ = processed.send(()); }
+                    Job::Peer(PeerInput::Finished(_)) => { let _ = ends.send("finished".to_string()); }
+                    Job::Peer(PeerInput::Closed(_)) => { let _ = ends.send("closed".to_string()); }
+                    _ => {}
+                }
+            }
+        });
+        (jobs, ends_rx, count)
+    }
+
+    #[tokio::test]
+    async fn receive_only_side_aborts_at_io_idle() {
+        let (_a, _b, ca, cb) = pair().await;
+        let (jobs, ends, count) = fake_engine();
+        let (events, _ev) = mpsc::unbounded_channel();
+        let (_stop_tx, stop) = watch::channel(false);
+        // Remote opens a stream to us and keeps streaming one frame every 2 s.
+        let started = Instant::now();
+        let remote = tokio::spawn(async move {
+            let mut link = cb.open_link(FrameLimits::peer()).await.unwrap();
+            let mut sent = 0u64;
+            loop {
+                if let Err(e) = link.send(&chunk(sent)).await { return (sent, format!("{e}"), started.elapsed()); }
+                sent += 1;
+                tokio::time::sleep(Duration::from_secs(2)).await;
+                if sent > 30 { return (sent, "done".into(), started.elapsed()); }
+            }
+        });
+        let link = ca.accept_link(FrameLimits::peer()).await.unwrap();
+        let (_cmd_tx, cmd_rx) = mpsc::unbounded_channel();
+        let (_adm_tx, adm) = watch::channel(true);
+        exchange_task(link, ca.clone(), ExchangeId::Accepted(1), cmd_rx, adm, jobs, events, stop).await;
+        let end_at = started.elapsed();
+        let outcome = ends.recv_timeout(Duration::from_secs(1)).ok();
+        let r = remote.await.unwrap();
+        eprintln!("PROBE1 engine got {} frames, exchange ended {:?} at {:?}, remote {:?}", count.load(Ordering::SeqCst), outcome, end_at, r);
+    }
+
+    #[tokio::test]
+    async fn send_only_side_aborts_at_io_idle() {
+        let (_a, _b, ca, cb) = pair().await;
+        let (jobs, ends, _count) = fake_engine();
+        let (events, _ev) = mpsc::unbounded_channel();
+        let (_stop_tx, stop) = watch::channel(false);
+        let started = Instant::now();
+        let link = ca.open_link(FrameLimits::peer()).await.unwrap();
+        let (cmd_tx, cmd_rx) = mpsc::unbounded_channel();
+        let (_adm_tx, adm) = watch::channel(true);
+        // Engine side: queue one Send every 2 s.
+        let feeder = tokio::spawn(async move {
+            let mut n = 0u64;
+            loop {
+                if cmd_tx.send(Command::Send(chunk(n))).is_err() { return n; }
+                n += 1;
+                tokio::time::sleep(Duration::from_secs(2)).await;
+                if n > 30 { return n; }
+            }
+        });
+        let remote = tokio::spawn(async move {
+            let mut link = cb.accept_link(FrameLimits::peer()).await.unwrap();
+            let mut got = 0;
+            loop {
+                match link.recv().await {
+                    Ok(Some(_)) => got += 1,
+                    other => return (got, format!("{other:?}"), started.elapsed()),
+                }
+            }
+        });
+        exchange_task(link, ca.clone(), ExchangeId::Dialed(1), cmd_rx, adm, jobs, events, stop).await;
+        let end_at = started.elapsed();
+        let outcome = ends.recv_timeout(Duration::from_secs(1)).ok();
+        let r = remote.await.unwrap();
+        feeder.abort();
+        eprintln!("PROBE2 exchange ended {:?} at {:?}, remote read {:?}", outcome, end_at, r);
+    }
