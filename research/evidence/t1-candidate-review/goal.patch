+//! Review probe: the coordinator removes itself.
+use super::lifecycle::{event, setup};
+use super::*;
+
+#[test]
+fn probe_coordinator_self_removal_ends_all_decisions() {
+    let (mut daemon, principal, owner, agent, goal) = setup();
+    let task = event(daemon.ok(
+        agent,
+        Request::TaskPropose {
+            goal,
+            text: "work".into(),
+            input: None,
+            depends_on: vec![],
+            deadline_ms: None,
+            max_attempts: None,
+        },
+    ));
+    let removal = daemon.call(agent, Request::MemberRemove { goal, member: principal });
+    eprintln!("self-removal: {removal:?}");
+    assert!(removal.is_ok());
+    let assign = daemon.call(agent, Request::TaskAssign { goal, task, assignee: principal });
+    eprintln!("task.assign after: {assign:?}");
+    let invite = daemon.call(agent, Request::GoalInvite { goal, expires_ms: None });
+    eprintln!("goal.invite after: {invite:?}");
+    let invite_owner = daemon.on_behalf(owner, principal, Request::GoalInvite { goal, expires_ms: None });
+    eprintln!("goal.invite by owner on behalf: {invite_owner:?}");
+    let status = daemon.call(owner, Request::GoalStatus { goal });
+    eprintln!("status: {status:?}");
+    let entry = &daemon.node.goals[&goal];
+    eprintln!("halt {:?} members {} next {:?}", entry.goal.halt(), entry.state().members.len(), entry.goal.next(&principal).is_some());
+}
