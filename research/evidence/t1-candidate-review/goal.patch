+/// Offers `all` to `goal` the way exchanges do (one author per frame, each
+/// author ascending) until a whole pass keeps nothing.
+fn settle(goal: &mut Goal, all: &[Event], rng: &mut Rng) -> usize {
+    let mut passes = 0;
+    loop {
+        passes += 1;
+        let mut missing: Vec<Event> = all
+            .iter()
+            .filter(|event| !goal.holds(&event.id()))
+            .cloned()
+            .collect();
+        missing.sort_by_key(|event| (event.header().author, event.header().seq, event.id()));
+        let mut kept = 0;
+        let mut at = 0;
+        while at < missing.len() {
+            let author = missing[at].header().author;
+            let frame = 1 + rng.below(40);
+            let mut end = at;
+            while end < missing.len() && end - at < frame && missing[end].header().author == author {
+                end += 1;
+            }
+            let screened = goal.screen(missing[at..end].to_vec());
+            kept += screened.len();
+            goal.apply(&screened);
+            at = end;
+        }
+        if kept == 0 {
+            return passes;
+        }
+        assert!(passes < 100, "reconciliation does not settle");
+    }
+}
