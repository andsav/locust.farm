+//! Review probes. Run the test binary directly with
+//! DYLD_INSERT_LIBRARIES=<liblrc.dylib> and --test-threads=1; the interposer
+//! prints the flushes, renames and unlinks between the markers.
+
+use std::env;
+use std::fs;
+use std::path::Path;
+use std::process::Command;
+
+use locust_proto::event::Body;
+use locust_proto::limits::BLOB_CHUNK_BYTES;
+use locust_proto::store::{Blob, Commit, Store};
+use locust_proto::testkit::Author;
+use locust_store::{INLINE_MAX_BYTES, SqliteStore};
+
+const CHILD_DIR: &str = "LRC_PROBE_CHILD_DIR";
+
+fn set(key: &str, value: &str) {
+    unsafe { env::set_var(key, value) }
+}
+
+fn unset(key: &str) {
+    unsafe { env::remove_var(key) }
+}
+
+fn mark(label: &str) {
+    eprintln!("[probe] ---- {label} ----");
+}
+
+fn object(len: usize) -> Blob {
+    Blob::new((0..len).map(|n| (n % 251) as u8 ^ len as u8).collect())
+}
+
+fn files(dir: &Path) -> Vec<String> {
+    let mut names: Vec<String> = fs::read_dir(dir.join("blobs"))
+        .unwrap()
+        .map(|e| e.unwrap().file_name().into_string().unwrap())
+        .collect();
+    names.sort();
+    names
+}
+
+fn note() -> Body {
+    Body::Note {
+        about: None,
+        supersedes: None,
+    }
+}
+
+/// Child: commit A (genesis and a large object, acknowledged), then commit B
+/// (a note and the drop of that object) which dies at its WAL flush.
+#[test]
+#[ignore = "child"]
+fn child_dies_at_wal_flush() {
+    let Some(dir) = env::var_os(CHILD_DIR) else {
+        return;
+    };
+    let mut store = SqliteStore::open(&dir).unwrap();
+    let mut owner = Author::new(1);
+    let genesis = owner.genesis();
+    let goal = genesis.header().goal;
+    let large = object(INLINE_MAX_BYTES + 1);
+    store
+        .commit(&Commit {
+            events: vec![genesis.clone()],
+            blobs: vec![large.clone()],
+            ..Commit::default()
+        })
+        .unwrap();
+    eprintln!("[child] commit A acknowledged");
+    let next = owner.event(goal, Some(genesis.id()), note());
+    set("LRC_DIE", "-wal");
+    let _ = store.commit(&Commit {
+        events: vec![next],
+        drop_blobs: vec![large.hash()],
+        ..Commit::default()
+    });
+    eprintln!("[child] commit B returned (unexpected)");
+}
+
+#[test]
+fn p1_open_serves_and_acts_on_unflushed_wal_frames() {
+    let root = tempfile::tempdir().unwrap();
+    let dir = root.path().join("state");
+    let status = Command::new(env::current_exe().unwrap())
+        .args([
+            "child_dies_at_wal_flush",
+            "--exact",
+            "--ignored",
+            "--nocapture",
+            "--test-threads=1",
+        ])
+        .env(CHILD_DIR, &dir)
+        .status()
+        .unwrap();
+    eprintln!("[probe] child exit status {status:?}");
+    let mut owner = Author::new(1);
+    let genesis = owner.genesis();
+    let goal = genesis.header().goal;
+    let next = owner.event(goal, Some(genesis.id()), note());
+    let large = object(INLINE_MAX_BYTES + 1);
+    eprintln!("[probe] files before open: {:?}", files(&dir));
+    set("LRC_TRACE", "1");
+    mark("open");
+    let store = SqliteStore::open(&dir).unwrap();
+    mark("reads");
+    let log = store.log(&goal, 0, 10).unwrap();
+    let held = store.blob_len(&large.hash()).unwrap();
+    mark("end");
+    set("LRC_TRACE", "0");
+    eprintln!(
+        "[probe] log positions {:?}; unacknowledged note present: {}; large held: {:?}; files after open: {:?}",
+        log.iter().map(|(p, _)| *p).collect::<Vec<_>>(),
+        log.iter().any(|(_, e)| *e == next),
+        held,
+        files(&dir)
+    );
+    drop(store);
+}
