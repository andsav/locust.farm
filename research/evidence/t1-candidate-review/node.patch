+/// H1: a co-hosted principal that never was a member redeems a ticket it
+/// made up for a goal another local principal is in, and reads its text.
+#[test]
+fn probe_h1_fabricated_join_reads_another_principals_goal() {
+    let (mut daemon, coordinator, _owner, agent, goal) = setup();
+    daemon.ok(agent, note(goal, "coordinator private finding"));
+    let (task, _) = assigned(&mut daemon, agent, goal, coordinator);
+    let revision = event(daemon.ok(
+        agent,
+        Request::DocRevise {
+            goal,
+            doc: Doc::Plan,
+            base: None,
+            text: "The private plan".into(),
+        },
+    ));
+    daemon.ok(agent, Request::DocAccept { goal, revision });
+    let Response::BlobStored { hash } = daemon.ok(
+        agent,
+        Request::BlobPut {
+            goal,
+            bytes: b"private file bytes".to_vec(),
+        },
+    ) else {
+        panic!()
+    };
+
+    let _other = daemon.enroll("other", 2, true);
+    let other = daemon.connect(credential(2), None);
+    // Before: the goal does not exist for it.
+    assert_eq!(
+        code(daemon.call(other, Request::Board { goal })),
+        ErrorCode::NotFound
+    );
+    assert_eq!(
+        code(daemon.call(other, Request::Notes { goal, about: None })),
+        ErrorCode::NotFound
+    );
+    // It makes up a ticket: any secret, any endpoint.
+    let ticket = Invitation {
+        version: locust_proto::PROTOCOL_VERSION,
+        goal,
+        coordinator,
+        endpoint: EndpointId([77; 32]),
+        hints: vec![],
+        secret: InviteSecret([5; 32]),
+        expires_ms: None,
+    }
+    .to_ticket()
+    .unwrap();
+    let joined = daemon.call(other, Request::GoalJoin { ticket });
+    println!("H1 join answer: {joined:?}");
+    let Ok(Response::Joined { membership, .. }) = joined else {
+        panic!("join refused")
+    };
+    assert_eq!(membership, Membership::Joining);
+
+    let notes = daemon.call(other, Request::Notes { goal, about: None });
+    println!("H1 notes: {notes:?}");
+    let shown = daemon.call(other, Request::Task { goal, task });
+    println!("H1 task.show: {shown:?}");
+    let doc = daemon.call(
+        other,
+        Request::DocRead {
+            goal,
+            doc: Doc::Plan,
+        },
+    );
+    println!("H1 doc.read: {doc:?}");
+    let blob = daemon.call(other, Request::BlobGet { goal, hash });
+    println!("H1 blob.get: {blob:?}");
+    let status = daemon.call(other, Request::GoalStatus { goal });
+    println!("H1 goal.status: {status:?}");
+    let board = daemon.call(other, Request::Board { goal });
+    println!("H1 board: {board:?}");
+    let ws = daemon.call(
+        other,
+        Request::WorkspaceSet {
+            goal,
+            binding: Default::default(),
+        },
+    );
+    println!("H1 workspace.set: {ws:?}");
+    let write = daemon.call(other, note(goal, "intruder"));
+    println!("H1 note.add: {write:?}");
+
+    // And the daemon dials the made-up endpoint with a signed join.
+    let mut out = Vec::new();
+    daemon.node.peer(PeerInput::Poll, 5_000, &mut out);
+    println!("H1 poll outputs: {out:?}");
+    let exchange = out
+        .iter()
+        .find_map(|output| match output {
+            PeerOutput::Open {
+                exchange, endpoint, ..
+            } if *endpoint == EndpointId([77; 32]) => Some(*exchange),
+            _ => None,
+        })
+        .expect("dials the ticket endpoint");
+    let mut frames = Vec::new();
+    let mut feed = |daemon: &mut Daemon, input: PeerInput, frames: &mut Vec<SyncMessage>| {
+        let mut queue = vec![input];
+        while let Some(input) = queue.pop() {
+            let mut out = Vec::new();
+            daemon.node.peer(input, 5_001, &mut out);
+            for output in out {
+                if let PeerOutput::Send { exchange, frame } = output {
+                    frames.push(frame);
+                    queue.push(PeerInput::Writable(exchange));
+                }
+            }
+        }
+    };
+    feed(&mut daemon, PeerInput::Opened(exchange), &mut frames);
+    // The attacker's endpoint answers the join with an empty frontier, and
+    // the frontier exchange with an empty frontier again.
+    let empty = Frontier { authors: vec![] };
+    feed(
+        &mut daemon,
+        PeerInput::Frame {
+            exchange,
+            frame: SyncMessage::Frontier(empty.clone()),
+        },
+        &mut frames,
+    );
+    feed(
+        &mut daemon,
+        PeerInput::Frame {
+            exchange,
+            frame: SyncMessage::Frontier(empty),
+        },
+        &mut frames,
+    );
+    let _ = ExchangeId::Dialed(0);
+    for frame in &frames {
+        match frame {
+            SyncMessage::Events(events) => println!("H1 sent Events x{}", events.len()),
+            other => println!("H1 sent {}", format!("{other:?}").chars().take(80).collect::<String>()),
+        }
+    }
+}
