+/// Owner-direct reads and what the owner may not do directly.
+#[test]
+fn probe_owner_direct_and_viewer_rules() {
+    let (mut daemon, principal, owner, agent, goal) = setup();
+    daemon.ok(agent, note(goal, "hello"));
+    // Owner direct: reads allowed, writes Invalid.
+    assert!(daemon.call(owner, Request::Notes { goal, about: None }).is_ok());
+    assert_eq!(code(daemon.call(owner, note(goal, "x"))), ErrorCode::Invalid);
+    assert_eq!(
+        code(daemon.call(
+            owner,
+            Request::WorkspaceSet {
+                goal,
+                binding: Default::default()
+            }
+        )),
+        ErrorCode::Invalid
+    );
+    // on_behalf on owner-only.
+    assert_eq!(
+        code(daemon.on_behalf(
+            owner,
+            principal,
+            Request::GoalGrant {
+                goal,
+                agent: principal,
+                grants: Default::default()
+            }
+        )),
+        ErrorCode::Invalid
+    );
+    // Viewer.
+    daemon.ok(
+        owner,
+        Request::ViewerEnroll {
+            agent: principal,
+            credential: credential(9).digest(),
+        },
+    );
+    let viewer = daemon.connect(credential(9), None);
+    for request in [
+        Request::WorkspaceSet {
+            goal,
+            binding: Default::default(),
+        },
+        Request::SessionDrop {
+            instance: session(1).instance(),
+        },
+        note(goal, "x"),
+        Request::Shutdown,
+        Request::GoalCreate { title: "t".into() },
+    ] {
+        assert_eq!(code(daemon.call(viewer, request)), ErrorCode::Denied);
+    }
+    let mut frame = daemon.frame(Request::Board { goal });
+    frame.on_behalf = Some(principal);
+    assert_eq!(code(daemon.send(viewer, frame)), ErrorCode::Denied);
+    // Viewer digest collisions.
+    assert_eq!(
+        code(daemon.call(
+            owner,
+            Request::ViewerEnroll {
+                agent: principal,
+                credential: OWNER.digest()
+            }
+        )),
+        ErrorCode::Conflict
+    );
+    assert_eq!(
+        code(daemon.call(
+            owner,
+            Request::AgentEnroll {
+                name: "x".into(),
+                grants: Default::default(),
+                credential: credential(9).digest()
+            }
+        )),
+        ErrorCode::Conflict
+    );
+    // A viewer's wait.
+    let frame = daemon.frame(Request::Wait {
+        goal,
+        seen: 0,
+        timeout_ms: 10,
+    });
+    assert!(matches!(daemon.step(viewer, frame, 1), Step::Reply(_)));
+    // Revoking the principal revokes the viewer, also at hello and after restart.
+    daemon.ok(owner, Request::AgentRevoke { agent: principal });
+    assert!(caller_of(&daemon.hello(credential(9), None).1).is_none());
+    daemon.restart();
+    assert!(caller_of(&daemon.hello(credential(9), None).1).is_none());
+    assert!(caller_of(&daemon.hello(credential(1), None).1).is_none());
+    let owner = daemon.owner();
+    assert_eq!(
+        code(daemon.call(
+            owner,
+            Request::ViewerEnroll {
+                agent: principal,
+                credential: credential(10).digest()
+            }
+        )),
+        ErrorCode::NotFound
+    );
+}
