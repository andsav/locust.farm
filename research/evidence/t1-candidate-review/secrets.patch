+#[test]
+fn probe_forged_ticket_makes_daemon_push_goal_history_to_attacker_endpoint() {
+    let (mut daemon, p1, _c1, c2, goal) = setup();
+    let attacker = EndpointId([0xEE; 32]);
+    let ticket = forged_ticket(goal, p1, attacker);
+    daemon.ok(
+        c2,
+        Request::GoalJoin {
+            ticket: locust_proto::invite::Ticket(ticket),
+        },
+    );
+    let mut out = Vec::new();
+    daemon.node.peer(PeerInput::Poll, 10, &mut out);
+    println!("after poll: {out:?}");
+    let exchange = out
+        .iter()
+        .find_map(|output| match output {
+            PeerOutput::Open {
+                exchange, endpoint, ..
+            } if *endpoint == attacker => Some(*exchange),
+            _ => None,
+        })
+        .expect("the daemon dials the endpoint the forged ticket names");
+    let mut sent: Vec<SyncMessage> = Vec::new();
+    let drive = |daemon: &mut Daemon, input: PeerInput, sent: &mut Vec<SyncMessage>| {
+        let mut queue = vec![input];
+        while let Some(input) = queue.pop() {
+            let mut out = Vec::new();
+            daemon.node.peer(input, 20, &mut out);
+            for output in out {
+                if let PeerOutput::Send { exchange: e, frame } = output {
+                    if e == exchange {
+                        sent.push(frame);
+                        queue.push(PeerInput::Writable(exchange));
+                    }
+                }
+            }
+        }
+    };
+    drive(&mut daemon, PeerInput::Opened(exchange), &mut sent);
+    // The attacker answers the Join with an empty frontier, then answers the
+    // victim's frontier with an empty frontier too.
+    let empty = Frontier { authors: vec![] };
+    drive(
+        &mut daemon,
+        PeerInput::Frame {
+            exchange,
+            frame: SyncMessage::Frontier(empty.clone()),
+        },
+        &mut sent,
+    );
+    drive(
+        &mut daemon,
+        PeerInput::Frame {
+            exchange,
+            frame: SyncMessage::Frontier(empty),
+        },
+        &mut sent,
+    );
+    let mut events = 0;
+    for frame in &sent {
+        match frame {
+            SyncMessage::Events(batch) => {
+                events += batch.len();
+                println!("attacker received Events batch of {}", batch.len());
+            }
+            other => println!("attacker received {}", short(other)),
+        }
+    }
+    let _ = ExchangeId::Accepted(0);
+    assert!(events > 0, "no events reached the attacker");
+    // The exchange finishes; a later note is pushed on the next join retry.
+    let mut out = Vec::new();
+    daemon.node.peer(PeerInput::Finished(exchange), 30, &mut out);
+    let c1 = daemon.connect(credential(1), None);
+    daemon.ok(c1, Request::NoteAdd { goal, about: None, supersedes: None, text: "later note".into() });
+    let mut reopened = None;
+    for now in [40u64, 1_100, 31_000, 62_000] {
+        let mut out = Vec::new();
+        daemon.node.peer(PeerInput::Poll, now, &mut out);
+        if let Some(e) = out.iter().find_map(|o| match o { PeerOutput::Open { exchange, endpoint, .. } if *endpoint == attacker => Some(*exchange), _ => None }) {
+            println!("re-dialed attacker at {now} ms");
+            reopened = Some(e);
+            break;
+        }
+    }
+    let exchange2 = reopened.expect("join re-presented to the attacker");
+    let mut sent2 = Vec::new();
+    let mut q = vec![PeerInput::Opened(exchange2)];
+    let empty = Frontier { authors: vec![] };
+    let mut answers = vec![PeerInput::Frame { exchange: exchange2, frame: SyncMessage::Frontier(empty.clone()) }, PeerInput::Frame { exchange: exchange2, frame: SyncMessage::Frontier(empty) }];
+    answers.reverse();
+    loop {
+        while let Some(input) = q.pop() {
+            let mut out = Vec::new();
+            daemon.node.peer(input, 62_100, &mut out);
+            for o in out { if let PeerOutput::Send { exchange: e, frame } = o { if e == exchange2 { sent2.push(frame); q.push(PeerInput::Writable(exchange2)); } } }
+        }
+        match answers.pop() { Some(a) => q.push(a), None => break }
+    }
+    let n: usize = sent2.iter().map(|f| if let SyncMessage::Events(b) = f { b.len() } else { 0 }).sum();
+    println!("second exchange pushed {n} events");
+    assert!(n >= 4);
+}
+
+fn short(frame: &SyncMessage) -> String {
+    let text = format!("{frame:?}");
+    text.chars().take(160).collect()
+}
